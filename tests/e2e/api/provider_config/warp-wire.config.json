{
  "$schema": "https://www.getbifrost.ai/schema",
  "setup_token": "bifrost-e2e-setup-token",
  "client": {
    "enforce_auth_on_inference": false,
    "enable_logging": true
  },
  "framework": {
    "pricing": {
      "pricing_url": "http://127.0.0.1:8792/pricing.json",
      "model_parameters_url": "http://127.0.0.1:8792/model-parameters.json",
      "mcp_library_sync_interval": 0
    }
  },
  "vector_store": {
    "enabled": true,
    "type": "weaviate",
    "config": { "scheme": "http", "host": "127.0.0.1:8080" }
  },
  "feature_flags": { "flags": { "warp": { "enabled": true } } },
  "providers": {
    "openai": {
      "keys": [
        { "name": "wire-allowlisted", "value": "test-key", "models": ["wire-chat", "wire-embed"], "weight": 1 }
      ],
      "network_config": { "base_url": "http://127.0.0.1:8792", "max_retries": 0, "default_request_timeout_in_seconds": 30 }
    },
    "wire-open": {
      "keys": [{ "name": "wire-open-key", "value": "test-key", "models": ["*"], "weight": 1 }],
      "network_config": { "base_url": "http://127.0.0.1:8792", "max_retries": 0, "default_request_timeout_in_seconds": 30 },
      "custom_provider_config": { "base_provider_type": "openai" }
    },
    "wire-chatonly": {
      "keys": [{ "name": "wire-chatonly-key", "value": "test-key", "models": ["*"], "weight": 1 }],
      "network_config": { "base_url": "http://127.0.0.1:8792", "max_retries": 0, "default_request_timeout_in_seconds": 30 },
      "custom_provider_config": { "base_provider_type": "openai", "allowed_requests": { "chat_completion": true, "responses": true } }
    },
    "egress_probe": {
      "keys": [
        {
          "name": "local-error-fixture",
          "value": "test-key",
          "models": [
            "*"
          ],
          "weight": 1
        }
      ],
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "network_config": {
        "base_url": "https://203.0.113.10",
        "max_retries": 0,
        "default_request_timeout_in_seconds": 10
      }
    }
  }
}
