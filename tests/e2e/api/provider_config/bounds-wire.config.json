    },
    "fireworks": {
      "keys": [
        {
          "name": "local-bounds-fixture",
          "value": "test-key",
          "models": ["*"],
          "blacklisted_models": ["accounts/fixture/models/blocked"],
          "weight": 1
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:8791/pp/bounds",
