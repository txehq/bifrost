{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "enforce_auth_on_inference": false,
    "max_request_body_size_mb": 1
  },
  "framework": {
    "pricing": {
      "pricing_url": "http://127.0.0.1:8791/pricing.json",
      "model_parameters_url": "http://127.0.0.1:8791/model-parameters.json",
      "mcp_library_sync_interval": 0
    }
  },
  "providers": {
    "openai": {
      "keys": [
        {
          "name": "local-bounds-fixture",
          "value": "test-key",
