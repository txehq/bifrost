{
  "name": "190. xai realtime client secret",
  "description": "Native xAI client-secret minting through Bifrost. Previously rejected as unsupported provider. Asserts actual upstream mint succeeds and the gateway replaces the credential with an identity-bound mapped token. Does not validate WebSocket capture or voice execution. Deliberately excludes credentials from assertion messages.",
  "item": [
    {
      "name": "xai grok-voice-latest realtime client secret",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"xai/grok-voice-latest\",\n  \"expires_after\": {\n    \"seconds\": 60\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/realtime/client_secrets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "realtime",
            "client_secrets"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('xai realtime mint returns a mapped credential and actual expiry', function () {",
              "  pm.expect(pm.response.code, 'mint status (credentials redacted)').to.equal(200);",
              "  var body = pm.response.json();",
              "  pm.expect(typeof body.value).to.equal('string');",
              "  pm.expect(body.value.indexOf('ek_bf_') === 0, 'expected a Bifrost-mapped credential').to.equal(true);",
              "  pm.expect(body.expires_at).to.be.a('number');",
              "  pm.expect(body.expires_at).to.be.above(Math.floor(Date.now() / 1000));",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
