        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var calls = pm.response.json().data[0].calls.filter(function (c) { return c.path === '/pp/byteplus/api/v3/contents/generations/tasks'; });",
              "pm.test('one create reached Ark with ratio, resolution, the last frame, the callback and the deadline', function () {",
              "  pm.expect(calls.length, JSON.stringify(calls)).to.eql(1);",
              "  var b = JSON.parse(calls[0].body);",
              "  pm.expect(b.duration, calls[0].body).to.eql(5);",
              "  pm.expect(b.ratio, calls[0].body).to.eql('9:16');",
              "  pm.expect(b.resolution, calls[0].body).to.eql('1080p');",
              "  pm.expect(b.callback_url, calls[0].body).to.eql('https://hooks.example.test/v/task_1');",
              "  pm.expect(b.execution_expires_after, calls[0].body).to.eql(7200);",
              "  var last = b.content.filter(function (c) { return c.role === 'last_frame'; });",
              "  pm.expect(last.length, calls[0].body).to.eql(1);",
              "  pm.expect(last[0].image_url.url, calls[0].body).to.eql('https://example.test/last.png');",
              "  ['aspect_ratio', 'last_frame', 'expires_after_seconds', 'seconds'].forEach(function (k) {",
              "    pm.expect(b, 'unified name on the wire: ' + calls[0].body).to.not.have.property(k);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
