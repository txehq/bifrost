              "pm.collectionVariables.unset('ovrOwnVkOwner'); pm.collectionVariables.unset('ovrOwnVkOwnerId'); pm.collectionVariables.unset('ovrOwnFileId');"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/governance/virtual-keys/{{ovrOwnVkOwnerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "governance",
            "virtual-keys",
            "{{ovrOwnVkOwnerId}}"
          ]
        }
      }
    },
    {
      "name": "591.8 [cleanup] virtual key B is deleted",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "  return;",
              "}",
              "if (!pm.collectionVariables.get('ovrOwnVkOtherId')) { pm.execution.skipRequest(); return; }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the virtual key was deleted', function () { pm.expect(pm.response.code, pm.response.text()).to.equal(200); });",
              "pm.collectionVariables.unset('ovrOwnVkOther'); pm.collectionVariables.unset('ovrOwnVkOtherId');"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/governance/virtual-keys/{{ovrOwnVkOtherId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "governance",
            "virtual-keys",
            "{{ovrOwnVkOtherId}}"
          ]
        }
      }
    }
  ]
}
