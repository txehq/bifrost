    {
      "name": "openai extra-fields-in-headers body mode keeps extra_fields - openai/gpt-4o-mini",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('chat completion succeeds', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "});",
              "pm.test('the restored placement decides where extra_fields goes', function () {",
              "  var restored = pm.collectionVariables.get('efhOriginal') || 'body';",
              "  var ef = pm.response.json().extra_fields;",
              "  if (restored === 'body') {",
              "    pm.expect(ef, pm.response.text()).to.be.an('object');",
              "    pm.expect((ef.routing_info || {}).provider, pm.response.text()).to.eql('openai');",
              "    pm.expect(pm.response.headers.get('x-bifrost-latency-ms'), 'body mode adds no new headers').to.be.oneOf([undefined, null]);",
              "  } else {",
              "    pm.expect(ef, pm.response.text()).to.be.oneOf([undefined, null]);",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
