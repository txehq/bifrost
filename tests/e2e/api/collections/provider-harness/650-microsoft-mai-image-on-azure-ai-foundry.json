          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('size became width and height', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var sent = JSON.parse(pm.response.json().data[0].body);",
              "  pm.expect(sent).to.eql({ model: 'MAI-Image-2.5', prompt: 'a lighthouse at dusk', width: 1024, height: 768 });",
              "});"
            ]
          }
        }
      ]
