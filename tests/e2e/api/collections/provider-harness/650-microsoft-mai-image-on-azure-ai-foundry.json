{
  "name": "650. Microsoft MAI-Image on Azure AI Foundry: size to width and height, data[].b64_json, output_images, undeliverable fields refused, named key (azure mai-image)",
  "description": "Pins contract C3, C4, C5 and C9 for MAI-Image on Azure AI Foundry (TXE-6543). Local fixture regression, no live provider calls: start tests/e2e/api/runners/provider-error-fixture.mjs, start an isolated gateway on tests/e2e/api/provider_config/provider-error-fixture.config.json and run with providerErrorFixture=1; every case is skipped otherwise. The azure-mai key's endpoint is the fixture's /mai-a resource, so a request goes to /mai-a/mai/v1/images/generations. Rows 4 to 8 are refused before any upstream call; the last row proves rows 2 and 9 each made exactly one call, with the named key.",
  "item": [
    {
      "name": "650.1 reset the fixture's hit counters (azure mai-image)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{providerErrorFixtureUrl}}/__reset"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('reset', function () { pm.expect(pm.response.code).to.eql(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "650.2 POST /v1/images/generations size 1024x768 returns data[0].b64_json and usage.output_images 1 (azure mai-image)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-api-key",
            "value": "azure-mai"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\": \"azure/MAI-Image-2.5\", \"prompt\": \"a lighthouse at dusk\", \"size\": \"1024x768\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/images/generations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "images",
            "generations"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('one PNG in data[] and output_images 1', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.data, pm.response.text()).to.have.lengthOf(1);",
              "  pm.expect(j.data[0].b64_json, pm.response.text()).to.match(/^iVBORw0KGgo/);",
              "  pm.expect(j.usage.output_images, pm.response.text()).to.equal(1);",
              "});"
            ]
          }
        }
      ]
    },
