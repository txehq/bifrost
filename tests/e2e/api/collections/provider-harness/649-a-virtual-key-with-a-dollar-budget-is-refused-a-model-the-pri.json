{
  "name": "649. A virtual key with a dollar budget is refused a model the price book cannot price, before the call (unpriced-budget) [SERIAL]",
  "description": "TXE-7957 security and billing regression. Local fixture regression: run with providerErrorFixture=1 against the gateway of tests/e2e/api/provider_config/provider-error-fixture.config.json, with tests/e2e/api/runners/provider-error-fixture.mjs as the only upstream and its price book. A dollar budget is charged what the price book says an answer cost, so an answer it cannot price was charged $0 and a key could repeat paid calls without spending its budget. A request under a dollar budget on a model with no price is now refused 403 (error_type policy_model_blocked, type model_unpriced) before the upstream call; a key with no budget, and a priced model under the budget, are served. [SERIAL]: the rows read the fixture's hit counter for upstream-ok.",
  "item": [
    {
      "name": "649.1 [EXPECT-403] a chat on a model with no price, under a dollar budget, is refused before the call (unpriced-budget)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-vk",
            "value": "{{upbBudgetVk}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\": \"openai/upstream-ok\", \"messages\": [{\"role\": \"user\", \"content\": \"an unpriced question\"}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "// Two run-scoped keys over the fixture's openai: one funded by a $100 dollar budget, one with none.",
              "// upstream-ok has no row in the fixture's price book, so an answer from it would charge the budget $0.",
              "var BASE = pm.variables.get('baseUrl');",
              "var run = 'harness-unpriced-budget-' + Date.now() + '-' + Math.floor(Math.random() * 1e9);",
              "pm.collectionVariables.set('upbBudgetVk', 'missing');",
              "pm.collectionVariables.set('upbOpenVk', 'missing');",
              "function key(name, extra, done) {",
              "  var body = Object.assign({ name: name, provider_configs: [{ provider: 'openai', allowed_models: ['*'], key_ids: ['*'], weight: 1 }] }, extra);",
              "  pm.sendRequest({ url: BASE + '/api/governance/virtual-keys', method: 'POST', header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify(body) } }, function (err, res) {",
              "    pm.test('unpriced-budget setup: created ' + name.slice(-6), function () {",
              "      pm.expect(err, String(err)).to.equal(null);",
              "      pm.expect(res.code, res.text()).to.eql(200);",
              "    });",
              "    done(res.json().virtual_key);",
              "  });",
              "}",
              "function value(vk) { return (vk.value && typeof vk.value === 'object') ? vk.value.value : vk.value; }",
              "key(run + '-budget', { budgets: [{ max_limit: 100, reset_duration: '1h' }] }, function (funded) {",
              "  pm.collectionVariables.set('upbBudgetVk', value(funded));",
              "  pm.collectionVariables.set('upbBudgetId', funded.id);",
              "  key(run + '-open', {}, function (open) {",
              "    pm.collectionVariables.set('upbOpenVk', value(open));",
              "    pm.collectionVariables.set('upbOpenId', open.id);",
              "    pm.sendRequest({ url: pm.variables.get('providerErrorFixtureUrl') + '/__hits', method: 'GET' }, function (err, res) {",
              "      var hits = (!err && res.code === 200) ? (res.json().data[0].hits || {}) : {};",
              "      pm.collectionVariables.set('upbHitsBefore', String(hits['upstream-ok'] || 0));",
              "    });",
              "  });",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var BASE = pm.variables.get('baseUrl');",
              "function refused(code, text, j, what) {",
              "  pm.test('unpriced-budget: ' + what + ' is refused 403 policy_model_blocked (model_unpriced)', function () {",
              "    pm.expect(code, text).to.equal(403);",
              "    pm.expect(j.extra_fields && j.extra_fields.error_type, text).to.equal('policy_model_blocked');",
              "    pm.expect(j.type, text).to.equal('model_unpriced');",
              "    pm.expect(text, text).to.include('pricing override');",
              "  });",
              "}",
              "refused(pm.response.code, pm.response.text(), pm.response.json(), 'a chat on a model with no price, under a dollar budget,');",
              "// Repeating it changes nothing: every request is refused, none is served at $0.",
              "pm.sendRequest({ url: BASE + '/v1/chat/completions', method: 'POST', header: { 'Content-Type': 'application/json', 'x-bf-vk': pm.collectionVariables.get('upbBudgetVk') }, body: { mode: 'raw', raw: \"{\\\"model\\\": \\\"openai/upstream-ok\\\", \\\"messages\\\": [{\\\"role\\\": \\\"user\\\", \\\"content\\\": \\\"an unpriced question\\\"}]}\" } }, function (err, res) {",
              "  pm.test('unpriced-budget: the repeat was answered', function () { pm.expect(err, String(err)).to.equal(null); });",
              "  refused(res.code, res.text(), res.json(), 'the same chat repeated');",
              "  pm.sendRequest({ url: pm.variables.get('providerErrorFixtureUrl') + '/__hits', method: 'GET' }, function (err2, res2) {",
              "    var hits = (!err2 && res2.code === 200) ? (res2.json().data[0].hits || {}) : {};",
              "    pm.test('unpriced-budget: neither refusal reached the upstream', function () {",
              "      pm.expect(err2, String(err2)).to.equal(null);",
              "      pm.expect(hits['upstream-ok'] || 0, JSON.stringify(hits)).to.equal(Number(pm.collectionVariables.get('upbHitsBefore')));",
              "    });",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "649.2 [EXPECT-200] the same model on a key with no dollar budget is served (unpriced-budget)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-vk",
            "value": "{{upbOpenVk}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\": \"openai/upstream-ok\", \"messages\": [{\"role\": \"user\", \"content\": \"an unpriced question\"}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "pm.test('unpriced-budget: the same model on a key with no dollar budget is served', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "});",
              "pm.sendRequest({ url: pm.variables.get('providerErrorFixtureUrl') + '/__hits', method: 'GET' }, function (err, res) {",
              "  var hits = (!err && res.code === 200) ? (res.json().data[0].hits || {}) : {};",
              "  pm.test('unpriced-budget: the served call reached the upstream once', function () {",
              "    pm.expect(hits['upstream-ok'] || 0, JSON.stringify(hits)).to.equal(Number(pm.collectionVariables.get('upbHitsBefore')) + 1);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "649.3 [EXPECT-200] a priced model is served under the dollar budget (unpriced-budget)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-vk",
            "value": "{{upbBudgetVk}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\": \"openai/gpt-6-luna\", \"input\": \"a priced question\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/responses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "responses"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var BASE = pm.variables.get('baseUrl');",
              "pm.test('unpriced-budget: a priced model is served under the dollar budget', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "});",
              "['upbBudgetId', 'upbOpenId'].forEach(function (name) {",
              "  var id = pm.collectionVariables.get(name);",
              "  if (id) { pm.sendRequest({ url: BASE + '/api/governance/virtual-keys/' + id, method: 'DELETE' }, function () {}); }",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
