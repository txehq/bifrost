            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var raw = pm.response.text() || '';",
              "pm.expect(pm.response.code, 'unexpected status: ' + raw).to.equal(200);",
              "var frames = raw.split('\\n').filter(function (l) { return l.indexOf('data: {') === 0; }).map(function (l) { return JSON.parse(l.slice(6)); });",
              "var last = frames.filter(function (f) { return f.usage; }).pop();",
              "pm.test('a frame carries the usage', function () { pm.expect(last, raw).to.be.an('object'); });",
              "var usage = last && last.usage;",
              "pm.test('vendor_cost is xAI\\'s reported charge in usd_ticks', function () {",
              "  pm.expect(usage && usage.vendor_cost, 'usage: ' + JSON.stringify(usage)).to.eql({ amount: 123000000, unit: 'usd_ticks' });",
              "});",
              "pm.test('cost_in_usd_ticks keeps its meaning (contract C2)', function () {",
              "  pm.expect(usage && usage.cost_in_usd_ticks, 'usage: ' + JSON.stringify(usage)).to.equal(123000000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"xai/upstream-usage-extended\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"hi\"\n    }\n  ],\n  \"stream\": true\n}"
        },
        "url": {
