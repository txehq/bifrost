    {
      "name": "148.7 openai passthrough ignores client credentials and still authenticates (passthrough auth strip)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer sk-bogus-h146"
          },
          {
            "key": "x-api-key",
            "value": "bogus-h146"
          },
          {
            "key": "Cookie",
            "value": "session=bogus-h146"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Reply OK.\"\n    }\n  ],\n  \"max_tokens\": 8\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/openai_passthrough/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "openai_passthrough",
            "v1",
            "chat",
            "completions"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "pm.test('request authenticated with the gateway key, not the bogus client credentials', function () { pm.expect(j.choices[0].message.content || '', pm.response.text()).to.not.equal(''); });",
              "pm.test('no credential material is echoed back', function () { pm.expect(pm.response.text().indexOf('bogus-h146'), 'bogus credential leaked in response').to.equal(-1); });"
            ]
          }
        }
      ]
    },
