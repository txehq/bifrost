          "raw": "{\n  \"base_url\": \"{{baseUrl}}\",\n  \"path\": \"/openai/v1/videos/video_gapped_2:fixture_video_keys/content\",\n  \"headers\": {{videoProbeHeaders}}\n}"
        },
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__probe/download",
          "host": [
            "{{providerErrorFixtureUrl}}"
          ],
          "path": [
            "__probe",
            "download"
          ]
        }
      }
    },
    {
      "name": "405.6 each openai video list and content call reached the fixture once, with the named key and the filters unchanged (video content stream, video list filters)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var h = pm.response.json().data[0].hits;",
              "var seen = {};",
              "Object.keys(h).forEach(function (k) { if (k.indexOf('video.list@') === 0 || k.indexOf('video.content@') === 0) { seen[k] = h[k]; } });",
              "pm.test('one vendor call per request, each with the key the caller named and the list filters as sent', function () {",
              "  pm.expect(seen, JSON.stringify(h)).to.eql({",
              "    'video.list@fixture-video-b?created_after=1762700000&limit=2&status=completed&status=failed': 1,",
              "    'video.list@fixture-video-b?after=video_b&created_after=1762700000&limit=2&status=completed&status=failed': 1,",
              "    'video.content@fixture-video-a': 1,",
              "    'video.content@fixture-video-b': 1",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__hits",
          "host": [
            "{{providerErrorFixtureUrl}}"
          ],
          "path": [
            "__hits"
          ]
        }
      }
    }
  ]
}
