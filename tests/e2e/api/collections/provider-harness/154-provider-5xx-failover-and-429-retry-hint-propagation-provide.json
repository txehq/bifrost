{
  "name": "154. Provider 5xx failover and 429 retry-hint propagation (provider error fixture)",
  "description": "Local fixture regression, no live provider calls. Start tests/e2e/api/runners/provider-error-fixture.mjs, start an isolated gateway on tests/e2e/api/provider_config/provider-error-fixture.config.json (openai base_url -> the fixture, max_retries 0), and run with providerErrorFixture=1; every case is skipped otherwise. The fixture answers by model name: upstream-503 returns HTTP 503, upstream-429 returns 429 with Retry-After: 7, upstream-429-ms returns 429 with retry-after-ms: 2500, upstream-ok returns a chat completion. Bifrost does not emit a Retry-After HTTP header: the provider hint is carried in the error body as extra_fields.retry_after_ms (clamped to 1s..5m), and that is what 154.3/154.4 pin. 154.1 and 154.7 talk to the fixture directly to reset and read per-model hit counts, which proves a failover tried the primary once and the fallback once.",
  "item": [
    {
      "name": "154.1 fixture hit counters reset",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "pm.test('counters cleared', function () { pm.expect(j.data[0].reset, pm.response.text()).to.equal(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{providerErrorFixtureUrl}}/__reset"
      }
    },
    {
      "name": "154.2 [EXPECT-503] openai upstream 503 propagates as a 503 error without fallbacks (provider 5xx)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"openai/upstream-503\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"hi\"\n    }\n  ],\n  \"max_tokens\": 8\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "pm.test('upstream 503 reaches the client as a Bifrost error envelope', function () {",
              "  pm.expect(j.error, pm.response.text()).to.be.an('object');",
              "  pm.expect(j.error.message, pm.response.text()).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "154.3 [EXPECT-429] openai upstream 429 with Retry-After 7 propagates with retry_after_ms 7000 (rate limit propagation)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
