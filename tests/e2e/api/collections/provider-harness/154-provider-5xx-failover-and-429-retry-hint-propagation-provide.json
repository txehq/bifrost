    {
      "name": "154.7 fixture hit counts prove one attempt per model per request (failover 5xx)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var h = pm.response.json().data[0].hits;",
              "pm.test('each primary was tried exactly once per request and the fallback once per failover', function () {",
              "  pm.expect(h['upstream-503'], JSON.stringify(h)).to.equal(2);",
              "  pm.expect(h['upstream-429'], JSON.stringify(h)).to.equal(2);",
              "  pm.expect(h['upstream-429-ms'], JSON.stringify(h)).to.equal(1);",
              "  pm.expect(h['upstream-ok'], JSON.stringify(h)).to.equal(2);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{providerErrorFixtureUrl}}/__hits"
      }
    },
    {
      "name": "154.8 [EXPECT-404] fixture treats Object.prototype names as unknown models instead of crashing (fixture robustness)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "pm.test('constructor is an unknown model, not an inherited function', function () { pm.expect(j.error && j.error.code, pm.response.text()).to.equal('model_not_found'); });",
              "pm.sendRequest({ url: pm.variables.get('providerErrorFixtureUrl') + '/v1/chat/completions', method: 'POST', header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify({ model: 'toString' }) } }, function (err, res) {",
              "  pm.test('a second prototype name (toString) also gets a 404 envelope', function () { pm.expect(err, String(err)).to.equal(null); pm.expect(res.code).to.equal(404); pm.expect(res.json().error.code).to.equal('model_not_found'); });",
              "  pm.sendRequest({ url: pm.variables.get('providerErrorFixtureUrl') + '/__hits', method: 'GET' }, function (err2, res2) {",
              "    pm.test('the fixture is still serving afterwards', function () { pm.expect(err2, String(err2)).to.equal(null); pm.expect(res2.code).to.equal(200); });",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"constructor\"\n}"
        },
        "url": "{{providerErrorFixtureUrl}}/v1/chat/completions"
      }
    }
  ]
