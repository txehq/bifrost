        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "pm.test('upstream 429 reaches the client as a Bifrost error envelope', function () {",
              "  pm.expect(j.error, pm.response.text()).to.be.an('object');",
              "  pm.expect(j.error.message, pm.response.text()).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('Retry-After: 7 surfaces as extra_fields.retry_after_ms = 7000', function () {",
              "  pm.expect(j.extra_fields && j.extra_fields.retry_after_ms, 'retry hint lost: ' + pm.response.text()).to.equal(7000);",
              "});"
            ]
          }
        }
      ]
    },
