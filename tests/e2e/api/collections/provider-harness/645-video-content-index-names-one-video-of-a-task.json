          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos",
            "video_gapped_1:fixture_video_keys",
            "content"
          ],
          "query": [
            {
              "key": "index",
              "value": "1"
            }
          ]
        }
