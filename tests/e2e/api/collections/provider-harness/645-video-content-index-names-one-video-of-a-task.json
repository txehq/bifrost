    },
    {
      "name": "645.5 only the index=1 row reached the fixture, once, with the named key (video content index)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var h = pm.response.json().data[0].hits;",
              "var seen = {};",
              "Object.keys(h).forEach(function (k) { if (k.indexOf('video.') === 0) { seen[k] = h[k]; } });",
              "pm.test('a malformed index never reaches the vendor', function () {",
              "  pm.expect(seen, JSON.stringify(h)).to.eql({ 'video.content@fixture-video-a': 1 });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__hits",
          "host": [
            "{{providerErrorFixtureUrl}}"
          ],
          "path": [
            "__hits"
          ]
        }
      }
    }
  ]
