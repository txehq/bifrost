    {
      "name": "645.4 /v1/videos/{id}/content on fixture_video_keys with index=1 of a one-file video is a 400 naming index, not the first file [EXPECT-400] (video content index)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 naming index, as a caller_invalid_request', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(400);",
              "  var j = pm.response.json();",
              "  pm.expect(j.error && j.error.param, pm.response.text()).to.equal('index');",
              "});",
              "pm.test('no file is served in place of the one asked for', function () {",
