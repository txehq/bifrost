          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the task object carries provider_status, the link, expires_at, output_seconds and vendor_cost', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.id, 'id: ' + pm.response.text()).to.eql('893605946402811985:kling');",
              "  pm.expect(j.status, 'status: ' + pm.response.text()).to.eql('completed');",
              "  pm.expect(j.provider_status, 'provider_status: ' + pm.response.text()).to.eql('succeeded');",
              "  pm.expect(j.videos, 'videos: ' + pm.response.text()).to.be.an('array').with.length(1);",
              "  pm.expect(j.videos[0].type, 'videos[0].type').to.eql('url');",
              "  pm.expect(j.videos[0].url, 'videos[0].url').to.eql('https://kling-fixture.example.test/out.mp4');",
              "  pm.expect(j.completed_at, 'completed_at: ' + pm.response.text()).to.eql(1781080794);",
              "  pm.expect(j.expires_at, 'expires_at is completion + 30 days: ' + pm.response.text()).to.eql(1781080794 + 30 * 24 * 3600);",
              "  pm.expect(j.seconds, 'seconds: ' + pm.response.text()).to.eql('5.1');",
              "  var u = j.usage || {};",
              "  pm.expect(u.output_seconds, 'usage.output_seconds: ' + pm.response.text()).to.eql(5.1);",
              "  pm.expect(u.vendor_cost, 'usage.vendor_cost: ' + pm.response.text()).to.eql({ amount: 3.5, unit: 'unit' });",
              "  pm.expect(j.content_filter, 'content_filter').to.equal(undefined);",
              "});"
            ]
          }
        }
