      "name": "416.21 [PREVIEW] kling GET /v1/videos/{id} - poll the live task until it completes with a link, its expiry, seconds and Kling's deduction (kling video contract)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('include_preview') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var id = pm.collectionVariables.get('klingVideoId');",
              "if (!id) { pm.test.skip('no Kling video id produced by the create row', function () {}); return; }",
              "pm.test('retrieve succeeds', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "});",
              "if (pm.response.code !== 200) { pm.collectionVariables.unset('klingVideoPolls'); return; }",
              "var j = pm.response.json();",
              "var polls = Number(pm.collectionVariables.get('klingVideoPolls') || 0);",
              "if ((j.status === 'queued' || j.status === 'in_progress') && polls < 90) {",
              "  // Poll every 10s for up to 15 minutes.",
              "  pm.collectionVariables.set('klingVideoPolls', polls + 1);",
              "  setTimeout(function () {}, 10000);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "pm.collectionVariables.unset('klingVideoPolls');",
              "pm.test('the task completed with a public link that expires 30 days after completion', function () {",
              "  pm.expect(j.status, 'final status: ' + pm.response.text()).to.eql('completed');",
              "  pm.expect(j.provider_status, 'provider_status').to.eql('succeeded');",
              "  pm.expect(j.id).to.eql(id);",
              "  pm.expect(j.videos, 'videos: ' + pm.response.text()).to.be.an('array').that.is.not.empty;",
              "  pm.expect(j.videos[0].type, 'videos[0].type').to.eql('url');",
              "  pm.expect(j.videos[0].url, 'videos[0].url').to.match(/^https:\\/\\//);",
              "  pm.expect(j.expires_at, 'expires_at: ' + pm.response.text()).to.eql(j.completed_at + 30 * 24 * 3600);",
              "});",
              "pm.test('usage carries the seconds Kling reported', function () {",
              "  pm.expect(j.usage && j.usage.output_seconds, 'usage.output_seconds: ' + pm.response.text()).to.be.above(0);",
              "});",
              "pm.test('a deduction from a resource package is reported in Units', function () {",
              "  var cost = j.usage && j.usage.vendor_cost;",
              "  if (!cost) { return; } // an account billed from its cash balance has no Units to report",
