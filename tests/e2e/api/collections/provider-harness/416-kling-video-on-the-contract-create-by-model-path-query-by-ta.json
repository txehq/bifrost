    {
      "name": "416.4 the two creates reached Kling once each, on the model's path, with the fields unchanged and Tokun's ids in options (kling video contract)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var calls = pm.response.json().data[0].calls;",
              "pm.test('each create is exactly one upstream call with the named key', function () {",
              "  pm.expect(calls, JSON.stringify(calls)).to.be.an('array').with.length(2);",
              "  pm.expect(calls[0].method + ' ' + calls[0].path).to.eql('POST /text-to-video/kling-3.0');",
              "  pm.expect(calls[1].method + ' ' + calls[1].path).to.eql('POST /image-to-video/kling-3.0');",
              "  pm.expect(calls[0].key).to.eql('kling-secret-b');",
              "  pm.expect(calls[1].key).to.eql('kling-secret-b');",
              "});",
              "pm.test('text-to-video: prompt at the top level, settings and options as sent', function () {",
              "  pm.expect(calls[0].body, JSON.stringify(calls[0].body)).to.eql({",
              "    prompt: 'a paper boat drifts across a still pond at dawn',",
              "    settings: { duration: 15, resolution: '4k', aspect_ratio: '9:16', audio: 'native', multi_shot: false },",
              "    options: { callback_url: 'https://hooks.example.test/v/tk_harness_task_1', external_task_id: 'tk_harness_task_1', watermark_info: { enabled: true } }",
              "  });",
              "});",
              "pm.test('image-to-video: the prompt and both frames are contents, a data URL goes as Base64', function () {",
              "  pm.expect(calls[1].body, JSON.stringify(calls[1].body)).to.eql({",
              "    contents: [",
              "      { type: 'prompt', text: 'the boat turns toward the reeds' },",
              "      { type: 'first_frame', url: 'https://example.test/first.png' },",
              "      { type: 'last_frame', url: 'iVBORw0KGgo=' }",
              "    ],",
              "    settings: { duration: 10, resolution: '1080p', audio: 'off' },",
              "    options: { external_task_id: 'tk_harness_task_2' }",
              "  });",
              "});"
            ]
          }
        }
      ],
