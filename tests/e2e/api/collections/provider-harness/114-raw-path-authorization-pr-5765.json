      "name": "[PREVIEW] [EXPECT-201] openai raw-path-auth register consent client - #5765",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('pathAuthClient');",
              "pm.collectionVariables.unset('pathAuthFlow');",
              "pm.collectionVariables.unset('pathAuthToken');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('raw-path-auth exact response status', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(201);",
              "});",
              "pm.test('consent client created', function () {",
              "  var body = pm.response.json();",
              "  pm.expect(body.client_id).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('pathAuthClient', body.client_id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
