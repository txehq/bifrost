              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var calls = pm.response.json().data[0].calls.filter(function (c) { return c.path.indexOf('/pp/replicate/') === 0; });",
              "pm.test('five creates, one per request, and no poll', function () {",
              "  pm.expect(calls.length, JSON.stringify(calls.map(function (c) { return c.path; }))).to.eql(5);",
              "  calls.forEach(function (c) { pm.expect(c.path, c.path).to.match(/\\/predictions$/); });",
              "});"
            ]
          }
        }
      ]
