    {
      "name": "/v1/images/generations - xai/grok-imagine-image-2.0 with quality low reports vendor_cost and output_images (xai image contract)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('a generation with quality returns images with vendor_cost in usd_ticks and output_images', function () {",
              "  var t = pm.response.text();",
              "  pm.expect(pm.response.code, 'failed: ' + t.slice(0, 400)).to.equal(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.data, 'data: ' + t.slice(0, 400)).to.be.an('array');",
              "  pm.expect(j.usage, 'usage: ' + t.slice(0, 400)).to.be.an('object');",
              "  pm.expect(j.usage.output_images, 'output_images counts the delivered images').to.equal(j.data.length);",
              "  pm.expect(j.usage.vendor_cost, 'vendor_cost: ' + JSON.stringify(j.usage)).to.be.an('object');",
              "  pm.expect(j.usage.vendor_cost.unit).to.equal('usd_ticks');",
              "  pm.expect(j.usage.vendor_cost.amount, 'vendor_cost.amount is xAI cost_in_usd_ticks').to.equal(j.usage.cost_in_usd_ticks);",
              "  if (j.data.length < 1) { pm.expect(j.content_filter, 'an empty data must carry content_filter: ' + t.slice(0, 400)).to.be.an('object'); }",
              "});"
            ]
          }
        }
      ],
