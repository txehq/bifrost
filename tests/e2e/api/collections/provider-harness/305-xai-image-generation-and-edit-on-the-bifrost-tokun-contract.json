      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var id = pm.collectionVariables.get('xaiAsyncImageGenJobId');",
              "pm.test('the submit case produced a job id', function () { pm.expect(id, 'no async job id: the submit case failed or was filtered out').to.be.a('string').that.is.not.empty; });",
              "if (!id) { return; }",
              "// GET /v1/async/... answers 202 while the job is pending or processing and 200 once it is completed or failed.",
              "pm.test('job lookup succeeds', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.be.oneOf([200, 202]);",
              "});",
              "if (pm.response.code !== 200 && pm.response.code !== 202) { pm.collectionVariables.unset('xaiAsyncImageGenJobIdPolls'); return; }",
              "var j = pm.response.json();",
              "var polls = Number(pm.collectionVariables.get('xaiAsyncImageGenJobIdPolls') || 0);",
              "if (j.status !== 'completed' && j.status !== 'failed' && polls < 40) {",
              "  // Poll the job until it is terminal, up to 40 lookups about 3 s apart (about 2 minutes).",
              "  // The pending timer holds the sandbox open, which delays the next request.",
              "  pm.collectionVariables.set('xaiAsyncImageGenJobIdPolls', polls + 1);",
              "  setTimeout(function () {}, 3000);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "pm.collectionVariables.unset('xaiAsyncImageGenJobIdPolls');",
              "pm.test('the job reaches a terminal state within the poll budget', function () {",
              "  pm.expect(j.status, 'still ' + j.status + ' after ' + polls + ' polls: ' + JSON.stringify(j).slice(0, 400)).to.be.oneOf(['completed', 'failed']);",
              "});",
              "pm.test('quality on grok-imagine-image fails the job with caller_unsupported_parameter, before any upstream call', function () {",
              "  pm.expect(j.status, 'job: ' + JSON.stringify(j).slice(0, 400)).to.equal('failed');",
              "  pm.expect(j.status_code).to.equal(400);",
              "  pm.expect(j.error && j.error.extra_fields && j.error.extra_fields.error_type, 'error: ' + JSON.stringify(j.error)).to.equal('caller_unsupported_parameter');",
              "  pm.expect(j.error.error && j.error.error.param).to.equal('quality');",
              "});"
            ]
          }
        }
      ],
