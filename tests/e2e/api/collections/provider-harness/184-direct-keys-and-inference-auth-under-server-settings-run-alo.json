        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Plan rows: DK-14.",
              "var text = pm.response.text();",
              "var json = {}; try { json = pm.response.json() || {}; } catch (e) { json = {}; }",
              "var ri = (json.extra_fields || {}).routing_info || {};",
              "pm.test('the runner supplies a working OpenAI key as openaiKey (OPENAI_API_KEY)', function () {",
              "  pm.expect(pm.variables.get('dkSettingsNoKey'), 'openaiKey is empty: this row needs a working key to send as the caller\\u2019s direct key').to.not.equal('1');",
              "});",
              "// A direct key counts as the credential inference auth asks for: the request is served on it.",
              "pm.test('inference auth on: a direct key without a virtual key is served, on the caller\\u2019s key', function () {",
              "  pm.expect(pm.response.code, text).to.eql(200);",
              "  pm.expect(String(ri.key || ''), text).to.include('header-provided');",
              "});"
            ]
          }
        }
