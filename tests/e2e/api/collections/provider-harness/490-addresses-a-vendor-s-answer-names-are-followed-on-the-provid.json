      "name": "490.8 replicate GET /v1/models: a deployments next page on the provider's own origin is followed, one on another loopback host is refused (vendor named address)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the key whose next page is on the provider\\'s origin lists both pages', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var ids = pm.response.json().data.map(function (m) { return m.id; });",
              "  pm.expect(ids, JSON.stringify(ids)).to.include('replicate/fixture/fixture-deploy-origin-page-1');",
              "  pm.expect(ids, JSON.stringify(ids)).to.include('replicate/fixture/fixture-deploy-origin-page-2');",
              "});",
              "pm.test('the key whose next page is on another loopback host lists nothing and reports the refusal', function () {",
              "  var j = pm.response.json();",
              "  var ids = j.data.map(function (m) { return m.id; });",
              "  pm.expect(ids.filter(function (id) { return id.indexOf('fixture-deploy-loopback') !== -1; }), JSON.stringify(ids)).to.eql([]);",
              "  var failed = (j.key_statuses || []).filter(function (k) { return k.status === 'list_models_failed'; });",
              "  pm.expect(failed.length, JSON.stringify(j.key_statuses)).to.equal(1);",
              "  pm.expect(JSON.stringify(failed[0].error), JSON.stringify(failed[0])).to.include('non-public address');",
              "});"
            ]
          }
        }
