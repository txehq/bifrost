      "name": "490.9 fixture counters for the vendor-named address rows: every origin and public address asked once, no loopback one asked (vendor named address)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var hits = pm.response.json().data[0].hits;",
              "var text = JSON.stringify(hits);",
              "var keys = Object.keys(hits);",
              "pm.test('polls, the stream, the image and the next page were asked for at the provider\\'s origin or the public address', function () {",
              "  pm.expect(hits['replicate.poll@127.0.0.1'], text).to.equal(3);",
              "  pm.expect(hits['replicate.stream@127.0.0.1'], text).to.equal(1);",
              "  pm.expect(hits['media.image@203.0.113.10'], text).to.equal(1);",
              "  pm.expect(hits['__media_tunnel_connects@203.0.113.10:80'] || 0, text).to.be.at.least(1);",
              "  pm.expect(hits['replicate.deployments@fixture-deploy-origin?page=2@127.0.0.1'], text).to.equal(1);",
              "});",
              "pm.test('no address on another loopback host, and no loopback image, was ever asked for', function () {",
              "  pm.expect(keys.filter(function (k) { return /@localhost$/.test(k) || k.indexOf('media.internal') === 0; }), text).to.eql([]);",
              "});"
            ]
          }
        }
      ],
