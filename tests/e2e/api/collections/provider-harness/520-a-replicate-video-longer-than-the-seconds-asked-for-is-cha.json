    {
      "name": "520.11 the sweeper never fetches a video on a host the caller chose: it charges the $0.50 floor for the 5 seconds asked for, marked incomplete (rendered video duration)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Bifrost-Setup-Token",
            "value": "{{setupToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/logs?providers=replicate&limit=1",
          "host": [
