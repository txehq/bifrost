              "var body = pm.response.json();",
              "pm.test('the client gets 200 with image bytes', function () {",
              "  pm.expect(pm.response.code, text).to.equal(200);",
              "  pm.expect(body.data, text).to.be.an('array').with.length(1);",
              "  pm.expect(body.data[0].b64_json, text).to.be.a('string').that.is.not.empty;",
              "});",
              "pm.test('expires_at is absent', function () { pm.expect(body, text).to.not.have.property('expires_at'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\":\"minimax/image-01\",\"prompt\":\"a lighthouse at dusk\",\"n\":1,\"response_format\":\"b64_json\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/images/generations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "images",
            "generations"
          ]
        }
      }
    },
