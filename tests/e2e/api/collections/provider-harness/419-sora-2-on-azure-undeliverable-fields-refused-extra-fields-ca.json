              "pm.test('the upstream counters are exact', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var hits = pm.response.json().data[0].hits;",
              "  var sora = {};",
              "  Object.keys(hits).filter(function (k) { return k.indexOf('sora ') === 0; }).forEach(function (k) { sora[k] = hits[k]; });",
              "  pm.expect(sora).to.eql({",
              "    'sora POST a azure-sora-secret-a': 6,",
              "    'sora GET b azure-sora-secret-b': 1,",
              "    'sora GET b azure-sora-secret-b content': 1,",
              "    'sora GET a azure-sora-secret-a': 1",
              "  });",
              "});"
            ]
          }
        }
      ]
    }
  ]
