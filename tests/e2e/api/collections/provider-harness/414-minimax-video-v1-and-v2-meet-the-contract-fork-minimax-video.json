      "name": "414.19 fixture call log proves the request bodies, one DELETE only for the queued task, and the named key on cancel (fork minimax video contract)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://127.0.0.1:8791/__mmv"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var calls = pm.response.json().data[0].calls;",
              "var lines = calls.map(function (c) { return c.method + ' ' + c.path + c.query; });",
              "pm.test('every MiniMax call, in order; refused requests made none', function () {",
              "  pm.expect(lines, JSON.stringify(calls)).to.eql([",
              "    'POST /mmv/v2/video_generation',",
              "    'GET /mmv/v2/query/video_generation/mm-done',",
              "    'POST /mmv/v1/video_generation',",
              "    'GET /mmv/v1/query/video_generation?task_id=106916112212032',",
              "    'GET /mmv/v1/files/retrieve?file_id=176844028768320',",
              "    'POST /mmv/v1/video_generation',",
              "    'GET /mmv/v2/query/video_generation/mm-queued',",
              "    'DELETE /mmv/v2/video_generation/mm-queued',",
              "    'GET /mmv/v2/query/video_generation/mm-running',",
              "    'GET /mmv/v2/query/video_generation/mm-done',",
              "    'GET /mmv/v2/query/video_generation?page_num=1&page_size=2'",
              "  ]);",
              "});",
              "pm.test('the v2 body carries MiniMax field names, no default ratio, and the merged extra', function () {",
              "  var b = JSON.parse(calls[0].body);",
              "  pm.expect(b, calls[0].body).to.include({ model: 'MiniMax-H3', duration: 6, resolution: '768P', ratio: '16:9', callback_url: 'https://hooks.example.test/v/task_414' });",
              "  pm.expect(b.extra, calls[0].body).to.eql({ prompt_expansion_mode: 'quality' });",
              "  pm.expect(b, calls[0].body).to.not.have.property('aspect_ratio');",
              "});",
              "pm.test('the v1 body carries the flat v1 fields', function () {",
              "  var b = JSON.parse(calls[2].body);",
              "  pm.expect(b, calls[2].body).to.include({ model: 'MiniMax-Hailuo-2.3', prompt: 'a paper boat on a pond', first_frame_image: 'https://example.com/first.png', duration: 10, resolution: '768P', callback_url: 'https://hooks.example.test/v/task_414_v1', prompt_optimizer: false });",
              "  pm.expect(b, calls[2].body).to.not.have.property('content');",
              "});",
              "pm.test('the cancel queried and deleted with the named key mmv-key-b', function () {",
              "  pm.expect(calls.slice(6, 10).map(function (c) { return c.bearer; }), JSON.stringify(calls)).to.eql(['mmv-secret-b', 'mmv-secret-b', 'mmv-secret-b', 'mmv-secret-b']);",
              "});"
            ]
          }
