    {
      "name": "562.2 [EXPECT-201] a VK-scoped override on every long-context tier rate is stored whole - openai/override-only",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var missing = ['longCtxRatesVkId'].filter(function (k) { return !pm.collectionVariables.get(k); });",
              "if (missing.length && typeof pm.execution !== 'undefined' && pm.execution.skipRequest) { pm.execution.skipRequest(); }",
              "pm.collectionVariables.unset('longCtxRatesOverrideId');",
              "pm.request.body.raw = JSON.stringify({",
              "  name: 'e2e-long-ctx-tiers-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8),",
              "  // Virtual-key scoped and never used for a request, so nothing in the suite is repriced.",
              "  scope_kind: 'virtual_key',",
              "  virtual_key_id: pm.collectionVariables.get('longCtxRatesVkId'),",
              "  match_type: 'exact',",
              "  pattern: 'MiniMax-M3',",
              "  request_types: ['chat_completion'],",
              "  patch: {\"input_cost_per_token_above_32k_tokens\": 1e-06, \"output_cost_per_token_above_32k_tokens\": 2e-06, \"cache_read_input_token_cost_above_32k_tokens\": 3e-06, \"cache_read_input_token_cost_above_128k_tokens\": 4e-06, \"input_cost_per_token_above_256k_tokens\": 5e-06, \"output_cost_per_token_above_256k_tokens\": 6e-06, \"cache_read_input_token_cost_above_256k_tokens\": 7e-06, \"input_cost_per_token_above_512k_tokens\": 8e-06, \"output_cost_per_token_above_512k_tokens\": 9e-06, \"cache_read_input_token_cost_above_512k_tokens\": 1e-05}",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Override on the long-context tier rates is accepted', function () {",
              "  pm.expect(pm.response.code, 'body: ' + pm.response.text()).to.eql(201);",
              "});",
              "var body = null;",
              "try { body = pm.response.json(); } catch (e) { body = null; }",
              "var ov = body && (body.pricing_override || body);",
              "if (ov && ov.id) { pm.collectionVariables.set('longCtxRatesOverrideId', ov.id); }",
              "var expected = {\"input_cost_per_token_above_32k_tokens\": 1e-06, \"output_cost_per_token_above_32k_tokens\": 2e-06, \"cache_read_input_token_cost_above_32k_tokens\": 3e-06, \"cache_read_input_token_cost_above_128k_tokens\": 4e-06, \"input_cost_per_token_above_256k_tokens\": 5e-06, \"output_cost_per_token_above_256k_tokens\": 6e-06, \"cache_read_input_token_cost_above_256k_tokens\": 7e-06, \"input_cost_per_token_above_512k_tokens\": 8e-06, \"output_cost_per_token_above_512k_tokens\": 9e-06, \"cache_read_input_token_cost_above_512k_tokens\": 1e-05};",
              "var stored = null;",
              "try { stored = ov && JSON.parse(ov.pricing_patch); } catch (e) { stored = null; }",
              "pm.test('the stored patch keeps every long-context tier rate', function () {",
              "  pm.expect(stored, 'pricing_patch in: ' + pm.response.text()).to.be.an('object');",
              "  Object.keys(expected).forEach(function (k) {",
              "    pm.expect(stored[k], k + ' in ' + JSON.stringify(stored)).to.eql(expected[k]);",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
