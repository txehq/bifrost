{
  "name": "127. Retrieve model (GET /v1/models/{model})",
  "description": "Pins the OpenAI-spec Retrieve model endpoint (GET /v1/models/{model}) requested by a customer integration that validates a model before use. Positive rows cover every provider with a native retrieve that the harness profile configures (OpenAI, Groq, xAI, Mistral, Anthropic, Gemini, Cohere; Ollama is not in the profile) on the native route, where the path carries provider/model and the body is served by the model_retrieve request type. The /openai drop-in row asserts the OpenAI Model object shape (object, id, created, owned_by). Anthropic resolves an alias to its dated id. Negative rows pin that an unknown model surfaces the provider 404 rather than an unsupported error, and that a provider without a retrieve endpoint (DeepSeek) returns 400 unsupported_operation. Encoded rows send the id the way OpenAI SDKs do (provider%2Fmodel), which the route must decode once before parsing, while an encoded ../ is still refused.",
  "item": [
    {
      "name": "Retrieve model: openai/gpt-4o-mini (native /v1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"OpenAI model metadata is returned\", function () {",
              "  var body = pm.response.text() || '';",
              "  pm.expect(pm.response.code, 'retrieve failed: ' + body).to.equal(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.extra_fields && j.extra_fields.request_type, 'not served by the retrieve path: ' + body).to.equal('model_retrieve');",
              "  pm.expect(j.id, body).to.equal('openai/gpt-4o-mini');",
              "  pm.expect(j.created, 'created must be a unix timestamp: ' + body).to.be.a('number');",
              "  pm.expect(j.owned_by, body).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/models/openai/gpt-4o-mini",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "models",
            "openai",
            "gpt-4o-mini"
          ]
        }
      }
    },
    {
      "name": "Retrieve model: gpt-4o-mini via /openai drop-in (OpenAI spec shape)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Response matches the OpenAI Model object\", function () {",
              "  var body = pm.response.text() || '';",
              "  pm.expect(pm.response.code, 'retrieve failed: ' + body).to.equal(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.object, 'object must be \"model\": ' + body).to.equal('model');",
              "  pm.expect(j.id, body).to.be.a('string');",
              "  pm.expect(j.id.slice(-'gpt-4o-mini'.length), body).to.equal('gpt-4o-mini');",
              "  pm.expect(j.created, 'created must be a unix timestamp: ' + body).to.be.a('number');",
              "  pm.expect(j.owned_by, body).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{openaiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/openai/v1/models/gpt-4o-mini",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "openai",
            "v1",
            "models",
            "gpt-4o-mini"
          ]
        }
      }
    },
