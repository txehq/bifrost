{
  "name": "598. A video job's input images beyond the model's free allowance are billed: a MiniMax-H3 2K clip with eight reference images settles at the clip price plus 3 x input_cost_per_image (video input images) [SERIAL]",
  "item": [
    {
      "name": "598.1 the fixture gateway runs with provider job accounting off; its client config is kept to restore at the end (video input images)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Bifrost-Setup-Token",
            "value": "bifrost-e2e-setup-token"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('imgAcctClientConfig');",
              "pm.collectionVariables.unset('imgAcctVideoId');",
              "pm.collectionVariables.unset('imgAcctRetry');",
              "pm.test('accounting reads back off', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.client_config && j.client_config.disable_provider_job_accounting, pm.response.text().slice(0, 400)).to.equal(true);",
              "});",
              "var cc = pm.response.code === 200 ? pm.response.json().client_config : null;",
              "if (cc) { pm.collectionVariables.set('imgAcctClientConfig', JSON.stringify(cc)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "598.2 [EXPECT-200] turn provider job accounting on, which starts the video sweeper (video input images)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Bifrost-Setup-Token",
            "value": "bifrost-e2e-setup-token"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{imgAcctOnBody}}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var saved = pm.collectionVariables.get('imgAcctClientConfig');",
              "if (!saved) {",
              "  // 598.1 kept no config: leave the switch alone rather than write a partial one.",
              "  pm.execution.skipRequest();",
              "} else {",
              "  var cc = JSON.parse(saved);",
              "  cc.disable_provider_job_accounting = false;",
              "  pm.variables.set('imgAcctOnBody', JSON.stringify({ client_config: cc }));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('accounting turned on', function () {",
              "  pm.expect(pm.response.code, pm.response.text().slice(0, 400)).to.eql(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "598.3 minimax/fixture-minimax-images POST /v1/videos with eight reference images, resolution 2K and no size is queued (video input images)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/videos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"minimax/fixture-minimax-images\",\n  \"prompt\": \"a paper boat drifts across a still pond at dawn\",\n  \"seconds\": \"6\",\n  \"resolution\": \"2K\",\n  \"reference_images\": [\n    \"https://example.com/fixture-ref-1.png\",\n    \"https://example.com/fixture-ref-2.png\",\n    \"https://example.com/fixture-ref-3.png\",\n    \"https://example.com/fixture-ref-4.png\",\n    \"https://example.com/fixture-ref-5.png\",\n    \"https://example.com/fixture-ref-6.png\",\n    \"https://example.com/fixture-ref-7.png\",\n    \"https://example.com/fixture-ref-8.png\"\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('create returns the queued MiniMax task', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.id, pm.response.text()).to.eql('fixture-minimax-images-task:minimax');",
              "});",
              "if (pm.response.code === 200) { pm.collectionVariables.set('imgAcctVideoId', pm.response.json().id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "598.4 minimax GET /v1/videos/{id} reports the 6 second clip finished, so the job is due for settlement (video input images)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/videos/{{imgAcctVideoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos",
            "{{imgAcctVideoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the retrieve reports a finished 6 second clip and no size', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.status, pm.response.text()).to.eql('completed');",
              "  pm.expect(j.seconds, pm.response.text()).to.eql('6');",
              "  pm.expect(j.size || '', 'a size would band the job without the tier: ' + pm.response.text()).to.eql('');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "598.5 the settled job is priced at 6 s x $0.13 plus 3 x $0.04 for the images beyond the free five, where main billed no image (video input images)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/logs?providers=minimax&models=fixture-minimax-images&limit=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "logs"
          ],
          "query": [
            {
              "key": "providers",
              "value": "minimax"
            },
            {
              "key": "models",
              "value": "fixture-minimax-images"
            },
            {
              "key": "limit",
              "value": "50"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var retry = Number(pm.collectionVariables.get('imgAcctRetry') || 0);",
              "if (retry > 0) {",
              "  // The video sweeper ticks every 30 s; newman drains pending timers before it sends.",
              "  var until = Date.now() + 2000;",
              "  (function waitBeforeRetry() { if (Date.now() < until) { setTimeout(waitBeforeRetry, 100); } })();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('logs query responds', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "});",
              "if (pm.response.code !== 200) { pm.collectionVariables.unset('imgAcctRetry'); return; }",
              "// The settlement row is the one whose video_debug carries accounting.",
              "var row = null;",
              "(pm.response.json().logs || []).forEach(function (l) {",
              "  var vd = l.video_debug;",
              "  if (!row && vd && vd.accounting && String(vd.video_id || '').indexOf('fixture-minimax-images-task') === 0) { row = l; }",
              "});",
              "var retry = Number(pm.collectionVariables.get('imgAcctRetry') || 0);",
              "if (!row && retry < 45) {",
              "  pm.collectionVariables.set('imgAcctRetry', retry + 1);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "pm.collectionVariables.unset('imgAcctRetry');",
              "pm.test('the job settled within 90 s of the retrieve', function () {",
              "  pm.expect(row, 'no settlement row: ' + pm.response.text().slice(0, 1500)).to.not.equal(null);",
              "});",
              "if (!row) { return; }",
              "pm.test('the settlement records the eight input images the create sent', function () {",
              "  pm.expect(row.video_debug.accounting.input_images, JSON.stringify(row.video_debug)).to.equal(8);",
              "  pm.expect(row.video_debug.accounting.resolution, JSON.stringify(row.video_debug)).to.equal('2K');",
              "});",
              "pm.test('priced at 6 s x $0.13 plus 3 x $0.04: input_cost_per_image beyond provider_specific_entry.minimax_free_input_images (TXE-7409)', function () {",
              "  pm.expect(row.cost, JSON.stringify(row).slice(0, 1500)).to.be.closeTo(0.90, 1e-9);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "598.6 [EXPECT-200] teardown: provider job accounting is turned back off with the client config 598.1 kept, whatever the rows above did (video input images)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Bifrost-Setup-Token",
            "value": "bifrost-e2e-setup-token"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{imgAcctOffBody}}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var saved = pm.collectionVariables.get('imgAcctClientConfig');",
              "if (!saved) {",
              "  // 598.2 did not run either, so accounting was never turned on.",
              "  pm.execution.skipRequest();",
              "} else {",
              "  var cc = JSON.parse(saved);",
              "  cc.disable_provider_job_accounting = true;",
              "  pm.variables.set('imgAcctOffBody', JSON.stringify({ client_config: cc }));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('imgAcctRetry');",
              "pm.test('accounting turned back off', function () {",
              "  pm.expect(pm.response.code, pm.response.text().slice(0, 400)).to.eql(200);",
              "});",
              "pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/config', method: 'GET', header: { 'X-Bifrost-Setup-Token': 'bifrost-e2e-setup-token' } }, function (err, res) {",
              "  pm.test('accounting reads back off', function () {",
              "    pm.expect(err, 'gateway unreachable: ' + err).to.equal(null);",
              "    var j = res.json();",
              "    pm.expect(j.client_config && j.client_config.disable_provider_job_accounting, res.text().slice(0, 400)).to.equal(true);",
              "  });",
              "});",
              "pm.collectionVariables.unset('imgAcctClientConfig');",
              "pm.collectionVariables.unset('imgAcctVideoId');"
            ]
          }
        }
      ]
    }
  ]
}
