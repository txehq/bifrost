      ]
    },
    {
      "name": "[EXPECT-4XX] bedrock/global.anthropic.claude-sonnet-4-6 Claude Code streaming error preserves Bedrock message - bedrock-diagnostics-stripping",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "anthropic-version",
            "value": "2023-06-01"
          },
          {
            "key": "User-Agent",
            "value": "claude-cli/2.1.267 (external, cli)"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/anthropic/v1/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "anthropic",
            "v1",
            "messages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"model\":\"bedrock/global.anthropic.claude-sonnet-4-6\",\"max_tokens\":32,\"stream\":true,\"temperature\":5,\"messages\":[{\"role\":\"user\",\"content\":\"Reply with exactly: OK\"}],\"diagnostics\":{\"previous_message_id\":null}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var code = pm.response.code;",
              "var text = pm.response.text() || '';",
              "if (code === 503 && /ServiceUnavailable|Throttl|ModelNotReady/i.test(text)) { return; }",
              "if (code === 529 && /overloaded/i.test(text)) { return; }",
              "if (code === 500 || code === 502 || code === 504) { return; }",
              "if (code < 400) { return; }",
              "var body = {};",
              "try { body = pm.response.json() || {}; } catch (e) { body = {}; }",
              "var errField = body.error || {};",
              "var message = typeof errField.message === 'string' ? errField.message : '';",
              "pm.test('Claude Code streaming path returns an Anthropic error envelope', function () {",
              "  pm.expect(body.type, 'unexpected error body: ' + text).to.equal('error');",
              "  pm.expect(errField, 'missing error object: ' + text).to.be.an('object');",
              "});",
              "pm.test('Claude Code streaming path preserves the Bedrock error message', function () {",
              "  pm.expect(message.length, 'Bedrock error was converted to an empty Anthropic message: ' + text).to.be.above(0);",
              "  pm.expect(message.toLowerCase(), 'expected the forced temperature validation reason: ' + message).to.include('temperature');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
