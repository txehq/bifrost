{
  "name": "95. Bedrock diagnostics stripping (bedrock-diagnostics-stripping)",
  "description": "Claude Code sends diagnostics.previous_message_id on Anthropic Messages requests. Amazon Bedrock does not support this Anthropic-only field and returns HTTP 400 with \"diagnostics: Extra inputs are not permitted\" if it reaches the provider. The first two cases verify the shared typed sanitizer removes diagnostics from the provider request both without a harness user agent and with the Claude Code user agent from the reported incident. The raw provider request is inspected so a coincidental successful response cannot pass. The third case forces an unrelated Bedrock ValidationException on the same streaming Claude Code path and verifies the Anthropic error envelope carries a non-empty provider message instead of {\"type\":\"error\",\"error\":{\"type\":\"api_error\",\"message\":\"\"}}.",
  "item": [
    {
      "name": "bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0 /anthropic/v1/messages strips diagnostics - bedrock-diagnostics-stripping",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "anthropic-version",
            "value": "2023-06-01"
          },
          {
            "key": "x-bf-send-back-raw-request",
            "value": "true"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/anthropic/v1/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "anthropic",
            "v1",
            "messages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"model\":\"bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0\",\"max_tokens\":32,\"messages\":[{\"role\":\"user\",\"content\":\"Reply with exactly: OK\"}],\"diagnostics\":{\"previous_message_id\":null}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var text = pm.response.text() || '';",
              "if ([401, 403, 429, 500, 502, 503, 504].indexOf(pm.response.code) !== -1) { return; }",
              "pm.test('Bedrock does not reject diagnostics', function () {",
              "  pm.expect(text, 'diagnostics reached Bedrock: ' + text).to.not.include('diagnostics: Extra inputs are not permitted');",
              "  pm.expect(pm.response.code, 'request failed: ' + text).to.be.below(400);",
              "});",
              "if (pm.response.code >= 400) { return; }",
              "var body = pm.response.json();",
              "var raw = (body.extra_fields || {}).raw_request;",
              "if (typeof raw === 'string') { try { raw = JSON.parse(raw); } catch (e) { raw = null; } }",
              "pm.test('Bedrock provider request strips diagnostics', function () {",
              "  pm.expect(raw, 'extra_fields.raw_request missing - is send_back_raw_request honoured? body=' + text).to.be.an('object');",
              "  pm.expect(raw.messages, 'provider request lost messages: ' + JSON.stringify(raw)).to.be.an('array').that.is.not.empty;",
              "  pm.expect(raw, 'diagnostics survived into Bedrock request: ' + JSON.stringify(raw)).to.not.have.property('diagnostics');",
              "});"
            ]
          }
        }
      ]
    },
    {
