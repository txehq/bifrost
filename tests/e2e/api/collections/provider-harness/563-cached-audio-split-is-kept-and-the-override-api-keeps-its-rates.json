{
  "name": "563. The override API keeps every cached-audio rate the datasheet publishes (cached-audio rates) [SERIAL]",
  "description": "TXE-7361. OpenAI and Gemini split cached input by modality (cached_tokens_details, cacheTokensDetails), and the datasheet prices cached audio apart (azure/gpt-realtime-mini: 3e-07 against a text cache rate of 6e-08). The fork dropped both the split and the rate, so cached audio was billed at the text cache rate, 5x under. 563.0 and 563.0b run against the fixture only: a chat answer carrying OpenAI's split comes back with it, under OpenAI's name and Bifrost's (before the change the split was dropped), and its logged cost prices the cached audio at the cached-audio rate (0.0032208; 0.0040408 before). The remaining rows pin that the override API stores every new cached-audio field. The override is VK-scoped and never used for a request.",
  "item": [
    {
      "name": "563.0 the chat answer keeps OpenAI's cached modality split (fixture) - openai/upstream-cached-audio",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('chat through the fixture succeeds', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.eql(200);",
              "});",
              "var d = ((pm.response.json().usage || {}).prompt_tokens_details) || {};",
              "pm.test('the cached split is returned under OpenAI\\'s name and Bifrost\\'s', function () {",
              "  pm.expect(d.cached_tokens, JSON.stringify(d)).to.eql(600);",
              "  pm.expect((d.cached_tokens_details || {}).audio_tokens, JSON.stringify(d)).to.eql(500);",
              "  pm.expect((d.cached_tokens_details || {}).text_tokens, JSON.stringify(d)).to.eql(100);",
              "  pm.expect((d.cached_read_token_details || {}).audio_tokens, JSON.stringify(d)).to.eql(500);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\": \"openai/upstream-cached-audio\", \"messages\": [{\"role\": \"user\", \"content\": \"hello\"}]}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      }
    },
    {
      "name": "563.0b the cached audio is billed at the cached-audio rate (fixture) - openai/upstream-cached-audio",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "pm.collectionVariables.set('cachedAudioCostReq', 'e2e-cached-audio-cost-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('chat through the fixture succeeds', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.eql(200);",
              "});",
              "var BASE = pm.variables.get('baseUrl');",
              "var reqId = pm.collectionVariables.get('cachedAudioCostReq');",
              "// 1000 prompt tokens: 200 text and 800 audio, of which 600 cached (100 text, 500 audio), and 2 output, at",
              "// gpt-realtime-mini's rates: 100 uncached text x 6e-07 + 300 uncached audio x 1e-05 + 100 cached text x 6e-08",
              "// + 500 cached audio x 3e-07 + 2 out x 2.4e-06. Before TXE-7361 the split was dropped: all 400 uncached tokens were",
              "// priced as audio (audio_tokens counts cached audio too) and the cached audio at the text cache rate, 0.0040408.",
              "var want = 0.0032208, old = 0.0040408;",
              "function read(tries) {",
              "  pm.sendRequest({ url: BASE + '/api/logs?request_id=' + reqId + '&limit=1', method: 'GET' }, function (err, res) {",
              "    var rows = (!err && res.code === 200) ? (res.json().logs || []) : [];",
              "    var logRow = rows.filter(function (r) { return r.id === reqId; })[0];",
              "    if ((!logRow || !(logRow.cost > 0)) && tries > 0) { setTimeout(function () { read(tries - 1); }, 300); return; }",
              "    pm.test('the call was logged under its request id', function () {",
              "      pm.expect(logRow, err ? String(err) : res.text()).to.not.equal(undefined);",
              "    });",
              "    if (!logRow) { return; }",
              "    pm.test('the cached audio is priced at the cached-audio rate', function () {",
              "      pm.expect(Math.abs(logRow.cost - want), 'cost ' + logRow.cost + ' vs ' + want + ' (before TXE-7361: ' + old + '); token_usage: ' + JSON.stringify(logRow.token_usage)).to.be.at.most(Math.max(1e-9, want * 1e-6));",
              "    });",
              "  });",
              "}",
              "read(20);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-request-id",
            "value": "{{cachedAudioCostReq}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\": \"openai/upstream-cached-audio\", \"messages\": [{\"role\": \"user\", \"content\": \"hello\"}]}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      }
    },
