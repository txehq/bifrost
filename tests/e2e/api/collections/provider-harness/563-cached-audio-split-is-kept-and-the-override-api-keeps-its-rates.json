    {
      "name": "563.2 [EXPECT-201] a VK-scoped override on every cached-audio rate is stored whole - openai/override-only",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var missing = ['cachedAudioRatesVkId'].filter(function (k) { return !pm.collectionVariables.get(k); });",
              "if (missing.length && typeof pm.execution !== 'undefined' && pm.execution.skipRequest) { pm.execution.skipRequest(); }",
              "pm.collectionVariables.unset('cachedAudioRatesOverrideId');",
              "pm.request.body.raw = JSON.stringify({",
              "  name: 'e2e-cached-audio-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8),",
              "  // Virtual-key scoped and never used for a request, so nothing in the suite is repriced.",
              "  scope_kind: 'virtual_key',",
              "  virtual_key_id: pm.collectionVariables.get('cachedAudioRatesVkId'),",
              "  match_type: 'exact',",
              "  pattern: 'gpt-realtime-mini',",
              "  request_types: ['chat_completion'],",
              "  patch: {\"cache_read_input_audio_token_cost\": 1e-06, \"cache_read_input_audio_token_cost_flex\": 2e-06, \"cache_read_input_audio_token_cost_priority\": 3e-06, \"cache_read_input_audio_token_cost_batches\": 4e-06}",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Override on the cached-audio rates is accepted', function () {",
              "  pm.expect(pm.response.code, 'body: ' + pm.response.text()).to.eql(201);",
              "});",
              "var body = null;",
              "try { body = pm.response.json(); } catch (e) { body = null; }",
              "var ov = body && (body.pricing_override || body);",
              "if (ov && ov.id) { pm.collectionVariables.set('cachedAudioRatesOverrideId', ov.id); }",
              "var expected = {\"cache_read_input_audio_token_cost\": 1e-06, \"cache_read_input_audio_token_cost_flex\": 2e-06, \"cache_read_input_audio_token_cost_priority\": 3e-06, \"cache_read_input_audio_token_cost_batches\": 4e-06};",
              "var stored = null;",
              "try { stored = ov && JSON.parse(ov.pricing_patch); } catch (e) { stored = null; }",
              "pm.test('the stored patch keeps every cached-audio rate', function () {",
              "  pm.expect(stored, 'pricing_patch in: ' + pm.response.text()).to.be.an('object');",
              "  Object.keys(expected).forEach(function (k) {",
              "    pm.expect(stored[k], k + ' in ' + JSON.stringify(stored)).to.eql(expected[k]);",
              "  });",
              "});"
            ]
          }
        }
      ],
