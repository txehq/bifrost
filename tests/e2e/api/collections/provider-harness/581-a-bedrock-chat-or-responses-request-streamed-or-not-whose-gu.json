    {
      "name": "581.5 a streamed POST /v1/chat/completions with a guardrailConfig reports the guardrail's policy units on the usage chunk (bedrock guardrail units)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
