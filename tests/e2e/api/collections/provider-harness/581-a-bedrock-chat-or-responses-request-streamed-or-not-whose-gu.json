            "completions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"bedrock/amazon.nova-lite-v1:0\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Summarise our refund policy.\"\n    }\n  ],\n  \"stream\": true,\n  \"stream_options\": {\n    \"include_usage\": true\n  },\n  \"guardrailConfig\": {\n    \"guardrailIdentifier\": \"fixture-guardrail\",\n    \"guardrailVersion\": \"1\",\n    \"trace\": \"enabled\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "pm.collectionVariables.unset('guardrailUnitsRetry');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 600)).to.eql(200);",
              "});",
              "var events = pm.response.text().split('\\n').filter(function (l) { return l.indexOf('data: ') === 0 && l !== 'data: [DONE]'; }).map(function (l) { try { return JSON.parse(l.slice(6)); } catch (e) { return null; } }).filter(Boolean);",
              "pm.test('the guardrail_units sum the input and output assessments: 4 content, 1 topic, 1 sensitive-information', function () {",
              "  var g = (events.filter(function (e) { return e.usage && e.usage.guardrail_units; }).pop() || { usage: {} }).usage.guardrail_units;",
              "  pm.expect(g, 'no guardrail_units: ' + pm.response.text().slice(-1500)).to.be.an('object');",
              "  pm.expect(g.content_policy_units, JSON.stringify(g)).to.eql(4);",
              "  pm.expect(g.topic_policy_units, JSON.stringify(g)).to.eql(1);",
              "  pm.expect(g.sensitive_information_policy_units, JSON.stringify(g)).to.eql(1);",
              "});"
            ]
          }
        }
      ]
