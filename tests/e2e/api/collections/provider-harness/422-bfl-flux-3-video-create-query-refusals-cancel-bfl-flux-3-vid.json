    {
      "name": "422.12 bfl GET /v1/videos/{id}/content returns the file a Ready task's sample link names, as video/mp4, while the file host is still sending it (bfl flux 3 video)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"base_url\": \"{{baseUrl}}\",\n  \"path\": \"/v1/videos/bfl-video-media-gapped%7Cflux-3-video:bfl/content\",\n  \"headers\": {{mediaProbeHeaders}}\n}"
        },
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__probe/download",
          "host": [
            "{{providerErrorFixtureUrl}}"
          ],
          "path": [
            "__probe",
            "download"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "// The probe calls the gateway itself, so it carries the gateway credential the harness would have sent.",
              "var auth = pm.variables.get('admin_auth_header') || pm.environment.get('admin_auth_header');",
              "var headers = {};",
              "if (auth) { headers.Authorization = auth; }",
              "pm.variables.set('mediaProbeHeaders', JSON.stringify(headers));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.expect(pm.response.code, 'probe failed: ' + pm.response.text()).to.equal(200);",
              "var r = pm.response.json().data[0];",
              "pm.test('/v1/videos/{id}/content answered 200 with the whole video/mp4 file', function () {",
              "  pm.expect(r.status, JSON.stringify(r)).to.equal(200);",
              "  pm.expect(r.content_type, JSON.stringify(r)).to.equal('video/mp4');",
              "  pm.expect(r.bytes, JSON.stringify(r)).to.equal(2 * 256 * 1024);",
              "  pm.expect(r.sends.length, 'the fixture wrote the file in ' + r.sends.length + ' halves: ' + JSON.stringify(r)).to.equal(2);",
              "});",
              "pm.test('the first bytes reach the caller before the file host has sent the second half: the file is not held whole', function () {",
              "  pm.expect(r.first_byte_ms, 'the first byte arrived at ' + r.first_byte_ms + 'ms, after the file host wrote the second half at ' + r.sends[1] + 'ms: ' + JSON.stringify(r)).to.be.below(r.sends[1]);",
              "});"
            ]
          }
        }
      ]
    },
