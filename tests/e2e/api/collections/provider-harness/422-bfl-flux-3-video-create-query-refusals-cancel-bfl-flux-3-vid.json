          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('seconds became duration, 1080p became fhd, mode t2v, the extra field passed unchanged', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var calls = pm.response.json().data[0].calls.filter(function (c) { return c.path === '/pp/bfl/v1/flux-3-video'; });",
              "  pm.expect(calls.length, JSON.stringify(calls)).to.eql(1);",
              "  var sent = JSON.parse(calls[0].body);",
              "  pm.expect(sent.mode).to.eql('t2v');",
              "  pm.expect(sent.duration).to.eql(5);",
              "  pm.expect(sent.aspect_ratio).to.eql('16:9');",
              "  pm.expect(sent.resolution).to.eql('fhd');",
              "  pm.expect(sent.safety_tolerance).to.eql(2);",
              "  pm.expect(sent).to.not.have.property('seconds');",
              "  pm.expect(sent).to.not.have.property('model');",
              "});"
            ]
          }
        }
      ]
    },
