              "  pm.expect(j.videos).to.eql([{ type: 'url', url: 'https://delivery.example.test/bfl/sample.mp4', content_type: 'video/mp4' }]);",
              "  pm.expect(j.completed_at).to.eql(1762700000);",
              "  pm.expect(j.expires_at).to.eql(1762707200);",
              "  pm.expect(j.usage.vendor_cost).to.eql({ amount: 30, unit: 'credit' });",
              "});"
            ]
          }
        }
      ]
