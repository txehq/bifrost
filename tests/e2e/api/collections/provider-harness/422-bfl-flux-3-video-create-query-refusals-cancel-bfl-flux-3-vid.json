              "  pm.expect(sent.resolution).to.eql('fhd');",
              "  pm.expect(sent.safety_tolerance).to.eql(2);",
              "  pm.expect(sent).to.not.have.property('seconds');",
              "  pm.expect(sent).to.not.have.property('model');",
              "});"
            ]
