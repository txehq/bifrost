{
  "name": "581. A Bedrock chat whose guardrail consumed policy units reports them and is charged them at the guardrail unit rates (bedrock guardrail units)",
  "item": [
    {
      "name": "581.1 bedrock/amazon.nova-lite-v1:0 POST /v1/chat/completions with a guardrailConfig reports the guardrail's policy units in usage.guardrail_units (bedrock guardrail units)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"bedrock/amazon.nova-lite-v1:0\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Summarise our refund policy.\"\n    }\n  ],\n  \"guardrailConfig\": {\n    \"guardrailIdentifier\": \"fixture-guardrail\",\n    \"guardrailVersion\": \"1\",\n    \"trace\": \"enabled\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "pm.collectionVariables.unset('guardrailUnitsRetry');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 600)).to.eql(200);",
              "});",
              "var g = (pm.response.json().usage || {}).guardrail_units;",
              "pm.test('usage.guardrail_units sums the input and output assessments: 4 content, 1 topic, 1 sensitive-information', function () {",
              "  pm.expect(g, 'usage: ' + JSON.stringify(pm.response.json().usage)).to.be.an('object');",
              "  pm.expect(g.content_policy_units, JSON.stringify(g)).to.eql(4);",
              "  pm.expect(g.topic_policy_units, JSON.stringify(g)).to.eql(1);",
              "  pm.expect(g.sensitive_information_policy_units, JSON.stringify(g)).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "581.2 the log row is charged the tokens plus the guardrail units at the bedrock/guardrails rates, where a build that drops guardrail_cost_per_unit charges the tokens only (bedrock guardrail units)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Bifrost-Setup-Token",
            "value": "bifrost-e2e-setup-token"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/logs?providers=bedrock&models=amazon.nova-lite-v1:0&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "logs"
          ],
          "query": [
            {
              "key": "providers",
              "value": "bedrock"
            },
            {
              "key": "models",
              "value": "amazon.nova-lite-v1:0"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var retry = Number(pm.collectionVariables.get('guardrailUnitsRetry') || 0);",
              "if (retry > 0) {",
              "  // The log row is written after the response; newman drains pending timers before it sends.",
              "  var until = Date.now() + 500;",
              "  (function waitBeforeRetry() { if (Date.now() < until) { setTimeout(waitBeforeRetry, 50); } })();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('logs query responds', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "});",
              "var row = (pm.response.code === 200 ? (pm.response.json().logs || []) : []).find(function (l) { return typeof l.cost === 'number' && l.cost > 0.0005; });",
              "var retry = Number(pm.collectionVariables.get('guardrailUnitsRetry') || 0);",
              "if (!row && retry < 20) {",
              "  pm.collectionVariables.set('guardrailUnitsRetry', retry + 1);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "pm.collectionVariables.unset('guardrailUnitsRetry');",
              "pm.test('the guardrailed chat was logged with its guardrail charge', function () {",
              "  pm.expect(row, 'no row charged the guardrail: ' + pm.response.text().slice(0, 1200)).to.not.equal(undefined);",
              "});",
              "if (!row) { return; }",
              "pm.test('cost is the tokens (0.00000186) plus 4 x $0.00015 + 1 x $0.00015 + 1 x $0.0001 of guardrail units', function () {",
              "  pm.expect(row.cost, JSON.stringify(row).slice(0, 1200)).to.be.closeTo(0.0008518600, 1e-9);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "581.3 [EXPECT-201] POST /api/governance/pricing-overrides sets the guardrail unit rates on amazon.nova-lite-v1:0's own row (bedrock guardrail units)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Bifrost-Setup-Token",
            "value": "bifrost-e2e-setup-token"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/governance/pricing-overrides",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "governance",
            "pricing-overrides"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "pm.collectionVariables.unset('guardrailOverrideId');",
              "pm.request.body.raw = JSON.stringify({",
              "  name: 'e2e-guardrail-units-' + Date.now(), scope_kind: 'global', match_type: 'exact',",
              "  pattern: 'amazon.nova-lite-v1:0', request_types: ['chat_completion'],",
              "  patch: { guardrail_cost_per_content_policy_unit: 0.001, guardrail_cost_per_topic_policy_unit: 0.001, guardrail_cost_per_sensitive_information_policy_unit: 0.001 }",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the override is created', function () {",
              "  pm.expect(pm.response.code, 'body: ' + pm.response.text().slice(0, 400)).to.eql(201);",
              "});",
              "var body = null; try { body = pm.response.json(); } catch (e) { body = null; }",
              "var ov = body && body.pricing_override;",
              "if (ov && ov.id) { pm.collectionVariables.set('guardrailOverrideId', ov.id); }",
              "var patch = ov && (typeof ov.pricing_patch === 'string' ? JSON.parse(ov.pricing_patch) : ov.pricing_patch);",
              "pm.test('the stored patch carries the guardrail unit rates', function () {",
              "  pm.expect(patch && patch.guardrail_cost_per_content_policy_unit, JSON.stringify(ov)).to.eql(0.001);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "581.4 the same guardrailed chat again, now under the override (bedrock guardrail units)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"bedrock/amazon.nova-lite-v1:0\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Summarise our refund policy.\"\n    }\n  ],\n  \"guardrailConfig\": {\n    \"guardrailIdentifier\": \"fixture-guardrail\",\n    \"guardrailVersion\": \"1\",\n    \"trace\": \"enabled\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "if (!pm.collectionVariables.get('guardrailOverrideId')) { pm.execution.skipRequest(); }",
              "pm.collectionVariables.unset('guardrailUnitsRetry');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 600)).to.eql(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "581.5 the second chat's log row is charged the guardrail units at the override's rates (bedrock guardrail units)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Bifrost-Setup-Token",
            "value": "bifrost-e2e-setup-token"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/logs?providers=bedrock&models=amazon.nova-lite-v1:0&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "logs"
          ],
          "query": [
            {
              "key": "providers",
              "value": "bedrock"
            },
            {
              "key": "models",
              "value": "amazon.nova-lite-v1:0"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "if (!pm.collectionVariables.get('guardrailOverrideId')) { pm.execution.skipRequest(); }",
              "var retry = Number(pm.collectionVariables.get('guardrailUnitsRetry') || 0);",
              "if (retry > 0) {",
              "  var until = Date.now() + 500;",
              "  (function waitBeforeRetry() { if (Date.now() < until) { setTimeout(waitBeforeRetry, 50); } })();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var row = (pm.response.code === 200 ? (pm.response.json().logs || []) : []).find(function (l) { return typeof l.cost === 'number' && l.cost > 0.005; });",
              "var retry = Number(pm.collectionVariables.get('guardrailUnitsRetry') || 0);",
              "if (!row && retry < 20) {",
              "  pm.collectionVariables.set('guardrailUnitsRetry', retry + 1);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "pm.collectionVariables.unset('guardrailUnitsRetry');",
              "pm.test('a row is charged at the override rates', function () {",
              "  pm.expect(row, 'no row at the override rates: ' + pm.response.text().slice(0, 1200)).to.not.equal(undefined);",
              "});",
              "if (!row) { return; }",
              "pm.test('cost is the tokens plus 4 x $0.001 + 1 x $0.001 + 1 x $0.001 of guardrail units', function () {",
              "  pm.expect(row.cost, JSON.stringify(row).slice(0, 1200)).to.be.closeTo(0.0060018600, 1e-9);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "581.6 [EXPECT-200] teardown: DELETE /api/governance/pricing-overrides/{id} removes the override (bedrock guardrail units)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Bifrost-Setup-Token",
            "value": "bifrost-e2e-setup-token"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/governance/pricing-overrides/{{guardrailOverrideId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "governance",
            "pricing-overrides",
            "{{guardrailOverrideId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "if (!pm.collectionVariables.get('guardrailOverrideId')) { pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the override is removed', function () {",
              "  pm.expect(pm.response.code, 'body: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "});",
              "pm.collectionVariables.unset('guardrailOverrideId');"
            ]
          }
        }
      ]
    }
  ]
}
