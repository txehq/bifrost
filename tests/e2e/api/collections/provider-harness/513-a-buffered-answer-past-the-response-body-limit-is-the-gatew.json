{
  "name": "513. A buffered answer past client.max_response_body_size_mb is the gateway's refusal: bifrost_internal, no retry, no fallback (response-body-limit) [SERIAL]",
  "description": "Local fixture regression for TXE-7148, no live provider calls. Run with the provider error fixture and the gateway on tests/e2e/api/provider_config/provider-error-fixture.config.json (openai base_url -> the fixture) and providerErrorFixture=1; every case is skipped otherwise. [SERIAL]: it lowers client.max_response_body_size_mb to 1 MB, which every other row's answers are read under, so the harness runs it alone and it restores the stored value at the end. The fixture answers upstream-oversize with a 2 MiB chat completion and upstream-oversize-gzip-500 with a 500 whose gzip body decompresses to 2 MiB. Each must come back as is_bifrost_error with error_type bifrost_internal and a message naming the limit, be requested from the fixture once, and never reach its configured fallback; an answer under the limit is still served.",
  "item": [
    {
      "name": "513.1 fixture hit counters reset",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "pm.test('counters cleared', function () { pm.expect(j.data[0].reset, pm.response.text()).to.equal(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__reset",
          "host": [
            "{{providerErrorFixtureUrl}}"
          ],
          "path": [
            "__reset"
          ]
        }
      }
    },
    {
      "name": "513.2 [EXPECT-200] read the stored client config (response-body-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response-body-limit: read the stored client config', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  var cc = pm.response.json().client_config;",
              "  pm.expect(cc, pm.response.text()).to.be.an('object');",
              "  // A fresh install reads back log_retention_days 0, which PUT /api/config refuses (must be >= 1).",
              "  if (!cc.log_retention_days || cc.log_retention_days < 1) { cc.log_retention_days = 30; }",
              "  pm.collectionVariables.set('rblClientConfig', JSON.stringify(cc));",
              "  pm.collectionVariables.set('rblOriginal', String(cc.max_response_body_size_mb || 0));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/config?from_db=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ],
          "query": [
            {
              "key": "from_db",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "513.3 [EXPECT-200] lower client.max_response_body_size_mb to 1 MB (response-body-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var cc = JSON.parse(pm.collectionVariables.get('rblClientConfig') || '{}');",
              "cc.max_response_body_size_mb = 1;",
              "pm.variables.set('rblBody', JSON.stringify({ client_config: cc }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response-body-limit: limit lowered to 1 MB', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{rblBody}}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ]
        }
      }
    },
    {
      "name": "513.4 [EXPECT-500] openai answer past the limit fails as bifrost_internal and goes to no fallback (response-body-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var text = pm.response.text();",
              "var j = pm.response.json();",
              "pm.test('a 2 MiB answer fails as the gateway\\'s own refusal', function () {",
              "  pm.expect(pm.response.code, text).to.be.at.least(500);",
              "  pm.expect(j.is_bifrost_error, text).to.equal(true);",
              "  pm.expect(j.extra_fields && j.extra_fields.error_type, text).to.equal('bifrost_internal');",
              "});",
              "pm.test('the message names the limit and the setting', function () {",
              "  pm.expect(j.error.message, text).to.include('limit 1 MiB').and.to.include('client.max_response_body_size_mb');",
              "});",
              "pm.test('the answer is not passed on, whole or cut short', function () {",
              "  pm.expect(text.length, 'response is ' + text.length + ' bytes').to.be.below(65536);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"openai/upstream-oversize\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"hi\"\n    }\n  ],\n  \"max_tokens\": 8,\n  \"fallbacks\": [\n    \"openai/upstream-ok~rbl-fallback\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      }
    },
    {
      "name": "513.5 [EXPECT-500] openai 500 whose gzip body decompresses past the limit fails the same way (response-body-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var text = pm.response.text();",
              "var j = pm.response.json();",
              "pm.test('an error body that expands to 2 MiB fails as the gateway\\'s own refusal', function () {",
              "  pm.expect(pm.response.code, text).to.be.at.least(500);",
              "  pm.expect(j.is_bifrost_error, text).to.equal(true);",
              "  pm.expect(j.extra_fields && j.extra_fields.error_type, text).to.equal('bifrost_internal');",
              "});",
              "pm.test('the message names the limit and the setting', function () {",
              "  pm.expect(j.error.message, text).to.include('limit 1 MiB').and.to.include('client.max_response_body_size_mb');",
              "});",
              "pm.test('the answer is not passed on, whole or cut short', function () {",
              "  pm.expect(text.length, 'response is ' + text.length + ' bytes').to.be.below(65536);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"openai/upstream-oversize-gzip-500\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"hi\"\n    }\n  ],\n  \"max_tokens\": 8,\n  \"fallbacks\": [\n    \"openai/upstream-ok~rbl-fallback\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      }
    },
    {
      "name": "513.6 [EXPECT-200] openai answer under the limit is served (response-body-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "pm.test('an answer under the limit is served', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  pm.expect(j.choices[0].message.content, pm.response.text()).to.equal('hello');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"openai/upstream-ok~rbl-under\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"hi\"\n    }\n  ],\n  \"max_tokens\": 8\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      }
    },
    {
      "name": "513.7 [EXPECT-200] each over-limit answer was requested once and no fallback ran (response-body-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var hits = pm.response.json().data[0].hits;",
              "pm.test('each over-limit answer was requested once: no retry', function () {",
              "  pm.expect(hits['upstream-oversize'], JSON.stringify(hits)).to.equal(1);",
              "  pm.expect(hits['upstream-oversize-gzip-500'], JSON.stringify(hits)).to.equal(1);",
              "});",
              "pm.test('the fallback was never called', function () {",
              "  pm.expect(hits['upstream-ok~rbl-fallback'] || 0, JSON.stringify(hits)).to.equal(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__hits",
          "host": [
            "{{providerErrorFixtureUrl}}"
          ],
          "path": [
            "__hits"
          ]
        }
      }
    },
    {
      "name": "513.8 [EXPECT-200] restore client.max_response_body_size_mb (response-body-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var cc = JSON.parse(pm.collectionVariables.get('rblClientConfig') || '{}');",
              "cc.max_response_body_size_mb = Number(pm.collectionVariables.get('rblOriginal') || 0);",
              "pm.variables.set('rblBody', JSON.stringify({ client_config: cc }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response-body-limit: original limit restored', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{rblBody}}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ]
        }
      }
    },
    {
      "name": "513.9 [EXPECT-200] the original limit is stored again (response-body-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response-body-limit: max_response_body_size_mb is back to what it was', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  var cc = pm.response.json().client_config || {};",
              "  pm.expect(String(cc.max_response_body_size_mb || 0), pm.response.text()).to.equal(pm.collectionVariables.get('rblOriginal') || '0');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/config?from_db=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ],
          "query": [
            {
              "key": "from_db",
              "value": "true"
            }
          ]
        }
      }
    }
  ]
}
