      "name": "418.7 [EXPECT-400] gemini POST /v1/videos/{id}/cancel of a completed Omni interaction is provider_cancel_unsupported (gemini omni video)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/videos/interactions%2Fomni-completed:gemini/cancel",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos",
            "interactions%2Fomni-completed:gemini",
            "cancel"
