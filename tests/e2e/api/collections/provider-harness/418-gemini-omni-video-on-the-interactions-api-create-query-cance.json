    {
      "name": "418.4 gemini GET /v1/videos/{id} of a completed Omni interaction reports provider_status, a content artifact, video output tokens and expires_at (gemini omni video)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/videos/interactions%2Fomni-completed:gemini",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos",
            "interactions%2Fomni-completed:gemini"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the query returns the completed task object', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.id, 'id: ' + pm.response.text()).to.eql('interactions%2Fomni-completed:gemini');",
              "  pm.expect(j.status, 'status').to.eql('completed');",
              "  pm.expect(j.provider_status, 'provider_status').to.eql('completed');",
              "  pm.expect(j.videos, 'videos: ' + pm.response.text()).to.eql([{ type: 'content', content_type: 'video/mp4' }]);",
              "  pm.expect(j.usage && j.usage.output_tokens, 'usage: ' + pm.response.text()).to.eql(46336);",
              "  pm.expect(j.completed_at, 'completed_at').to.be.a('number');",
              "  pm.expect(j.expires_at, 'expires_at is completed_at plus 48 hours').to.eql(j.completed_at + 172800);",
              "  pm.expect(j.content_filter, 'content_filter').to.eql(undefined);",
              "});"
            ]
          }
        }
      ]
    },
