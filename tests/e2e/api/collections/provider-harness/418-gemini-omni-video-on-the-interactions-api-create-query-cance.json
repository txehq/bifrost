        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the cancel is refused as provider_cancel_unsupported', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(400);",
              "  var j = pm.response.json();",
              "  pm.expect(j.extra_fields && j.extra_fields.error_type, 'error_type: ' + pm.response.text()).to.eql('provider_cancel_unsupported');",
              "  pm.expect(j.error.message, 'message: ' + pm.response.text()).to.include('completed');",
              "});",
              "var FX = pm.variables.get('providerErrorFixtureUrl') || 'http://127.0.0.1:8791';",
              "pm.sendRequest({ url: FX + '/__wire', method: 'GET' }, function (err, res) {",
              "  pm.test('the only cancel that reached the vendor is the running interaction\\'s, and no refused create did', function () {",
              "    pm.expect(err, String(err)).to.equal(null);",
              "    var calls = res.json().data[0].calls;",
              "    var cancels = calls.filter(function (c) { return /^\\/pp\\/gemini\\/interactions\\/[^/]+\\/cancel$/.test(c.path); }).map(function (c) { return c.path; });",
              "    pm.expect(cancels.length, 'cancels: ' + JSON.stringify(cancels)).to.be.above(0);",
              "    cancels.forEach(function (p) { pm.expect(p).to.eql('/pp/gemini/interactions/omni-running/cancel'); });",
              "    calls.filter(function (c) { return c.path === '/pp/gemini/interactions'; }).forEach(function (c) {",
              "      pm.expect(c.body, 'a refused create reached the vendor').to.not.include('1280x720');",
              "      pm.expect(c.body, 'a refused create reached the vendor').to.not.include('expires_after_seconds');",
              "    });",
              "  });",
              "});"
            ]
          }
        }
