{
  "name": "572. A video create with video_uri on a provider that cannot send it (Replicate, the OpenAI form) is refused naming it, not rendered without the video (replicate video_uri) [SERIAL]",
  "item": [
    {
      "name": "572.1 reset the fixture's record (replicate video_uri)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__reset",
          "host": [
            "{{providerErrorFixtureUrl}}"
          ],
          "path": [
            "__reset"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.expect(pm.response.code, pm.response.text()).to.eql(200);"
            ]
          }
        }
      ]
    },
    {
      "name": "572.2 [EXPECT-400] replicate/bytedance/seedance-2.0 POST /v1/videos with video_uri is refused naming video_uri: Replicate maps no model input to it, so the video would be dropped (replicate video_uri)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/videos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"replicate/bytedance/seedance-2.0\",\n  \"prompt\": \"the same boat, now at night\",\n  \"seconds\": \"5\",\n  \"video_uri\": \"https://media.example/in.mp4\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('a create with video_uri is caller_unsupported_parameter naming video_uri', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(400);",
              "  var j = pm.response.json();",
              "  pm.expect(j.extra_fields && j.extra_fields.error_type, 'error_type: ' + pm.response.text()).to.eql('caller_unsupported_parameter');",
              "  pm.expect(j.error && j.error.param, 'error.param: ' + pm.response.text()).to.eql('video_uri');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "572.3 [EXPECT-400] openai_video_keys/sora-2 (a custom provider on the OpenAI base) POST /v1/videos with video_uri is refused naming video_uri: the OpenAI create form has no source-video field, so the video would be dropped (replicate video_uri)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/videos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"openai_video_keys/sora-2\",\n  \"prompt\": \"the same boat, now at night\",\n  \"seconds\": \"4\",\n  \"video_uri\": \"https://media.example/in.mp4\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('a create with video_uri is caller_unsupported_parameter naming video_uri', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(400);",
              "  var j = pm.response.json();",
              "  pm.expect(j.extra_fields && j.extra_fields.error_type, 'error_type: ' + pm.response.text()).to.eql('caller_unsupported_parameter');",
              "  pm.expect(j.error && j.error.param, 'error.param: ' + pm.response.text()).to.eql('video_uri');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "572.4 no prediction reached Replicate: the refusal is made before any upstream call (replicate video_uri)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__wire",
          "host": [
            "{{providerErrorFixtureUrl}}"
          ],
          "path": [
            "__wire"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('no prediction create reached Replicate', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var calls = pm.response.json().data[0].calls.filter(function (c) { return c.path.indexOf('/pp/replicate/') === 0 && /\\/predictions$/.test(c.path); });",
              "  pm.expect(calls.length, JSON.stringify(calls)).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
