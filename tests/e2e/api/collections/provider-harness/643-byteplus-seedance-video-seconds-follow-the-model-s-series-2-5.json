    {
      "name": "643.8 fixture wire capture shows both 2.5 creates reached Ark with duration 30 (byteplus seedance duration series)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{providerErrorFixtureUrl}}/__wire"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var calls = pm.response.json().data[0].calls.filter(function (c) { return c.path === '/pp/byteplus/api/v3/contents/generations/tasks'; });",
              "pm.test('one create per 2.5 model reached Ark, each with duration 30', function () {",
              "  pm.expect(calls.length, JSON.stringify(calls)).to.eql(2);",
              "  var bodies = calls.map(function (c) { return JSON.parse(c.body); });",
              "  pm.expect(bodies.map(function (b) { return b.model; }), JSON.stringify(calls)).to.eql(['dreamina-seedance-2-5-260628', 'dreamina-seedance-2-5-flash-261115']);",
              "  bodies.forEach(function (b) {",
              "    pm.expect(b.duration, JSON.stringify(b)).to.eql(30);",
              "    pm.expect(b, 'unified name on the wire: ' + JSON.stringify(b)).to.not.have.property('seconds');",
              "  });",
              "});"
            ]
          }
        }
      ]
    }
