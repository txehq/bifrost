    {
      "name": "643.5 fixture wire capture proves no refused create reached Ark (byteplus seedance duration series)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{providerErrorFixtureUrl}}/__wire"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var calls = pm.response.json().data[0].calls.filter(function (c) { return c.path.indexOf('/pp/byteplus/') === 0; });",
              "pm.test('no request reached the byteplus upstream', function () {",
              "  pm.expect(calls, JSON.stringify(calls)).to.eql([]);",
              "});"
            ]
          }
        }
      ]
