              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('size became width/height, callback_url became webhook_url, the extra field passed unchanged', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var calls = pm.response.json().data[0].calls.filter(function (c) { return c.path.indexOf('/pp/bfl/') === 0; });",
              "  pm.expect(calls.length, JSON.stringify(calls)).to.eql(1);",
              "  pm.expect(calls[0].path).to.eql('/pp/bfl/v1/flux-pro-1.1');",
              "  var sent = JSON.parse(calls[0].body);",
              "  pm.expect(sent.prompt).to.eql('a red fox in fresh snow');",
              "  pm.expect(sent.width).to.eql(1024);",
              "  pm.expect(sent.height).to.eql(768);",
              "  pm.expect(sent.seed).to.eql(7);",
              "  pm.expect(sent.webhook_url).to.eql('https://hooks.example.test/v/task_421');",
              "  pm.expect(sent.safety_tolerance).to.eql(2);",
              "  pm.expect(sent).to.not.have.property('callback_url');",
              "  pm.expect(sent).to.not.have.property('size');",
              "  pm.expect(sent).to.not.have.property('model');",
              "});"
            ]
          }
        }
      ]
    },
