    {
      "name": "421.2 bfl/flux-pro-1.1 POST /v1/images/generations/tasks creates a task and returns the task object (bfl image tasks)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/images/generations/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "images",
            "generations",
            "tasks"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"bfl/flux-pro-1.1\",\n  \"prompt\": \"a red fox in fresh snow\",\n  \"size\": \"1024x768\",\n  \"seed\": 7,\n  \"callback_url\": \"https://hooks.example.test/v/task_421\",\n  \"safety_tolerance\": 2\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the create returns a queued image task with the cost and megapixels BFL reported', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.object).to.eql('image.task');",
              "  pm.expect(j.status).to.eql('queued');",
              "  pm.expect(j.id).to.eql('bfl-ready%7Cflux-pro-1.1:bfl');",
              "  pm.expect(j.data).to.eql([]);",
              "  pm.expect(j.usage.vendor_cost).to.eql({ amount: 4, unit: 'credit' });",
              "  pm.expect(j.usage.output_megapixels).to.eql(1.05);",
              "  pm.collectionVariables.set('bflImageTaskId', j.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "421.3 the submit BFL received carries the converted fields (bfl image tasks)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__wire",
          "host": [
            "{{providerErrorFixtureUrl}}"
