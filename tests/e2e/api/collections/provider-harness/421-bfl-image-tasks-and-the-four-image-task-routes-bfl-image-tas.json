              "pm.test('a Ready task is completed with the link, its expiry and the settled credits', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.id).to.eql(pm.collectionVariables.get('bflImageTaskId'));",
              "  pm.expect(j.status).to.eql('completed');",
              "  pm.expect(j.provider_status).to.eql('Ready');",
              "  pm.expect(j.data).to.eql([{ type: 'url', url: 'https://delivery.example.test/bfl/sample.jpeg', content_type: 'image/jpeg' }]);",
              "  pm.expect(j.completed_at).to.eql(1762700000);",
              "  pm.expect(j.expires_at, 'ten minutes for a model other than FLUX 3').to.eql(1762700600);",
              "  pm.expect(j.usage.vendor_cost).to.eql({ amount: 4, unit: 'credit' });",
              "});"
            ]
          }
        }
      ]
    },
