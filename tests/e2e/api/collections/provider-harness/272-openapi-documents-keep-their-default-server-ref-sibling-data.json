{
  "name": "272. OpenAPI documents keep their default server, $ref sibling data and whole allOf bodies (openapi-preservation) [SERIAL]",
  "description": "TXE-5533 regression. Local fixture regression: run with providerErrorFixture=1 against the gateway of tests/e2e/api/provider_config/provider-error-fixture.config.json, with tests/e2e/api/runners/provider-error-fixture.mjs as the only upstream. That config declares fixture_openapi, a hosted OpenAPI 3.0 document without servers, so the client connects only if the implied \"/\" server resolves to the document's host. Rows read tools/list, call tools and read what reached the fixture. Previews with a spec_url beside an inline document are never fetched, so their hosts need not exist. The setup token authenticates these calls, so the public-target gate for an unauthenticated caller is pinned by the Go test TestAddMCPClient_OpenAPI_DefaultServerIsTargetChecked, not here. A limit-only edit of the file's instruction cap needs a restart, so it is not a row here. Run the whole folder in order.",
  "item": [
    {
      "name": "a hosted document without servers previews at the host that served it - openapi-preservation",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/mcp/openapi/preview",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "mcp",
            "openapi",
            "preview"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"spec\": \"{\\\"openapi\\\": \\\"3.0.3\\\", \\\"info\\\": {\\\"title\\\": \\\"t\\\", \\\"version\\\": \\\"1\\\"}, \\\"paths\\\": {\\\"/a\\\": {\\\"get\\\": {\\\"operationId\\\": \\\"getA\\\", \\\"responses\\\": {\\\"200\\\": {\\\"description\\\": \\\"ok\\\"}}}}}}\", \"spec_url\": \"https://docs.openapi.example/v2/openapi.json\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('openapi-preservation: answered 200', function () { pm.expect(pm.response.code, pm.response.text()).to.equal(200); });",
              "var j = pm.response.json();",
              "pm.test('openapi-preservation: the default is the host, not the folder of the document', function () { pm.expect(j.base_url, pm.response.text()).to.equal('https://docs.openapi.example'); });",
              "pm.test('openapi-preservation: it is listed, so a form pins nothing', function () { pm.expect(j.servers, pm.response.text()).to.eql(['https://docs.openapi.example']); });"
            ]
          }
        }
      ]
    },
