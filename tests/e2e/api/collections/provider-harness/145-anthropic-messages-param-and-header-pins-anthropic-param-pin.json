        },
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var __b = pm.response.json() || {};",
              "var rr = (__b.extra_fields || {}).raw_request;",
              "if (typeof rr === 'string') { try { rr = JSON.parse(rr); } catch (e) { rr = null; } }",
              "pm.test('raw_request captured', function () { pm.expect(rr, 'raw_request missing: ' + pm.response.text().slice(0, 400)).to.be.an('object'); });",
              "if (rr) {",
              "  pm.test('temperature is forwarded for a model that accepts it', function () {",
              "    pm.expect(rr.temperature, JSON.stringify(rr).slice(0, 600)).to.equal(0.7);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
