{
  "name": "519. Replicate video: a create must name seconds, so the job can be priced (replicate video seconds)",
  "item": [
    {
      "name": "519.1 reset the fixture's record (replicate video seconds)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__reset",
          "host": [
            "{{providerErrorFixtureUrl}}"
          ],
          "path": [
            "__reset"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.expect(pm.response.code, pm.response.text()).to.eql(200);"
            ]
          }
        }
      ]
    },
    {
      "name": "519.2 [EXPECT-400] replicate/google/veo-3 POST /v1/videos with no seconds is refused: the hosted model picks its own length and Replicate reports neither it nor a cost (replicate video seconds)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/videos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"replicate/google/veo-3\",\n  \"prompt\": \"a paper boat drifting down a rain gutter\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('a create with no seconds is caller_unsupported_parameter naming seconds', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(400);",
              "  var j = pm.response.json();",
              "  pm.expect(j.extra_fields && j.extra_fields.error_type, 'error_type: ' + pm.response.text()).to.eql('caller_unsupported_parameter');",
              "  pm.expect(j.error && j.error.param, 'error.param: ' + pm.response.text()).to.eql('seconds');",
              "  pm.expect(j.error.message, pm.response.text()).to.include('could not be priced');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "519.3 replicate/google/veo-3 POST /v1/videos with seconds creates the prediction and the task carries the seconds (replicate video seconds)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/videos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"replicate/google/veo-3\",\n  \"prompt\": \"a paper boat drifting down a rain gutter\",\n  \"seconds\": \"8\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the create with seconds is a queued task', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.id, pm.response.text()).to.include('pred_fixture_no_urls');",
              "  pm.expect(j.seconds, pm.response.text()).to.eql('8');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "519.4 only the create with seconds reached Replicate, with input.duration 8 (replicate video seconds)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__wire",
          "host": [
            "{{providerErrorFixtureUrl}}"
          ],
          "path": [
            "__wire"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('one prediction create, the one of row 3', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var calls = pm.response.json().data[0].calls.filter(function (c) { return c.path.indexOf('/pp/replicate/') === 0 && /\\/predictions$/.test(c.path); });",
              "  pm.expect(calls.length, JSON.stringify(calls)).to.eql(1);",
              "  var sent = JSON.parse(calls[0].body);",
              "  pm.expect(sent.input.duration, calls[0].body).to.eql(8);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
