{
  "name": "325. Google embeddings report only what Google bills (google embeddings usage)",
  "description": "Fork contract C4/C5 for the gemini and vertex embedding converters. Before this, Vertex text embeddings always sent parameters.autoTruncate=true when the caller sent none and dropped metadata.billableCharacterCount, and the Gemini converter counted a billable character count as prompt_tokens when no token count was reported. Now autoTruncate is sent only when given, Vertex's billable character count reaches usage.billed_characters, and Gemini usage comes from what Google reports (usageMetadata, or Vertex :embedContent's per-embedding statistics), staying empty when Google reports nothing. Google's embedding endpoints return float vectors only, so encoding_format base64 (or any non-float value) is refused with 400 caller_unsupported_parameter on encoding_format before any upstream call, where it used to be dropped, on /v1/embeddings and on the OpenAI-shaped /openai/v1/embeddings alike. The native /genai route answers in Gemini's shape rebuilt from unified usage, so it repeats only what Google reported: metadata.billableCharacterCount is the billed character count, where it used to be the token count, and no statistics.tokenCount 0 is written when Google reported none.",
  "item": [
    {
      "name": "325.1 vertex/text-embedding-005 - no autoTruncate unless given, billable characters in usage.billed_characters",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-send-back-raw-request",
            "value": "true"
          },
          {
            "key": "x-bf-send-back-raw-response",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"vertex/text-embedding-005\",\n  \"input\": \"alpha kestrel harbor\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/embeddings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "embeddings"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function asObj(v) { if (typeof v === 'string') { try { return JSON.parse(v); } catch (e) { return null; } } return v || null; }",
              "pm.test('200 with one vector', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "  pm.expect((pm.response.json().data || []).length).to.eql(1);",
              "});",
              "var j = pm.response.json(); var ef = j.extra_fields || {}; var got = asObj(ef.raw_response) || {};",
              "pm.test('Bifrost sent no autoTruncate the caller did not send', function () {",
              "  var sent = asObj(ef.raw_request);",
              "  pm.expect(sent, 'no raw_request: ' + pm.response.text().slice(0, 300)).to.be.an('object');",
              "  pm.expect(JSON.stringify(sent)).to.not.include('autoTruncate');",
              "});",
              "pm.test('usage.billed_characters is Vertex metadata.billableCharacterCount', function () {",
              "  var md = got.metadata || {}; var count = md.billableCharacterCount !== undefined ? md.billableCharacterCount : md.billable_character_count;",
              "  if (count === undefined) { pm.expect(j.usage || {}, 'Bifrost filled a count Vertex did not report').to.not.have.property('billed_characters'); return; }",
              "  pm.expect(j.usage.billed_characters).to.eql(count);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "325.2 gemini/gemini-embedding-001 - usage only from usageMetadata, never from a character count",
      "request": {
