          "raw": "{\n  \"model\": \"gemini/gemini-embedding-001\",\n  \"input\": \"alpha kestrel harbor\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/embeddings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "embeddings"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function asObj(v) { if (typeof v === 'string') { try { return JSON.parse(v); } catch (e) { return null; } } return v || null; }",
              "pm.test('200 with one vector', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "  pm.expect((pm.response.json().data || []).length).to.eql(1);",
              "});",
              "var j = pm.response.json(); var ef = j.extra_fields || {}; var got = asObj(ef.raw_response) || {};",
              "pm.test('prompt_tokens is what usageMetadata reports, or absent', function () {",
              "  var um = got.usageMetadata;",
              "  if (!um) { pm.expect((j.usage || {}).prompt_tokens || 0, 'Bifrost filled tokens Google did not report: ' + JSON.stringify(j.usage)).to.eql(0); return; }",
              "  pm.expect(j.usage.prompt_tokens).to.eql(um.promptTokenCount || um.totalTokenCount);",
              "});"
            ]
          }
        }
      ]
    },
