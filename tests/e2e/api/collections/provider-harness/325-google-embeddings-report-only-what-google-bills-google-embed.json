      "name": "325.5 /genai gemini/gemini-embedding-001:embedContent - no token count Google did not report",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": {\n    \"parts\": [\n      {\n        \"text\": \"alpha kestrel harbor\"\n      }\n    ]\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/genai/v1beta/models/gemini/gemini-embedding-001:embedContent",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "genai",
            "v1beta",
            "models",
            "gemini",
            "gemini-embedding-001:embedContent"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 with a vector', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "  pm.expect(((pm.response.json().embedding || {}).values || []).length).to.be.above(0);",
              "});",
              "pm.test('statistics.tokenCount is a reported count or absent, never an invented 0', function () {",
              "  var st = (pm.response.json().embedding || {}).statistics;",
              "  if (st === undefined) { return; }",
              "  pm.expect(st.tokenCount).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "325.6 /genai vertex/text-embedding-005:batchEmbedContents - billableCharacterCount is characters, not tokens",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requests\": [\n    {\n      \"model\": \"models/text-embedding-005\",\n      \"content\": {\n        \"parts\": [\n          {\n            \"text\": \"alpha kestrel harbor\"\n          }\n        ]\n      }\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/genai/v1beta/models/vertex/text-embedding-005:batchEmbedContents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "genai",
            "v1beta",
            "models",
            "vertex",
            "text-embedding-005:batchEmbedContents"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 with one vector', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "  pm.expect((pm.response.json().embeddings || []).length).to.eql(1);",
              "});",
              "pm.test('metadata.billableCharacterCount, when present, exceeds the token count for this input', function () {",
              "  var j = pm.response.json(); var md = j.metadata;",
              "  if (md === undefined) { return; }",
              "  var tokens = (((j.embeddings || [])[0] || {}).statistics || {}).tokenCount || 0;",
              "  pm.expect(md.billableCharacterCount, 'characters ' + JSON.stringify(md) + ' vs tokens ' + tokens).to.be.above(tokens);",
              "});"
            ]
          }
        }
      ]
    },
