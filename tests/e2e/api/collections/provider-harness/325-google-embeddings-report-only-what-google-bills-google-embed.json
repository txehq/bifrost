        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"gemini/gemini-embedding-001\",\n  \"input\": \"alpha kestrel harbor\",\n  \"encoding_format\": \"base64\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/embeddings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "embeddings"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 caller_unsupported_parameter on encoding_format', function () {",
              "  pm.expect(pm.response.code, 'body: ' + pm.response.text().slice(0, 400)).to.eql(400);",
              "  var j = pm.response.json(); var ef = j.extra_fields || {};",
              "  pm.expect(ef.error_type).to.eql('caller_unsupported_parameter');",
              "  pm.expect((j.error || {}).param).to.eql('encoding_format');",
              "  pm.expect(!!j.is_bifrost_error, 'the caller is at fault, not Bifrost').to.be.false;",
              "});",
              "pm.test('Gemini was never called', function () {",
              "  var ef = pm.response.json().extra_fields || {};",
              "  pm.expect(ef.raw_response, 'an upstream response came back').to.be.undefined;",
              "});"
            ]
          }
        }
      ]
    },
