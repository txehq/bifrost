    {
      "name": "gemini passthrough-model-visibility setup: create a virtual key allowed one gemini model by its bare id",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The run id keeps parallel runs against one server from colliding on the key name.",
              "function startFresh() {",
              "  pm.collectionVariables.unset('pmvgVkId');",
              "  pm.collectionVariables.unset('pmvgVkValue');",
              "  pm.collectionVariables.set('pmvgVkName', 'harness-passthrough-model-visibility-gemini-run-' + Date.now() + '-' + pm.variables.replaceIn('{{$guid}}'));",
              "}",
              "// A key a previous run failed to delete is retained; delete it before this run replaces it.",
              "var staleVkId = pm.collectionVariables.get('pmvgVkId');",
              "if (!staleVkId) {",
              "  startFresh();",
              "} else {",
              "  var headers = {};",
              "  var managementToken = pm.environment.get('managementApiKey') || pm.collectionVariables.get('managementApiKey');",
              "  if (managementToken) { headers.Authorization = 'Bearer ' + managementToken; }",
              "  pm.sendRequest({url: pm.variables.replaceIn('{{baseUrl}}') + '/api/governance/virtual-keys/' + staleVkId, method: 'DELETE', header: headers}, function (err, response) {",
              "    var deleted = !err && (response.code === 200 || response.code === 404);",
              "    pm.test('passthrough-model-visibility: the retained gemini virtual key from an earlier run is deleted', function () {",
              "      pm.expect(err, 'stale key ' + staleVkId + ' delete errored: ' + err).to.equal(null);",
              "      pm.expect([200, 404], 'stale key ' + staleVkId + ' not deleted: ' + response.text()).to.include(response.code);",
              "    });",
              "    if (deleted) { startFresh(); return; }",
              "    pm.collectionVariables.unset('pmvgVkValue');",
              "    pm.execution.skipRequest();",
              "  });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('passthrough-model-visibility: gemini virtual key created', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "});",
              "var vk = {};",
              "try { vk = pm.response.json().virtual_key || {}; } catch (e) { vk = {}; }",
              "pm.test('passthrough-model-visibility: gemini virtual key has an id and a value', function () {",
              "  pm.expect(vk.id, 'no id: ' + pm.response.text()).to.be.a('string').and.not.equal('');",
              "  pm.expect(vk.value, 'no value: ' + pm.response.text()).to.be.a('string').and.not.equal('');",
              "});",
              "if (vk.id) { pm.collectionVariables.set('pmvgVkId', vk.id); }",
              "if (vk.value) { pm.collectionVariables.set('pmvgVkValue', vk.value); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"{{pmvgVkName}}\",\"provider_configs\":[{\"provider\":\"gemini\",\"allowed_models\":[\"gemini-embedding-001\"],\"key_ids\":[\"*\"],\"weight\":1}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/governance/virtual-keys"
      },
      "response": []
    },
    {
      "name": "gemini passthrough-model-visibility: a body naming the allowed model as a resource still runs",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Without the key there is nothing to govern; the failed setup request already reports why.",
              "if (!pm.collectionVariables.get('pmvgVkValue')) { pm.execution.skipRequest(); return; }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var txt = pm.response.text() || '';",
              "// The key allows gemini-embedding-001 by its bare id and the body names it as models/gemini-embedding-001.",
              "// The body is read under the name the router hands up, so the key's one model keeps working: a 200 with",
              "// an embedding, never a 403 model_blocked for the resource spelling of the same model.",
              "pm.test('passthrough-model-visibility: a body naming the allowed model as a resource is 200', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + txt.slice(0, 400)).to.eql(200);",
              "});",
              "var j = {};",
              "try { j = pm.response.json() || {}; } catch (e) { j = {}; }",
              "pm.test('passthrough-model-visibility: Gemini answered with an embedding', function () {",
              "  pm.expect(j.embedding && j.embedding.values, 'no embedding: ' + txt.slice(0, 400)).to.be.an('array').with.lengthOf.at.least(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-vk",
            "value": "{{pmvgVkValue}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\":\"models/gemini-embedding-001\",\"content\":{\"parts\":[{\"text\":\"a red ceramic teapot\"}]}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/genai_passthrough/v1beta/models/gemini-embedding-001:embedContent"
      },
      "response": []
    },
    {
      "name": "gemini passthrough-model-visibility cleanup: delete the gemini virtual key",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('pmvgVkId')) { pm.execution.skipRequest(); return; }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('passthrough-model-visibility: gemini virtual key deleted', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "});",
              "if (pm.response.code === 200 || pm.response.code === 404) {",
              "  pm.collectionVariables.unset('pmvgVkId');",
              "  pm.collectionVariables.unset('pmvgVkValue');",
              "  pm.collectionVariables.unset('pmvgVkName');",
              "}"
            ]
          }
        }
      ],
      "request": {
