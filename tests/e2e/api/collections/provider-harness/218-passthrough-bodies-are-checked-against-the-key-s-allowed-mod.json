{
  "name": "218. Passthrough bodies are checked against the key's allowed models (passthrough-model-visibility) [SERIAL]",
  "description": "A virtual key allowed one Runware model sends raw task arrays through the passthrough route, whose tasks each name the model Runware runs. An array naming another model, an array mixing the allowed model with another, and an array naming no model at all are each refused with 403 model_blocked before anything reaches Runware, while an array naming only the allowed model still runs one 512x512 image. Red before the change: the three refused arrays ran on the operator's key, since the request model was read only from a JSON object body. The key is deleted at the end. A GenAI passthrough body names its model as a resource (models/<id>); a key allowed that model by its bare id still runs it, since the body is read under the same name the router hands up.",
  "item": [
    {
      "name": "runware passthrough-model-visibility setup: create a virtual key allowed one model",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The run id keeps parallel runs against one server from colliding on the key name.",
              "function startFresh() {",
              "  pm.collectionVariables.unset('pmvVkId');",
              "  pm.collectionVariables.unset('pmvVkValue');",
              "  pm.collectionVariables.set('pmvVkName', 'harness-passthrough-model-visibility-run-' + Date.now() + '-' + pm.variables.replaceIn('{{$guid}}'));",
              "}",
              "// A key a previous run failed to delete is retained; delete it before this run replaces it.",
              "var staleVkId = pm.collectionVariables.get('pmvVkId');",
              "if (!staleVkId) {",
              "  startFresh();",
              "} else {",
              "  var headers = {};",
              "  var managementToken = pm.environment.get('managementApiKey') || pm.collectionVariables.get('managementApiKey');",
              "  if (managementToken) { headers.Authorization = 'Bearer ' + managementToken; }",
              "  pm.sendRequest({url: pm.variables.replaceIn('{{baseUrl}}') + '/api/governance/virtual-keys/' + staleVkId, method: 'DELETE', header: headers}, function (err, response) {",
              "    var deleted = !err && (response.code === 200 || response.code === 404);",
              "    pm.test('passthrough-model-visibility: the retained virtual key from an earlier run is deleted', function () {",
              "      pm.expect(err, 'stale key ' + staleVkId + ' delete errored: ' + err).to.equal(null);",
              "      pm.expect([200, 404], 'stale key ' + staleVkId + ' not deleted: ' + response.text()).to.include(response.code);",
              "    });",
              "    if (deleted) { startFresh(); return; }",
              "    pm.collectionVariables.unset('pmvVkValue');",
              "    pm.execution.skipRequest();",
              "  });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('passthrough-model-visibility: virtual key created', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "});",
              "var vk = {};",
              "try { vk = pm.response.json().virtual_key || {}; } catch (e) { vk = {}; }",
              "pm.test('passthrough-model-visibility: virtual key has an id and a value', function () {",
              "  pm.expect(vk.id, 'no id: ' + pm.response.text()).to.be.a('string').and.not.equal('');",
              "  pm.expect(vk.value, 'no value: ' + pm.response.text()).to.be.a('string').and.not.equal('');",
              "});",
              "if (vk.id) { pm.collectionVariables.set('pmvVkId', vk.id); }",
              "if (vk.value) { pm.collectionVariables.set('pmvVkValue', vk.value); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"{{pmvVkName}}\",\"provider_configs\":[{\"provider\":\"runware\",\"allowed_models\":[\"runware:100@1\"],\"key_ids\":[\"*\"],\"weight\":1}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/governance/virtual-keys"
      },
      "response": []
    },
