              "pm.test('passthrough-model-visibility: an array naming another model is 403', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + txt.slice(0, 400)).to.eql(403);",
              "});",
              "pm.test('passthrough-model-visibility: the refusal is model_blocked', function () {",
              "  pm.expect(txt, 'unexpected body: ' + txt.slice(0, 400)).to.include('model_blocked');",
              "});"
            ]
          }
        }
      ],
