    {
      "name": "openai a primary refused by governance still falls back to a provider the virtual key allows - fallback-coverage",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var BASE = pm.variables.get('baseUrl');",
              "var run = 'run-' + Date.now();",
              "pm.sendRequest({ url: BASE + '/api/governance/virtual-keys', method: 'POST', header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify({ name: 'harness-fallback-coverage-vk-' + run, provider_configs: [{ provider: 'openai', allowed_models: ['*'], key_ids: ['*'], weight: 1 }] }) } }, function (err, res) {",
              "  var vk = {}; try { vk = (res.json() || {}).virtual_key || {}; } catch (e) { vk = {}; }",
              "  pm.test('setup: created a virtual key that allows openai only', function () { pm.expect(res && res.code, err ? String(err) : res.text()).to.eql(200); });",
              "  pm.collectionVariables.set('fbcVKID', vk.id || '');",
              "  pm.collectionVariables.set('fbcVKValue', (vk.value && typeof vk.value === 'object') ? vk.value.value : (vk.value || 'missing'));",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var h = function (name) { return pm.response.headers.get(name); };",
              "pm.test('the openai fallback served as fallback 1', function () {",
              "  pm.expect(h('x-bifrost-routing-info-provider'), pm.response.text().slice(0, 400)).to.eql('openai');",
              "  pm.expect(h('x-bifrost-routing-info-is-fallback'), pm.response.text().slice(0, 400)).to.eql('true');",
              "  pm.expect(h('x-bifrost-fallback-index'), pm.response.text().slice(0, 400)).to.eql('1');",
              "});",
              "pm.test('the refused primary never reached Anthropic, so none of its headers ride along', function () {",
              "  pm.expect(pm.response.headers.get('anthropic-organization-id')).to.equal(undefined);",
              "  pm.expect(pm.response.headers.get('request-id')).to.equal(undefined);",
              "});",
              "var vkID = pm.collectionVariables.get('fbcVKID');",
              "if (vkID) {",
              "  pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/governance/virtual-keys/' + vkID, method: 'DELETE' }, function (err, res) {",
              "    pm.test('cleanup: virtual key deleted', function () { pm.expect(res && res.code, err ? String(err) : res.text()).to.eql(200); });",
              "  });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-vk",
            "value": "{{fbcVKValue}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
