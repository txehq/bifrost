        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "anthropic-version",
            "value": "2023-06-01"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/anthropic/v1/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "anthropic",
            "v1",
            "messages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"anthropic/claude-harness-missing-model\",\n  \"max_tokens\": 8,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Reply with the single word: ok\"\n    }\n  ],\n  \"fallbacks\": [\n    \"openai/gpt-4o-mini\"\n  ]\n}"
        }
      }
    },
