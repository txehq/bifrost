    {
      "name": "595.7 gate_deepseek_chat/fx-gate - a custom provider that allows chat is answered, with one call carrying its own key (custom provider allowed requests)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"gate_deepseek_chat/fx-gate\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"hi\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "pm.sendRequest({ url: pm.variables.get('providerErrorFixtureUrl') + '/__reset', method: 'POST' }, function (err, res) {",
              "  pm.test('custom provider allowed requests setup: the fixture was reset', function () {",
              "    pm.expect(err, String(err)).to.equal(null);",
              "    pm.expect(res.code).to.equal(200);",
              "  });",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, answered by the custom provider', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "  pm.expect((pm.response.json().extra_fields || {}).provider).to.eql('gate_deepseek_chat');",
              "});",
              "pm.sendRequest({ url: pm.variables.get('providerErrorFixtureUrl') + '/__wire', method: 'GET' }, function (err, res) {",
              "  pm.test('the fixture answered /__wire', function () { pm.expect(err, String(err)).to.equal(null); pm.expect(res.code).to.equal(200); });",
              "  var calls = res.json().data[0].calls;",
              "  pm.test('one call reached the upstream, carrying the custom provider key', function () {",
              "    pm.expect(calls, JSON.stringify(calls).slice(0, 600)).to.have.length(1);",
              "    pm.expect(calls[0].path).to.equal('/pp/ownkey/chat/completions');",
              "    pm.expect(calls[0].bearer).to.equal('gate-deepseek-chat-secret');",
              "  });",
              "});"
            ]
          }
        }
      ]
    }
