            "api",
            "proxy-config"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"enabled\": false, \"type\": \"http\", \"url\": \"http://redacted:redacted@127.0.0.2:9\", \"timeout\": 0}"
        }
