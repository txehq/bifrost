              "pm.test('mismatched mask exact response status', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(400);",
              "});",
              "pm.test('the refusal names the masked credentials', function () {",
              "  pm.expect(pm.response.text()).to.include('masked credentials');",
