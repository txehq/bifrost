{
  "name": "642. Management reads mask a credential in a URL's userinfo (TXE-7783)",
  "description": "Regression for TXE-7783. Management reads showed a credential in a URL's userinfo (https://user:pass@host) in plain text. The rows run in order on the provider error fixture's gateway, using the global proxy because it is one of the URLs an API write may store with credentials: check the gateway has no global proxy, store a disabled one whose URL carries a fake password (disabled, so nothing is proxied), read it from GET /api/proxy-config and GET /api/config and require the userinfo masked as redacted:redacted (red before the fix: the password was returned), save the masked URL back (accepted, it keeps the stored URL), save a masked URL on another host (refused: the mask matches nothing stored), and clear the proxy. The unit tests in core/schemas and the handlers package cover the restore itself, the provider, key, MCP, webhook and agent paths, and the URL rule in TestManagementReadPathsRedactEverySecretField.",
  "item": [
    {
      "name": "url-userinfo precondition: the gateway has no global proxy for this folder to replace - url-userinfo",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/proxy-config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "proxy-config"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = null; try { j = pm.response.json(); } catch (e) { j = null; }",
              "var clean = pm.response.code === 200 && !!j && !j.enabled && !j.url;",
              "pm.collectionVariables.set('h642Ready', clean ? 'true' : 'false');",
              "pm.test('the gateway stores no global proxy URL', function () {",
              "  pm.expect(clean, 'this gateway has a global proxy; the folder does not overwrite one it did not create: ' + pm.response.text().slice(0, 300)).to.equal(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "url-userinfo store a disabled global proxy whose URL carries a fake credential - url-userinfo",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/proxy-config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "proxy-config"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"enabled\": false, \"type\": \"http\", \"url\": \"http://fakeuser:txe7783-fake-proxy-pass@127.0.0.1:9\", \"timeout\": 0}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1' || pm.collectionVariables.get('h642Ready') === 'false') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('proxy save exact response status', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "});",
              "pm.test('the proxy password in the URL appears nowhere in the response', function () {",
              "  pm.expect(pm.response.text()).to.not.include('txe7783-fake-proxy-pass');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "url-userinfo GET /api/proxy-config masks the URL's userinfo - url-userinfo",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/proxy-config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "proxy-config"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1' || pm.collectionVariables.get('h642Ready') === 'false') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('proxy read exact response status', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "});",
              "pm.test('the URL keeps its address and masks its userinfo', function () {",
              "  pm.expect(pm.response.json().url).to.equal('http://redacted:redacted@127.0.0.1:9');",
              "});",
              "pm.test('the proxy password in the URL appears nowhere in the response', function () {",
              "  pm.expect(pm.response.text()).to.not.include('txe7783-fake-proxy-pass');",
              "});"
            ]
          }
        }
      ]
    },
