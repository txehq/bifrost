            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the query maps SUCCEEDED and reads the images from output.choices', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.id, pm.response.text()).to.eql('ds-img-succeeded:dashscope');",
              "  pm.expect(j.status, pm.response.text()).to.eql('completed');",
              "  pm.expect(j.provider_status, pm.response.text()).to.eql('SUCCEEDED');",
              "  pm.expect(j.data, pm.response.text()).to.eql([",
              "    { type: 'url', url: 'https://dashscope-result.example.test/fixture/ds-img-1.png?Expires=1762842232', content_type: 'image/png' },",
              "    { type: 'url', url: 'https://dashscope-result.example.test/fixture/ds-img-2.png?Expires=1762842232', content_type: 'image/png' }",
              "  ]);",
              "  pm.expect(j.usage && j.usage.output_images, pm.response.text()).to.eql(2);",
              "  pm.expect(j.completed_at, 'end_time 2026-11-10 14:23:39 in UTC+8').to.eql(1794291819);",
              "  pm.expect(j.expires_at, 'expires_at is 24 hours after completion').to.eql(1794378219);",
              "});"
            ]
          }
        }
      ]
    },
