{
  "name": "118. Claude Sonnet 5.5 between_tools thinking type (between-tools)",
  "description": "Claude Sonnet 5.5 rejects thinking:{\"type\":\"disabled\"} and adds thinking:{\"type\":\"between_tools\"} (no up-front thinking, progress updates between tool calls), accepted at effort high or below with no display/budget_tokens. between_tools is a thinking type independent of effort, so every inbound route must carry it as reasoning.type alongside the caller's effort rather than collapsing it into effort none (which on Sonnet 5.5 omitted thinking and ran full adaptive thinking). Models without it get the nearest setting (disabled, or omitted on always-on models) so fallbacks keep working. Cases assert the OUTBOUND body via x-bf-send-back-raw-request.",
  "item": [
    {
      "name": "Anthropic /v1/messages - between_tools forwarded with effort (claude-sonnet-5-5) - between-tools",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('request succeeded', function () {",
              "  pm.expect(pm.response.code, 'unexpected status: ' + pm.response.text()).to.eql(200);",
              "});",
              "var body = pm.response.json();",
              "var raw = (body.extra_fields || {}).raw_request;",
              "if (typeof raw === 'string') { raw = JSON.parse(raw); }",
              "pm.test('between_tools forwarded as a thinking type, effort kept alongside', function () {",
              "  if (pm.response.headers.get('x-bifrost-request-type') === 'passthrough') {",
              "    // Native Messages passthrough forwards the caller's body as sent and returns Anthropic's own",
              "    // bytes, so there is no raw_request; anthropicmsg and the route tests cover those bytes offline.",
              "    pm.expect(pm.response.headers.get('x-bifrost-provider'), 'native passthrough answered by another provider: ' + pm.response.text().slice(0, 300)).to.eql('anthropic');",
              "    return;",
              "  }",
              "  pm.expect(raw, 'raw request capture missing: ' + pm.response.text()).to.exist;",
              "  pm.expect(raw.thinking, 'thinking dropped: the model runs full adaptive thinking').to.exist;",
              "  pm.expect(raw.thinking.type, 'between_tools was rewritten').to.eql('between_tools');",
              "  pm.expect(raw.thinking, 'between_tools rejects display').to.not.have.property('display');",
              "  pm.expect(raw.output_config, 'output_config dropped').to.exist;",
              "  pm.expect(raw.output_config.effort, 'caller effort must not be lost').to.eql('medium');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{anthropicKey}}"
          },
          {
            "key": "anthropic-version",
            "value": "2023-06-01"
          },
          {
            "key": "x-bf-send-back-raw-request",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"anthropic/claude-sonnet-5-5\",\n  \"max_tokens\": 16,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Reply with the single word: ok\"\n    }\n  ],\n  \"thinking\": {\n    \"type\": \"between_tools\"\n  },\n  \"output_config\": {\n    \"effort\": \"medium\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/anthropic/v1/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "anthropic",
            "v1",
            "messages"
          ]
        }
      }
    },
