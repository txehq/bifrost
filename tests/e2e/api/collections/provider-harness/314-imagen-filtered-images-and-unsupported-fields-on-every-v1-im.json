              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "} else {",
              "  pm.sendRequest({ url: pm.variables.get('providerErrorFixtureUrl') + '/__reset', method: 'POST' }, function () {});",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "pm.test('400 caller_unsupported_parameter naming quality', function () {",
              "  pm.expect(pm.response.code, pm.response.text().slice(0, 400)).to.equal(400);",
              "  pm.expect(j.extra_fields.error_type, pm.response.text().slice(0, 400)).to.equal('caller_unsupported_parameter');",
              "  pm.expect(j.error.param).to.equal('quality');",
              "});",
              "pm.sendRequest({ url: pm.variables.get('providerErrorFixtureUrl') + '/__wire', method: 'GET' }, function (err, res) {",
              "  pm.test('fixture reachable', function () { pm.expect(err, String(err)).to.equal(null); });",
              "  var calls = res.json().data[0].calls.filter(function (c) { return /:predict$/.test(c.path); });",
              "  pm.test('a rejected request makes no upstream call', function () { pm.expect(calls.length, JSON.stringify(calls.map(function (c) { return c.path; }))).to.equal(0); });",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
