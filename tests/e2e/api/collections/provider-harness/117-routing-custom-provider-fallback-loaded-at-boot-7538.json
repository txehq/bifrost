    {
      "name": "openai gpt-4o-mini pinned custom provider fallback created through the routing API - #7538",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var managementToken = pm.environment.get('managementApiKey') || pm.collectionVariables.get('managementApiKey');",
              "var mgmtHeaders = {'Content-Type': 'application/json'};",
              "if (managementToken) { mgmtHeaders.Authorization = 'Bearer ' + managementToken; }",
              "function mgmt(method, path, body, cb) {",
              "  var req = {url: pm.variables.replaceIn('{{baseUrl}}') + path, method: method, header: mgmtHeaders};",
              "  if (body !== null) { req.body = {mode: 'raw', raw: JSON.stringify(body)}; }",
              "  pm.sendRequest(req, cb);",
              "}",
              "var marker = pm.variables.replaceIn('{{$guid}}');",
              "pm.variables.set('customFallbackPinMarker', marker);",
              "pm.variables.unset('customFallbackPinRuleID');",
              "pm.variables.unset('customFallbackPinKeyName');",
              "mgmt('GET', '/api/providers/openai_pc_auto/keys', null, function (err, res) {",
              "  var keys = (!err && res && res.code === 200) ? ((res.json() || {}).keys || []) : [];",
              "  var key = keys.filter(function (k) { return k && k.id; })[0];",
              "  pm.test('custom provider openai_pc_auto has a key to pin', function () {",
              "    pm.expect(err).to.equal(null);",
              "    pm.expect(res.code, res.text()).to.equal(200);",
              "    pm.expect(key, 'no keys on openai_pc_auto: ' + res.text()).to.be.an('object');",
              "  });",
              "  if (!key) { pm.execution.skipRequest(); return; }",
              "  pm.variables.set('customFallbackPinKeyName', key.name);",
              "  var rule = {",
              "    name: 'harness-custom-fallback-pin-' + marker,",
              "    enabled: true,",
              "    scope: 'global',",
              "    priority: Date.now() % 1000000000,",
              "    cel_expression: '\"x-custom-fallback-pin-test\" in headers && headers[\"x-custom-fallback-pin-test\"] == \"' + marker + '\"',",
              "    targets: [{provider: 'openai', model: 'bifrost-harness-nonexistent-primary', weight: 1}],",
              "    fallbacks: [",
              "      {provider: 'openai_pc_auto', model: 'gpt-4o-mini', key_id: '00000000-0000-4000-8000-000000000002'},",
              "      {provider: 'openai_pc_auto', model: 'gpt-4o-mini', key_id: key.id}",
              "    ]",
              "  };",
              "  mgmt('POST', '/api/routing/rules', rule, function (err2, res2) {",
              "    pm.test('routing API accepts pinned custom provider fallbacks', function () {",
              "      pm.expect(err2).to.equal(null);",
              "      pm.expect(res2.code, res2.text()).to.equal(200);",
              "    });",
              "    if (err2 || res2.code !== 200) { pm.execution.skipRequest(); return; }",
              "    pm.variables.set('customFallbackPinRuleID', res2.json().rule.id);",
              "  });",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var managementToken = pm.environment.get('managementApiKey') || pm.collectionVariables.get('managementApiKey');",
              "var mgmtHeaders = {'Content-Type': 'application/json'};",
              "if (managementToken) { mgmtHeaders.Authorization = 'Bearer ' + managementToken; }",
              "function mgmt(method, path, body, cb) {",
              "  var req = {url: pm.variables.replaceIn('{{baseUrl}}') + path, method: method, header: mgmtHeaders};",
              "  if (body !== null) { req.body = {mode: 'raw', raw: JSON.stringify(body)}; }",
              "  pm.sendRequest(req, cb);",
              "}",
              "var ruleID = pm.variables.get('customFallbackPinRuleID');",
              "if (ruleID) {",
              "  mgmt('DELETE', '/api/routing/rules/' + ruleID, null, function (err, res) {",
              "    pm.test('temporary pinned custom fallback rule is removed', function () {",
              "      pm.expect(err).to.equal(null);",
              "      pm.expect(res.code, res.text()).to.be.below(300);",
              "    });",
              "  });",
              "}",
              "pm.test('the missing pinned key is skipped and the next custom fallback serves on its pinned key', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "  pm.expect(pm.response.headers.get('x-bifrost-routing-info-is-fallback'), 'is-fallback header: ' + pm.response.text()).to.equal('true');",
              "  pm.expect(pm.response.headers.get('x-bifrost-fallback-index'), 'fallback-index header: ' + pm.response.text()).to.equal('2');",
              "  pm.expect(pm.response.headers.get('x-bifrost-routing-info-provider'), 'routing provider header: ' + pm.response.text()).to.equal('openai_pc_auto');",
              "  pm.expect(pm.response.headers.get('x-bifrost-routing-info-key'), 'routing key header: ' + pm.response.text()).to.equal(pm.variables.get('customFallbackPinKeyName'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
