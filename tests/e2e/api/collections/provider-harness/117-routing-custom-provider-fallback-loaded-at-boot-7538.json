    {
      "name": "openai routing rule API round-trips standard and custom fallbacks - #7538",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var managementToken = pm.environment.get('managementApiKey') || pm.collectionVariables.get('managementApiKey');",
              "if (managementToken) { pm.request.headers.upsert({key: 'Authorization', value: 'Bearer ' + managementToken}); }",
              "pm.variables.set('fallbackRulePriority', String(800000 + Math.floor(Math.random() * 90000)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var managementToken = pm.environment.get('managementApiKey') || pm.collectionVariables.get('managementApiKey');",
              "var mgmtHeaders = {'Content-Type': 'application/json'};",
              "if (managementToken) { mgmtHeaders.Authorization = 'Bearer ' + managementToken; }",
              "function mgmt(method, path, body, cb) {",
              "  var req = {url: pm.variables.replaceIn('{{baseUrl}}') + path, method: method, header: mgmtHeaders};",
              "  if (body !== null) { req.body = {mode: 'raw', raw: JSON.stringify(body)}; }",
              "  pm.sendRequest(req, cb);",
              "}",
              "var expected = ['openai_pc_auto/gpt-4o-mini', 'openai_pc_auto/', {provider: 'openai_pc_auto', model: 'gpt-4o-mini', key_id: '00000000-0000-4000-8000-000000000003'}, 'anthropic/claude-sonnet-4-6', 'azure/'];",
              "var created = pm.response.code === 200 ? (pm.response.json() || {}).rule : null;",
              "pm.test('create returns every fallback, an unpinned object normalized to its string form', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "  pm.expect(created.fallbacks, pm.response.text()).to.eql(expected);",
              "});",
              "if (!created || !created.id) { return; }",
              "var path = '/api/routing/rules/' + created.id;",
              "mgmt('GET', path, null, function (e1, r1) {",
              "  pm.test('GET returns the same fallbacks', function () {",
              "    pm.expect(r1.code, r1.text()).to.equal(200);",
              "    pm.expect(r1.json().rule.fallbacks, r1.text()).to.eql(expected);",
              "  });",
              "  mgmt('PUT', path, {description: 'harness round trip'}, function (e2, r2) {",
              "    pm.test('PUT without fallbacks keeps them', function () {",
              "      pm.expect(r2.code, r2.text()).to.equal(200);",
              "      pm.expect(r2.json().rule.fallbacks, r2.text()).to.eql(expected);",
              "    });",
              "    mgmt('PUT', path, {fallbacks: []}, function (e3, r3) {",
              "      pm.test('PUT with an empty list clears them', function () {",
              "        pm.expect(r3.code, r3.text()).to.equal(200);",
              "        pm.expect(r3.json().rule.fallbacks, r3.text()).to.equal(undefined);",
              "      });",
              "      mgmt('DELETE', path, null, function (e4, r4) {",
              "        pm.test('temporary round-trip rule is removed', function () {",
              "          pm.expect(e4).to.equal(null);",
              "          pm.expect(r4.code, r4.text()).to.be.below(300);",
              "        });",
              "      });",
              "    });",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"harness-fallback-roundtrip-{{$guid}}\",\n  \"enabled\": false,\n  \"scope\": \"global\",\n  \"priority\": {{fallbackRulePriority}},\n  \"cel_expression\": \"model == \\\"bifrost-harness-never-matches\\\"\",\n  \"targets\": [\n    {\n      \"provider\": \"openai\",\n      \"model\": \"gpt-4o-mini\",\n      \"weight\": 1\n    }\n  ],\n  \"fallbacks\": [\n    \"openai_pc_auto/gpt-4o-mini\",\n    \"openai_pc_auto/\",\n    {\n      \"provider\": \"openai_pc_auto\",\n      \"model\": \"gpt-4o-mini\",\n      \"key_id\": \"00000000-0000-4000-8000-000000000003\"\n    },\n    {\n      \"provider\": \"anthropic\",\n      \"model\": \"claude-sonnet-4-6\"\n    },\n    \"azure/\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/routing/rules",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "routing",
            "rules"
          ]
        }
      }
    },
    {
      "name": "[EXPECT-400] openai routing rule API rejects invalid fallbacks - #7538",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var managementToken = pm.environment.get('managementApiKey') || pm.collectionVariables.get('managementApiKey');",
              "if (managementToken) { pm.request.headers.upsert({key: 'Authorization', value: 'Bearer ' + managementToken}); }",
              "pm.variables.set('fallbackRulePriority', String(800000 + Math.floor(Math.random() * 90000)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var managementToken = pm.environment.get('managementApiKey') || pm.collectionVariables.get('managementApiKey');",
              "var mgmtHeaders = {'Content-Type': 'application/json'};",
              "if (managementToken) { mgmtHeaders.Authorization = 'Bearer ' + managementToken; }",
              "function mgmt(method, path, body, cb) {",
              "  var req = {url: pm.variables.replaceIn('{{baseUrl}}') + path, method: method, header: mgmtHeaders};",
              "  if (body !== null) { req.body = {mode: 'raw', raw: JSON.stringify(body)}; }",
              "  pm.sendRequest(req, cb);",
              "}",
              "function expectRejected(label, code, json) {",
              "  var rule = json && json.rule;",
              "  if (code === 200 && rule && rule.id) { mgmt('DELETE', '/api/routing/rules/' + rule.id, null, function () {}); }",
              "  pm.test(label + ' is rejected with 400', function () {",
              "    pm.expect(code, label + ' got ' + code + ': ' + JSON.stringify(json)).to.equal(400);",
              "  });",
              "}",
              "var parsed = null; try { parsed = pm.response.json(); } catch (e) { parsed = pm.response.text(); }",
              "expectRejected('key_id without a provider', pm.response.code, parsed);",
              "var invalid = [",
              "  {label: 'a bare model', fallbacks: ['gpt-4o-mini']},",
              "  {label: 'a namespace that is not a provider', fallbacks: ['meta-llama/Llama-3.1-8B']},",
              "  {label: 'an empty entry', fallbacks: ['']},",
              "  {label: 'provider_key_name over the API', fallbacks: [{provider: 'openai_pc_auto', provider_key_name: 'OpenAI API Key'}]},",
              "  {label: 'an object naming an unregistered provider', fallbacks: [{provider: 'harness-unregistered-provider', model: 'gpt-4o-mini', key_id: 'k-1'}]},",
              "  {label: 'an object with a blank provider', fallbacks: [{provider: ' ', model: 'gpt-4o-mini'}]}",
              "];",
              "invalid.forEach(function (tc) {",
              "  var rule = {name: 'harness-invalid-fallback-' + pm.variables.replaceIn('{{$guid}}'), enabled: false, scope: 'global', priority: Number(pm.variables.get('fallbackRulePriority')) + 1,",
              "    cel_expression: 'model == \"bifrost-harness-never-matches\"', targets: [{provider: 'openai', weight: 1}], fallbacks: tc.fallbacks};",
              "  mgmt('POST', '/api/routing/rules', rule, function (err, res) {",
              "    var body = null; try { body = res.json(); } catch (e) { body = res && res.text(); }",
              "    expectRejected(tc.label, res && res.code, body);",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"harness-invalid-fallback-{{$guid}}\",\n  \"enabled\": false,\n  \"scope\": \"global\",\n  \"priority\": {{fallbackRulePriority}},\n  \"cel_expression\": \"model == \\\"bifrost-harness-never-matches\\\"\",\n  \"targets\": [\n    {\n      \"provider\": \"openai\",\n      \"weight\": 1\n    }\n  ],\n  \"fallbacks\": [\n    {\n      \"key_id\": \"k-1\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/routing/rules",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "routing",
            "rules"
          ]
        }
      }
    }
  ]
}
