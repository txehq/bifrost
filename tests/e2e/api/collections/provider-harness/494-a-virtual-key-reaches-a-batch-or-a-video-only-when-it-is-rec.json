      "name": "494.13 [EXPECT-404] a request with no virtual key is forwarded for the same batch, and the 404 is the provider's own",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "  return;",
              "}",
              "if (!pm.collectionVariables.get('taskVkOwner') || !pm.collectionVariables.get('taskVkOther')) { pm.execution.skipRequest(); return; }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var txt = pm.response.text() || '';",
              "// With no virtual key the request is forwarded: the answer is the provider's own (the fixture knows no such batch",
              "// by id and says so), not the gateway's access_blocked refusal.",
              "pm.test('the provider answers 404 for an id it does not serve', function () { pm.expect(pm.response.code, 'failed: ' + txt.slice(0, 400)).to.eql(404); });",
              "pm.test('the answer is the provider\\u2019s, not a gateway refusal', function () {",
              "  var body = {}; try { body = pm.response.json() || {}; } catch (e) { body = {}; }",
              "  pm.expect(body.type, txt.slice(0, 400)).to.not.eql('access_blocked');",
              "  pm.expect(txt, txt.slice(0, 400)).to.include('no storage fixture batch');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/batches/batch_storage_made_elsewhere?provider=storage_uri_files"
      }
