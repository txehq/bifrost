              "  pm.expect(body.error && body.error.message, txt.slice(0, 400)).to.be.a('string');",
              "  pm.expect(body.error.message, txt.slice(0, 400)).to.include(pm.collectionVariables.get('taskBatchId')).and.to.include('not found');",
