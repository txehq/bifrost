    {
      "name": "Bedrock /v1/messages - safeguards forwarded with automatic beta (global.anthropic.claude-opus-4-8) - safeguards",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('safeguards forwarded with the required beta', function () {",
              "  pm.expect(pm.response.code, 'expected 200 for a valid safeguards array: ' + pm.response.text()).to.equal(200);",
              "  var body = pm.response.json();",
              "  pm.expect(body.extra_fields, 'raw request capture missing: ' + pm.response.text()).to.exist;",
              "  var raw = body.extra_fields.raw_request;",
              "  if (typeof raw === 'string') { raw = JSON.parse(raw); }",
              "  pm.expect(raw.safeguards, 'outbound safeguards missing or reshaped: ' + JSON.stringify(raw)).to.be.an('array');",
              "  pm.expect(raw.safeguards[0].type, 'outbound safeguards entry reshaped: ' + JSON.stringify(raw.safeguards)).to.equal('dangerous_tool_use');",
              "  // Bedrock InvokeModel and Vertex rawPredict carry betas in the body. Azure and Mantle send the",
              "  // anthropic-beta header instead; there a 200 on the recognized safeguards field is the proof,",
              "  // because without dangerous-tool-use the provider answers 400 'Extra inputs are not permitted'.",
              "  if (raw.anthropic_version) {",
              "    pm.expect(raw.anthropic_beta, 'required body beta missing: ' + JSON.stringify(raw)).to.include('dangerous-tool-use-2026-09-03');",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
