              "  var raw = body.extra_fields.raw_request;",
              "  if (typeof raw === 'string') { raw = JSON.parse(raw); }",
              "  // Vertex rawPredict carries betas in the body, so a dropped header shows up as a missing value here.",
              "  pm.expect(raw.anthropic_beta, 'anthropic_beta missing from the outbound body, so the client beta never reached Bifrost: ' + JSON.stringify(raw)).to.be.an('array');",
              "  pm.expect(raw.anthropic_beta, 'auto-mode-classifier beta dropped: ' + JSON.stringify(raw)).to.include('auto-mode-classifier-2026-07-16');",
