      "name": "[SKIP] [NATIVE-PASSTHROUGH] Anthropic /v1/messages - safeguards stripped for a model outside the auto-mode set (claude-haiku-4-5) - safeguards",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('safeguards is stripped fail-closed from the outbound request', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.be.below(400);",
              "  var body = pm.response.json();",
              "  pm.expect(body.extra_fields, 'extra_fields missing - raw request capture not enabled: ' + pm.response.text()).to.exist;",
              "  var rawReq = JSON.stringify(body.extra_fields.raw_request);",
              "  pm.expect(rawReq, 'haiku is outside the Sonnet 5 / Opus 4.7+ / Fable auto-mode set, so SupportsSafeguards strips it rather than 400 the real request: ' + rawReq).to.not.include('\"safeguards\"');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
