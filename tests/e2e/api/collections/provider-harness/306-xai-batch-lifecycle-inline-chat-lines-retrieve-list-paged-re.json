          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('results are a page of per-line results in OpenAI shape', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.batch_id).to.eql(pm.collectionVariables.get('xaiBatchId'));",
              "  pm.expect(j.results, 'results: ' + pm.response.text()).to.be.an('array');",
              "  pm.expect(j.results.length, 'limit=1: ' + pm.response.text()).to.be.at.most(1);",
              "  if (j.has_more) { pm.expect(j.next_cursor, 'has_more without next_cursor: ' + pm.response.text()).to.be.a('string').that.is.not.empty; }",
              "  j.results.forEach(function (r) {",
              "    pm.expect(['line-1', 'line-2'], 'custom_id: ' + JSON.stringify(r)).to.include(r.custom_id);",
              "    pm.expect(['succeeded', 'failed', 'expired', 'cancelled'], 'status: ' + JSON.stringify(r)).to.include(r.status);",
              "    if (r.status !== 'succeeded') { pm.expect(r.error, 'a failed line carries the vendor error: ' + JSON.stringify(r)).to.be.an('object'); return; }",
              "    var body = (r.response || {}).body || {};",
              "    pm.expect(body.choices, 'response.body.choices: ' + JSON.stringify(r)).to.be.an('array').that.is.not.empty;",
              "    var u = body.usage || {};",
              "    pm.expect(u.prompt_tokens, 'usage.prompt_tokens: ' + JSON.stringify(r)).to.be.a('number');",
              "    pm.expect(u.completion_tokens, 'usage.completion_tokens: ' + JSON.stringify(r)).to.be.a('number');",
              "    pm.expect((u.vendor_cost || {}).unit, 'usage.vendor_cost: ' + JSON.stringify(r)).to.eql('usd_ticks');",
              "    pm.expect(u.vendor_cost.amount, 'vendor_cost equals cost_in_usd_ticks: ' + JSON.stringify(r)).to.eql(u.cost_in_usd_ticks);",
              "  });",
              "});"
            ]
          }
        }
