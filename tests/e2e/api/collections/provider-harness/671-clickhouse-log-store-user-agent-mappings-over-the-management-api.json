          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('671.3 the list read back from ClickHouse holds the mapping as created', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  const m = pm.response.json().mappings.find((x) => x.id === pm.collectionVariables.get('ch_ua_id'));",
              "  pm.expect(m, pm.response.text()).to.be.an('object');",
              "  pm.expect(m.app, pm.response.text()).to.equal('TXE-6085 CH CLI');",
              "  pm.expect(m.match_type, pm.response.text()).to.equal('prefix');",
              "  pm.expect(m.is_active, pm.response.text()).to.equal(true);",
              "});"
            ]
          }
        }
      ]
    },
