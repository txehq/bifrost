    {
      "name": "[EXPECT-200] openai code-mode-limits raised max_steps applies",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 2000000 iterations exceed the default budget of 1000000 steps; the loop body allocates nothing.",
              "pm.test('code-mode-limits raised max_steps applies', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  pm.expect(pm.response.json().is_error, pm.response.text()).to.not.equal(true);",
              "  pm.expect(pm.response.json().content, pm.response.text()).to.include('done');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/mcp/tool/execute",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "mcp",
            "tool",
            "execute"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"code-mode-limits-raised-steps\",\n  \"type\": \"function\",\n  \"function\": {\n    \"name\": \"executeToolCode\",\n    \"arguments\": \"{\\\"code\\\": \\\"for i in range(2000000):\\\\n    pass\\\\nresult = 'done'\\\"}\"\n  }\n}"
        }
      }
    },
