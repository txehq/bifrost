{
  "name": "Code mode configurable limits (code-mode-limits) [SERIAL]",
  "description": "Code mode limits set through PUT /api/config (client_config.mcp_code_mode_limits) persist and hot-reload: lowering max_steps makes a small loop fail, raising it lets a loop that exceeds the default pass, and an out-of-range limit is refused with 400 without changing state. The folder reads the stored limits first and restores them last; an interrupted run can leave the lowered limits in place. Local computations only; the openai keyword is a harness filter label and no provider calls are made.",
  "item": [
    {
      "name": "[EXPECT-200] openai code-mode-limits read current config",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('code-mode-limits read current config', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  var cc = pm.response.json().client_config;",
              "  pm.expect(cc, pm.response.text()).to.be.an('object');",
              "  pm.collectionVariables.set('codeModeLimitsClientConfig', JSON.stringify(cc));",
              "  pm.collectionVariables.set('codeModeLimitsOriginal', JSON.stringify(cc.mcp_code_mode_limits || {}));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/config?from_db=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ],
          "query": [
            {
              "key": "from_db",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "[EXPECT-200] openai code-mode-limits lower max_steps",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var cc = JSON.parse(pm.collectionVariables.get('codeModeLimitsClientConfig'));",
              "cc.mcp_code_mode_limits = { max_steps: 1000 };",
              "pm.variables.set('codeModeLimitsBody', JSON.stringify({ client_config: cc }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('code-mode-limits lower max_steps', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{codeModeLimitsBody}}"
        }
      }
    },
    {
      "name": "[EXPECT-200] openai code-mode-limits lowered max_steps persists",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('code-mode-limits lowered max_steps persists', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  var limits = pm.response.json().client_config.mcp_code_mode_limits || {};",
              "  pm.expect(limits.max_steps, pm.response.text()).to.equal(1000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/config?from_db=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ],
          "query": [
            {
              "key": "from_db",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "[EXPECT-200] openai code-mode-limits lowered max_steps applies",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 5000 iterations fit the default budget of 1000000 steps but not a budget of 1000.",
              "pm.test('code-mode-limits lowered max_steps applies', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  pm.expect(pm.response.text()).to.include('step');",
              "  pm.expect(pm.response.json().is_error, pm.response.text()).to.equal(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/mcp/tool/execute",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "mcp",
            "tool",
            "execute"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"code-mode-limits-lowered-steps\",\n  \"type\": \"function\",\n  \"function\": {\n    \"name\": \"executeToolCode\",\n    \"arguments\": \"{\\\"code\\\": \\\"for i in range(5000):\\\\n    pass\\\"}\"\n  }\n}"
        }
      }
    },
