              "pm.test('batch-results-bound: max_response_body_size_mb is back to what it was', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  var cc = pm.response.json().client_config || {};",
              "  pm.expect(String(cc.max_response_body_size_mb || 0), pm.response.text()).to.equal(pm.collectionVariables.get('brbOriginal') || '0');",
              "});"
