              "pm.test('batch-results-bound: limit=10 returns rb-0 to rb-9 and more to come', function () {",
              "  pm.expect(pm.response.code, text.slice(0, 2000)).to.equal(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.results.map(function (r) { return r.custom_id; }).join(','), text.slice(0, 500)).to.equal('rb-0,rb-1,rb-2,rb-3,rb-4,rb-5,rb-6,rb-7,rb-8,rb-9');",
              "  pm.expect(j.has_more, 'has_more').to.equal(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/batches/batch_results_bound/results?provider=openai&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "batches",
            "batch_results_bound",
            "results"
          ],
          "query": [
            {
              "key": "provider",
              "value": "openai"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
