      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function bifrostUsage() {",
              "  var raw = pm.response.headers.get('x-bifrost-usage');",
              "  pm.expect(raw, 'no x-bifrost-usage header; headers: ' + JSON.stringify(pm.response.headers.toObject())).to.be.a('string').and.not.empty;",
              "  return JSON.parse(raw);",
              "}",
              "pm.test('PCM body labeled audio/L16 with Gemini usage in the header', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  pm.expect(pm.response.headers.get('Content-Type'), 'content type').to.match(/^audio\\/L16/i);",
              "  pm.expect(pm.response.stream.length, 'audio too small').to.be.above(2000);",
              "  var usage = bifrostUsage();",
              "  pm.expect(usage.input_tokens, 'input_tokens: ' + JSON.stringify(usage)).to.be.above(0);",
              "  pm.expect(usage.output_tokens, 'output_tokens: ' + JSON.stringify(usage)).to.be.above(0);",
              "});"
            ]
          }
        }
