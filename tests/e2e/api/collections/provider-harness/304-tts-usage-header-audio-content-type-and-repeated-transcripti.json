      "name": "/v1/audio/speech - flac labeled audio/flac, ElevenLabs-only language_code not sent, no invented tokens - openai/gpt-4o-mini-tts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function bifrostUsage() {",
              "  var raw = pm.response.headers.get('x-bifrost-usage');",
              "  pm.expect(raw, 'no x-bifrost-usage header; headers: ' + JSON.stringify(pm.response.headers.toObject())).to.be.a('string').and.not.empty;",
              "  return JSON.parse(raw);",
              "}",
              "pm.test('flac body, OpenAI Content-Type, no token counts OpenAI did not report', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  pm.expect(pm.response.headers.get('Content-Type'), 'content type').to.eql('audio/flac');",
              "  var bytes = pm.response.stream;",
              "  pm.expect(String.fromCharCode(bytes[0], bytes[1], bytes[2], bytes[3]), 'body is not FLAC').to.eql('fLaC');",
              "  var usage = bifrostUsage();",
              "  pm.expect(usage.input_tokens || 0, 'invented input_tokens: ' + JSON.stringify(usage)).to.eql(0);",
              "  pm.expect(usage.output_tokens || 0, 'invented output_tokens: ' + JSON.stringify(usage)).to.eql(0);",
              "  pm.expect(usage.billed_characters, 'invented billed_characters: ' + JSON.stringify(usage)).to.be.undefined;",
              "});"
            ]
          }
        }
      ],
