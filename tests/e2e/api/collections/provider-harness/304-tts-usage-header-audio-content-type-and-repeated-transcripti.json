      "name": "/v1/audio/transcriptions - include[] form field reaches OpenAI, logprobs come back - openai/gpt-4o-mini-transcribe",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('include[]=logprobs reached the vendor', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
