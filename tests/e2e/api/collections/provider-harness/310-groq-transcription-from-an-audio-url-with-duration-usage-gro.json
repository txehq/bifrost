    {
      "name": "[EXPECT-400] /v1/audio/transcriptions - url without file is refused for a provider that takes only a file - openai/whisper-1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('url-only transcription to openai is caller_unsupported_parameter on url', function () {",
              "  pm.expect(pm.response.code, 'expected 400: ' + pm.response.text()).to.eql(400);",
              "  var j = pm.response.json();",
              "  pm.expect((j.extra_fields || {}).error_type, 'error_type: ' + pm.response.text()).to.eql('caller_unsupported_parameter');",
              "  pm.expect((j.error || {}).param, 'error.param: ' + pm.response.text()).to.eql('url');",
              "  pm.expect((j.extra_fields || {}).provider, 'refused for: ' + pm.response.text()).to.eql('openai');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "model",
              "value": "openai/whisper-1",
