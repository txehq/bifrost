          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the stored secret never comes back in plaintext', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  pm.expect(pm.response.text()).to.not.include('bfl-fixture-webhook-secret');",
              "  var keys = pm.response.json().keys || [];",
              "  var key = keys.filter(function (k) { return k.bfl_key_config; })[0];",
              "  pm.expect(key, pm.response.text()).to.be.ok;",
              "  pm.expect(key.bfl_key_config.webhook_secret, pm.response.text()).to.be.ok;",
              "});"
            ]
          }
        }
      ]
