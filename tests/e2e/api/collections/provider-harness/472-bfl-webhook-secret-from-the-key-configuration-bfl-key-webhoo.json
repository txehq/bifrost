{
  "name": "472. BFL webhook_secret from the key configuration (bfl key webhook secret)",
  "description": "Pins TXE-7062 (BFL vendor sheet B5, the key-configuration half): a bfl key's bfl_key_config.webhook_secret is sent as BFL's webhook_secret on an image task create that carries callback_url and none of its own. Local fixture regression, no live provider calls: start tests/e2e/api/runners/provider-error-fixture.mjs, start an isolated gateway on tests/e2e/api/provider_config/provider-error-fixture.config.json and run with providerErrorFixture=1; every case is skipped otherwise. The fixture config's bfl key carries webhook_secret bfl-fixture-webhook-secret. Rows 2 and 3: a create with callback_url sends the key's secret beside webhook_url. Rows 4 and 5: a webhook_secret on the request wins. Rows 6 and 7: without callback_url no secret is sent. Row 8: the management API returns the key with the secret redacted. Before the change no key configuration existed and rows 3 and 8 failed. Encryption at rest and the redacted update merge are pinned by the framework/configstore/tables and transports handler Go tests.",
  "item": [
    {
      "name": "472.1 reset the fixture's counters (bfl key webhook secret)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8791/__reset",
          "host": [
            "http://127.0.0.1:8791"
          ],
          "path": [
            "__reset"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the fixture reset its counters', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "472.2 bfl/flux-pro-1.1 create with callback_url and no webhook_secret (bfl key webhook secret)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/images/generations/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "images",
            "generations",
            "tasks"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"bfl/flux-pro-1.1\",\n  \"prompt\": \"a red fox\",\n  \"callback_url\": \"https://hooks.example.test/v/task_472\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the task is created', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  pm.expect(pm.response.json().object).to.eql('image.task');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "472.3 BFL received the key's webhook_secret beside webhook_url (bfl key webhook secret)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8791/__wire",
          "host": [
            "http://127.0.0.1:8791"
          ],
          "path": [
            "__wire"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the key secret signs the callback', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var calls = pm.response.json().data[0].calls.filter(function (c) { return c.path.indexOf('/pp/bfl/') === 0; });",
              "  pm.expect(calls.length, JSON.stringify(calls)).to.be.above(0);",
              "  var sent = JSON.parse(calls[calls.length - 1].body);",
              "  pm.expect(sent.webhook_url).to.eql('https://hooks.example.test/v/task_472');",
              "  pm.expect(sent.webhook_secret).to.eql('bfl-fixture-webhook-secret');",
              "});"
            ]
          }
        }
      ]
    },
