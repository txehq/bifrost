    {
      "name": "62.13a Azure: wait until the uploaded file is processed (files-routes)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Azure processes uploads asynchronously: the file object reports status",
              "// \"pending\" -> \"running\" -> \"processed\", and the content route answers",
              "// 204 (surfaced by bifrost as 409) until it is processed. The content rows",
              "// below (62.14-62.16) need a processed file, so re-run this row until it is.",
              "// Docs: https://learn.microsoft.com/en-us/rest/api/azureopenai/files/get-content?view=rest-azureopenai-2024-10-21",
              "if ([401, 403, 429, 500, 502, 503, 504].indexOf(pm.response.code) !== -1) { return; }",
              "var j = {};",
              "try { j = pm.response.json() || {}; } catch (e) {}",
              "var tries = Number(pm.collectionVariables.get('filesAzurePollTries') || 0);",
              "if (j.status !== 'processed' && j.status !== 'error' && tries < 30) {",
              "  pm.collectionVariables.set('filesAzurePollTries', tries + 1);",
              "  // The pending timer holds the sandbox open, which delays the next request.",
              "  setTimeout(function () {}, 2000);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "pm.collectionVariables.unset('filesAzurePollTries');",
              "pm.test('Azure upload: reached status processed', function () { pm.expect(j.status, JSON.stringify(j)).to.eql('processed'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/files/{{filesAzureId}}?provider=azure",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "files",
            "{{filesAzureId}}"
          ],
          "query": [
            {
              "key": "provider",
              "value": "azure"
            }
          ]
        }
      }
    },
    {
      "name": "62.14 Azure: /anthropic content route returns real bytes (files-routes)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Azure can still be processing the upload here (bifrost surfaces that as a",
              "// 409 whose body says to poll until status is \"processed\"; see 62.13a).",
              "// Provider-side processing lag is not a routing defect, so poll the same route",
              "// until it stops answering 409 and let the asserted request below run once:",
              "// re-running the row itself would leave each 409 attempt recorded as a failure.",
              "var url = pm.variables.replaceIn(pm.request.url.toString());",
              "var header = [];",
              "pm.request.headers.each(function (h) { if (!h.disabled) { header.push({ key: h.key, value: pm.variables.replaceIn(h.value) }); } });",
              "(function poll(attempt) {",
              "  pm.sendRequest({ url: url, method: 'GET', header: header }, function (err, res) {",
              "    if (!err && res && res.code === 409 && attempt < 10) { setTimeout(function () { poll(attempt + 1); }, 2000); }",
              "  });",
              "})(0);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Azure via /anthropic: 200', function () { pm.expect(pm.response.code, pm.response.text().slice(0, 200)).to.eql(200); });",
              "pm.test('Azure via /anthropic: body is a PDF', function () { pm.expect((pm.response.text() || '').indexOf('%PDF')).to.eql(0); });",
              "pm.test('Azure via /anthropic: not JSON', function () { pm.expect((pm.response.headers.get('Content-Type') || '')).to.not.include('json'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{anthropicKey}}"
          },
          {
            "key": "anthropic-version",
            "value": "2023-06-01"
          },
          {
            "key": "anthropic-beta",
            "value": "files-api-2025-04-14"
          },
          {
            "key": "x-model-provider",
            "value": "azure"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/anthropic/v1/files/{{filesAzureId}}/content",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "anthropic",
            "v1",
            "files",
            "{{filesAzureId}}",
            "content"
          ]
