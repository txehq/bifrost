          "raw": "{\n  \"model\": \"xai/grok-4.5\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"hi\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('usage carries the per-tool call counts xAI reported', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var u = pm.response.json().usage;",
              "  pm.expect(u.server_side_tool_usage_details, JSON.stringify(u)).to.eql({ web_search_calls: 2, x_search_calls: 1, code_interpreter_calls: 0, file_search_calls: 0, mcp_calls: 0, document_search_calls: 0 });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "443.3 xai/grok-4.5 POST /v1/chat/completions streamed: the final frame carries the same server_side_tool_usage_details (xai chat contract)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"xai/grok-4.5\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"hi\"\n    }\n  ],\n  \"stream\": true,\n  \"stream_options\": {\n    \"include_usage\": true\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var frames = pm.response.text().split('\\n\\n').filter(function (f) { return f.indexOf('data: {') === 0; }).map(function (f) { return JSON.parse(f.slice(6)); });",
              "var withUsage = frames.filter(function (f) { return f.usage; });",
              "pm.test('the last usage frame of the stream carries the counts of the non-streamed answer', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  pm.expect(withUsage.length, pm.response.text()).to.be.above(0);",
              "  pm.expect(withUsage[withUsage.length - 1].usage.server_side_tool_usage_details, pm.response.text()).to.eql({ web_search_calls: 2, x_search_calls: 1, code_interpreter_calls: 0, file_search_calls: 0, mcp_calls: 0, document_search_calls: 0 });",
              "});"
            ]
          }
        }
      ]
    },
