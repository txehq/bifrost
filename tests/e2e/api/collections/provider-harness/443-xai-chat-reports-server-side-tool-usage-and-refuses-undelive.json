    {
      "name": "443.13 xai chat and Responses on the wire: max_turns reached /v1/responses and no refused request reached xAI (xai chat contract)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://127.0.0.1:8791/__wire"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var calls = pm.response.json().data[0].calls;",
              "function on(path) { return calls.filter(function (c) { return c.path === path; }).map(function (c) { return JSON.parse(c.body); }); }",
              "pm.test('max_turns reached /v1/responses unchanged, streamed and not', function () {",
              "  var responses = on('/pp/xai/v1/responses');",
              "  pm.expect(responses.map(function (b) { return b.max_turns; }), JSON.stringify(responses)).to.eql([3, 5, 7]);",
              "  responses.forEach(function (b) { pm.expect(b, JSON.stringify(b)).to.not.have.property('extra_params'); });",
              "});",
              "pm.test('three chat requests reached xAI; the four refused ones made no call and none carried a prompt cache field', function () {",
              "  var chats = on('/pp/xai/v1/chat/completions');",
              "  pm.expect(chats.length, JSON.stringify(chats)).to.eql(3);",
              "  chats.forEach(function (b) { pm.expect(b, JSON.stringify(b)).to.not.have.any.keys('prompt_cache_key', 'prompt_cache_retention', 'prompt_cache_options'); });",
              "});",
              "pm.test('the refused batch made no call to xAI', function () {",
              "  var batches = calls.filter(function (c) { return /\\/batches/.test(c.path); });",
              "  pm.expect(batches.length, JSON.stringify(batches)).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
