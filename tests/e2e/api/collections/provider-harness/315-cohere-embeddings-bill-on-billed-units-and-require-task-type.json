          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-api-key",
            "value": "Cohere API Key"
          },
          {
            "key": "x-bf-send-back-raw-request",
            "value": "true"
          },
          {
            "key": "x-bf-send-back-raw-response",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"cohere/embed-v4.0\",\n  \"input\": \"alpha kestrel harbor\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/embeddings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "embeddings"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 caller_unsupported_parameter on task_type', function () {",
              "  pm.expect(pm.response.code, 'body: ' + pm.response.text().slice(0, 400)).to.eql(400);",
              "  var j = pm.response.json(); var ef = j.extra_fields || {};",
              "  pm.expect(ef.error_type).to.eql('caller_unsupported_parameter');",
              "  pm.expect((j.error || {}).param).to.eql('task_type');",
              "  pm.expect(!!j.is_bifrost_error, 'the caller is at fault, not Bifrost').to.be.false;",
              "});",
              "pm.test('Cohere was never called', function () {",
              "  var ef = pm.response.json().extra_fields || {};",
              "  pm.expect(ef.raw_response, 'an upstream response came back').to.be.undefined;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "315.3 cohere/embed-v4.0 - image input bills image_tokens and input_images from billed_units",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-api-key",
            "value": "Cohere API Key"
          },
          {
            "key": "x-bf-send-back-raw-request",
            "value": "true"
          },
          {
            "key": "x-bf-send-back-raw-response",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"cohere/embed-v4.0\",\n  \"input\": [\n    [\n      {\n        \"type\": \"image\",\n        \"image\": {\n          \"data\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACAAAAAgCAIAAAD8GO2jAAAAOklEQVR4nO3RQREAQAjDwHKS8C8AWSchfPhlBZSZUNOdS+90PR5Y8AfIRMhEyETIRMhEyETIRMhEIR/EvwFs/VkrpgAAAABJRU5ErkJggg==\"\n        }\n      }\n    ]\n  ],\n  \"task_type\": \"search_document\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/embeddings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "embeddings"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function asObj(v) { if (typeof v === 'string') { try { return JSON.parse(v); } catch (e) { return null; } } return v || null; }",
              "pm.test('200 with one vector', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "  pm.expect((pm.response.json().data || []).length).to.eql(1);",
              "});",
              "var j = pm.response.json(); var ef = j.extra_fields || {};",
              "var billed = ((asObj(ef.raw_response) || {}).meta || {}).billed_units || {};",
              "pm.test('image counters come from billed_units', function () {",
              "  pm.expect(billed.image_tokens, 'Cohere reported no billed image_tokens: ' + JSON.stringify(billed)).to.be.above(0);",
              "  pm.expect((j.usage.prompt_tokens_details || {}).image_tokens).to.eql(billed.image_tokens);",
              "  pm.expect(j.usage.prompt_tokens || 0).to.eql(billed.input_tokens || 0);",
              "});",
              "pm.test('input_images is the billed image count, and only that', function () {",
              "  if (billed.images === undefined) { pm.expect(j.usage, 'Bifrost filled an image count Cohere did not report').to.not.have.property('input_images'); return; }",
              "  pm.expect(j.usage.input_images).to.eql(billed.images);",
              "});"
            ]
          }
        }
      ]
    },
