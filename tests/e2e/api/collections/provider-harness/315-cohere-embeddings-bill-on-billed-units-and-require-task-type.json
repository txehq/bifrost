              "  pm.expect(((pm.response.json().embeddings || {}).float || []).length).to.eql(1);",
              "});",
              "pm.test('meta.billed_units is the one Cohere sent', function () {",
              "  var billed = (pm.response.json().meta || {}).billed_units || {};",
              "  pm.expect(billed.input_tokens, 'no billed input_tokens: ' + JSON.stringify(pm.response.json().meta)).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
