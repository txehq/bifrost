      "name": "266.17 a2a push tenancy stream: an oversized JSON reply to SendStreamingMessage fails closed, never a truncated stream",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "text/event-stream"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"SendStreamingMessage\", \"params\": {\"message\": {\"messageId\": \"m-stream\", \"role\": \"ROLE_USER\", \"parts\": [{\"text\": \"oversized-json-reply\"}]}}}"
        },
        "url": "{{baseUrl}}/agents/a2a/{{a2aPushAgent}}/json-rpc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.expect(pm.response.code, pm.response.text()).to.equal(200); });",
              "pm.test(\"a reply larger than the reframing buffer surfaces as an error event, not a truncated stream\", function () {",
              "  pm.expect(pm.response.text().trim(), 'empty stream: ' + pm.response.text()).to.not.equal('');",
              "  pm.expect(pm.response.text(), pm.response.text().slice(0, 400)).to.include('\"error\"');",
              "  pm.expect(pm.response.text(), 'the oversized body was passed through').not.to.include('fixture-oversized');",
              "});"
            ]
          }
        }
      ]
    },
