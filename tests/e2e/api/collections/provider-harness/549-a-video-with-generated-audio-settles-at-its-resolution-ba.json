    {
      "name": "549.5 dashscope GET /v1/videos/{id} reports ds-audio-on completed, so the job is due for settlement (video audio rate)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/videos/{{audioRateOnId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos",
            "{{audioRateOnId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the retrieve reports the task completed', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
