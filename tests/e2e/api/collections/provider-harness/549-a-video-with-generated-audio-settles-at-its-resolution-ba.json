{
  "name": "549. A video with generated audio settles at its resolution band's audio rate, and audio false at the silent rate (video audio rate) [SERIAL]",
  "item": [
    {
      "name": "549.1 the fixture gateway runs with provider job accounting off; its client config is kept to restore at the end (video audio rate)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Bifrost-Setup-Token",
            "value": "bifrost-e2e-setup-token"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('audioRateClientConfig');",
              "pm.collectionVariables.unset('audioRateOnId');",
              "pm.collectionVariables.unset('audioRateOffId');",
              "pm.collectionVariables.unset('audioRateRetry');",
              "pm.test('accounting reads back off', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.client_config && j.client_config.disable_provider_job_accounting, pm.response.text().slice(0, 400)).to.equal(true);",
              "});",
              "var cc = pm.response.code === 200 ? pm.response.json().client_config : null;",
              "if (cc) { pm.collectionVariables.set('audioRateClientConfig', JSON.stringify(cc)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "549.2 [EXPECT-200] turn provider job accounting on, which starts the video sweeper (video audio rate)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Bifrost-Setup-Token",
            "value": "bifrost-e2e-setup-token"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{audioRateOnBody}}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var saved = pm.collectionVariables.get('audioRateClientConfig');",
              "if (!saved) {",
              "  // 549.1 kept no config: leave the switch alone rather than write a partial one.",
              "  pm.execution.skipRequest();",
              "} else {",
              "  var cc = JSON.parse(saved);",
              "  cc.disable_provider_job_accounting = false;",
              "  pm.variables.set('audioRateOnBody', JSON.stringify({ client_config: cc }));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('accounting turned on', function () {",
              "  pm.expect(pm.response.code, pm.response.text().slice(0, 400)).to.eql(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
