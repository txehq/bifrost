              "var body = {}; try { body = pm.response.json() || {}; } catch (e) { body = {}; }",
              "var want = [];",
              "var got = (body.storage_folders || []).map(function (c) { return { folder: c.folder, virtual_key_id: c.virtual_key_id }; });",
              "pm.test('nothing is claimed in that bucket', function () { pm.expect(got, txt.slice(0, 600)).to.eql(want); pm.expect(body.total_count, txt.slice(0, 400)).to.eql(want.length); });"
