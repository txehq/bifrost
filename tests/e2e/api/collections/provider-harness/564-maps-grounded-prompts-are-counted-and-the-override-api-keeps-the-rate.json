              "pm.test('VK deleted', function () {",
              "  pm.expect(pm.response.code, 'body: ' + pm.response.text()).to.be.within(200, 299);",
              "});",
              "pm.collectionVariables.unset('mapsRatesVkId');"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/governance/virtual-keys/{{mapsRatesVkId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "governance",
            "virtual-keys",
            "{{mapsRatesVkId}}"
          ]
        }
      }
    }
  ]
}
