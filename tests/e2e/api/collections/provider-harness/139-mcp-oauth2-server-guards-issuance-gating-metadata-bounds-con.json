        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Bifrost-Temp-Token",
            "value": "{{mcpOauth2ServerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/oauth2/consent/flows/{{mcpOauth2ServerFlow}}",
        "body": {
          "mode": "raw",
          "raw": "{\"mode\": \"vk\", \"value\": \"sk-bf-test-key-nocontent\"}"
        }
      }
    },
    {
      "name": "[EXPECT-200] discovery document pins the configured issuer and is not cacheable - mcp oauth2 server",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('discovery exact response status - mcp oauth2 server', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "});",
              "pm.test('issuer is the configured value, not the request host, and the document is no-store - mcp oauth2 server', function () {",
              "  var body = pm.response.json();",
              "  pm.expect(body.issuer).to.be.a('string').and.not.empty;",
              "  pm.expect(body.issuer).not.to.include('evil.example');",
              "  pm.expect(body.token_endpoint).not.to.include('evil.example');",
              "  pm.expect(body.jwks_uri).not.to.include('evil.example');",
              "  pm.expect((pm.response.headers.get('Cache-Control') || '').toLowerCase()).to.include('no-store');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "evil.example"
          }
        ],
        "url": "{{baseUrl}}/.well-known/oauth-authorization-server"
      }
    }
  ]
}
