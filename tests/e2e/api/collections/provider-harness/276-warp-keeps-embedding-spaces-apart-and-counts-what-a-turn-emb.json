        "url": "{{baseUrl}}/api/warp/config",
        "body": {
          "mode": "raw",
          "raw": "{\"enabled\": true, \"provider\": \"openai\", \"model\": \"wire-chat\", \"max_iterations\": 8, \"request_timeout_seconds\": 60, \"history_retention_days\": 30, \"embedding_provider\": \"openai\", \"embedding_model\": \"wire-embed\", \"embedding_dimension\": 8, \"log_vector_store_namespace\": \"{{warpPresA}}\", \"semantic_search_threshold\": 0.1, \"semantic_search_limit\": 10}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
