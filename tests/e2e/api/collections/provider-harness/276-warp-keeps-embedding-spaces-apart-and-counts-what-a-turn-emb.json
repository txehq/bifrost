    {
      "name": "a turn's usage counts each search embedding once - warp-preservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/warp/chat",
        "body": {
          "mode": "raw",
          "raw": "{\"messages\": [{\"role\": \"user\", \"content\": \"why did payments fail? [case:{{warpPresKey}}]\"}], \"stream\": false, \"timezone\": \"UTC\", \"utc_offset_minutes\": 0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('warpWire') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var key = pm.variables.get('warpPresA').toLowerCase();",
              "pm.collectionVariables.set('warpPresKey', key);",
              "pm.sendRequest({ url: pm.variables.get('warpWireFixtureUrl') + '/__script', method: 'POST', body: JSON.stringify({ key: key, steps: [",
              "  { tool: 'semantic_search_logs', args: { queries: ['declined cards [case:' + key + ']', 'failed payments [case:' + key + ']'], filters: {} } },",
              "  { text: 'none found.' },",
              "] }) }, function (err, res) {",
              "  pm.test('warp-preservation setup: the model is scripted', function () {",
              "    pm.expect(err, String(err)).to.equal(null);",
              "    pm.expect(res.code).to.equal(200);",
              "  });",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var body = pm.response.json();",
              "pm.test('warp-preservation: two model calls and two embeddings are reported', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "  pm.expect(body.usage.total_tokens, pm.response.text()).to.equal(234);",
              "});"
            ]
          }
        }
      ]
