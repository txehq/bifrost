            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('an untrusted host gets no key secret', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var calls = pm.response.json().data[0].calls.filter(function (c) { return c.path.indexOf('/pp/bfl/') === 0; });",
              "  pm.expect(calls.length, JSON.stringify(calls)).to.be.above(0);",
              "  var sent = JSON.parse(calls[calls.length - 1].body);",
              "  pm.expect(sent.webhook_url).to.eql('https://attacker.example.test/v/task_7310');",
              "  pm.expect(sent, JSON.stringify(sent)).to.not.have.property('webhook_secret');",
              "});"
            ]
          }
        }
      ]
    },
