{
  "name": "599. VolcEngine and ModelArk video jobs settle at the video tokens Ark billed (ark video settlement)",
  "description": "Local fixture regression for TXE-7131, no live provider calls. fixture-folders.mjs's video-settlement group starts tests/e2e/api/runners/provider-error-fixture.mjs and a gateway on tests/e2e/api/provider_config/video-settlement.config.json, with provider job accounting and request logging on (provider-error-fixture.config.json turns accounting off, and folder 329 pins that). Its volcengine and modelark providers sit on the fixture's Ark task route (/pp/ovr/<base>/contents/generations/tasks), and the fixture's pricing sheet prices doubao-seedance-1-0-pro-250528 on both at $0.00001 a video token. Run with videoSettlementFixture=1 and videoSettlementFixtureUrl; every case is skipped otherwise. For each provider: a create asking for 5 seconds is a queued Ark task; the query reads Ark's succeeded task as completed, 1280x720, 5 seconds, 108900 output tokens (TXE-7493); and the video sweeper settles the job, read by its settlement row id (UUIDv5 of the video namespace and <provider>:<video id>), at 108900 x $0.00001 = $1.089, with accounting.seconds 5 and not marked incomplete. Red before: neither provider was in the settler's videoProviders (they were exempted, naming this ticket), so no settlement row appeared, and before TXE-7493 the query read the task as in_progress. Another video provider joins this folder by adding its provider to video-settlement.config.json, a priced model to the fixture's pricing sheet, and three rows.",
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.variables.get('videoSettlementFixture') !== '1') {",
          "  pm.execution.skipRequest();",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "599.1 reset the fixture's record (ark video settlement)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{videoSettlementFixtureUrl}}/__reset",
          "host": [
            "{{videoSettlementFixtureUrl}}"
          ],
          "path": [
            "__reset"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the fixture record is reset', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.eql(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "599.2 volcengine/doubao-seedance-1-0-pro-250528 POST /v1/videos asking for 5 seconds is a queued Ark task (ark video settlement)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/videos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"volcengine/doubao-seedance-1-0-pro-250528\",\n  \"prompt\": \"a paper boat drifting down a rain gutter\",\n  \"seconds\": \"5\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the create is a queued task named for volcengine', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.id, pm.response.text()).to.eql('cgt-ovr-video:volcengine');",
              "  pm.expect(j.status, pm.response.text()).to.eql('queued');",
              "  pm.variables.set('arkSettle_volcengine_VideoId', j.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "599.3 volcengine GET /v1/videos/{id} reads Ark's finished task: completed, 1280x720, 5 seconds, 108900 output tokens (ark video settlement)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/videos/{{arkSettle_volcengine_VideoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos",
            "{{arkSettle_volcengine_VideoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the task is completed with the seconds and tokens Ark reported', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.status, pm.response.text()).to.eql('completed');",
              "  pm.expect(j.size, pm.response.text()).to.eql('1280x720');",
              "  pm.expect(j.seconds, pm.response.text()).to.eql('5');",
              "  pm.expect(j.usage && j.usage.output_tokens, pm.response.text()).to.eql(108900);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "599.4 the video sweeper settles the volcengine job at the tokens Ark billed, $1.089 (ark video settlement)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Bifrost-Setup-Token",
            "value": "{{setupToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/logs?providers=volcengine&limit=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "logs"
          ],
          "query": [
            {
              "key": "providers",
              "value": "volcengine"
            },
            {
              "key": "limit",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The settlement row's id is jobaccounting.AccountingLogID: UUIDv5 (SHA-1) of the video namespace and",
              "// '<provider>:<video id>'.",
              "var CryptoJS = require('crypto-js');",
              "function uuidv5(namespace, name) {",
              "  var hash = CryptoJS.SHA1(CryptoJS.enc.Hex.parse(namespace.replace(/-/g, '')).concat(CryptoJS.enc.Utf8.parse(name))).toString();",
              "  var b = hash.slice(0, 32).split('');",
              "  b[12] = '5';",
              "  b[16] = ((parseInt(b[16], 16) & 0x3) | 0x8).toString(16);",
              "  var s = b.join('');",
              "  return s.slice(0, 8) + '-' + s.slice(8, 12) + '-' + s.slice(12, 16) + '-' + s.slice(16, 20) + '-' + s.slice(20, 32);",
              "}",
              "var videoId = pm.variables.get('arkSettle_volcengine_VideoId');",
              "var logId = uuidv5('b1e0f7c4-2a63-4d18-9f5b-6c0a3d8e41d7', 'volcengine:' + videoId);",
              "var token = pm.variables.get('setupToken');",
              "var last = '';",
              "function check(attempt) {",
              "  pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/logs/' + logId, method: 'GET', header: { 'X-Bifrost-Setup-Token': token } }, function (err, res) {",
              "    if (!err && res.code === 200 && res.json().cost !== undefined) {",
              "      var j = res.json();",
              "      pm.test('the job is charged for the 108900 video tokens Ark billed, at $0.00001 a token: $1.089', function () {",
              "        pm.expect(j.cost, JSON.stringify(j)).to.be.closeTo(1.089, 1e-9);",
              "        var accounting = j.video_debug && j.video_debug.accounting;",
              "        pm.expect(accounting, JSON.stringify(j.video_debug)).to.be.ok;",
              "        pm.expect(accounting.seconds, JSON.stringify(accounting)).to.eql(5);",
              "        pm.expect(accounting.incomplete, JSON.stringify(accounting)).to.not.be.ok;",
              "      });",
              "      return;",
              "    }",
              "    last = err ? String(err) : (res.code + ' ' + res.text().slice(0, 300));",
              "    if (attempt < 120) { setTimeout(function () { check(attempt + 1); }, 1000); return; }",
              "    pm.test('the settlement row appeared', function () { pm.expect.fail('settlement row ' + logId + ' for ' + videoId + ' never appeared: ' + last); });",
              "  });",
              "}",
              "check(0);"
            ]
          }
        }
      ]
    },
