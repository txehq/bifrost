{
  "name": "288. BytePlus Seedance video lifecycle: create, poll, download, delete (byteplus video lifecycle)",
  "description": "Pins the BytePlus Seedance video lifecycle end to end: /v1/videos creates a /api/v3/contents/generations/tasks task (queued, provider-suffixed id, seconds from the request), /v1/videos/{id} polls the task until it completes and reports a WxH size (Ark's resolution tier and ratio, so a 720p task selects the 720p rate at settlement instead of carrying the label \"720p\"), /v1/videos/{id}/content downloads the task's signed URL through the gateway's public-address-only media fetch and serves it with a video/* type, and DELETE /v1/videos/{id} deletes the task. Seedance bills per generated clip, so every row is [PREVIEW]: it runs only with INCLUDE_PREVIEW=1, the same opt-in the Go live test has as BYTEPLUS_RUN_VIDEO_TESTS=1.",
  "item": [
    {
      "name": "[PREVIEW] /v1/videos - Seedance text-to-video task is queued - byteplus/dreamina-seedance-2-5-260628",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('byteplusVideoId');",
              "pm.collectionVariables.unset('byteplusVideoPolls');",
              "pm.test('create returns a queued task with a provider-suffixed id', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.id, 'no task id: ' + pm.response.text()).to.be.a('string').that.is.not.empty;",
              "  pm.expect(j.status, 'status: ' + pm.response.text()).to.eql('queued');",
              "  pm.expect(j.seconds, 'seconds: ' + pm.response.text()).to.eql('5');",
              "  pm.collectionVariables.set('byteplusVideoId', j.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"byteplus/dreamina-seedance-2-5-260628\",\n  \"prompt\": \"A paper boat drifts across a still pond at dawn\",\n  \"seconds\": \"5\",\n  \"size\": \"1280x720\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/videos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos"
          ]
        }
      }
    },
    {
      "name": "[PREVIEW] /v1/videos/{id} - poll the Seedance task until it completes, with a WxH size - byteplus/dreamina-seedance-2-5-260628",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var id = pm.collectionVariables.get('byteplusVideoId');",
              "if (!id) { pm.test.skip('no BytePlus video id produced by the create row', function () {}); return; }",
              "pm.test('retrieve succeeds', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "});",
              "if (pm.response.code !== 200) { pm.collectionVariables.unset('byteplusVideoPolls'); return; }",
              "var j = pm.response.json();",
              "var polls = Number(pm.collectionVariables.get('byteplusVideoPolls') || 0);",
              "if ((j.status === 'queued' || j.status === 'in_progress') && polls < 60) {",
              "  // Seedance typically finishes in one to five minutes; poll every 10s for up to 10 minutes.",
              "  pm.collectionVariables.set('byteplusVideoPolls', polls + 1);",
              "  setTimeout(function () {}, 10000);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "pm.collectionVariables.unset('byteplusVideoPolls');",
              "pm.test('task completed with a downloadable video', function () {",
              "  pm.expect(j.status, 'final status: ' + pm.response.text()).to.eql('completed');",
              "  pm.expect(j.id).to.eql(id);",
              "  pm.expect(j.videos, 'videos: ' + pm.response.text()).to.be.an('array').that.is.not.empty;",
              "});",
              "pm.test('size is WxH so the per-resolution video rate can apply', function () {",
              "  pm.expect(j.size, 'size: ' + pm.response.text()).to.match(/^[0-9]+x[0-9]+$/);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/videos/{{byteplusVideoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos",
            "{{byteplusVideoId}}"
          ]
        }
      }
    },
    {
      "name": "[PREVIEW] /v1/videos/{id}/content - downloads the Seedance video bytes - byteplus/dreamina-seedance-2-5-260628",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var id = pm.collectionVariables.get('byteplusVideoId');",
              "if (!id) { pm.test.skip('no BytePlus video id produced by the create row', function () {}); return; }",
              "pm.test('download returns video bytes', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 500)).to.eql(200);",
              "  pm.expect(pm.response.headers.get('Content-Type') || '', 'content type').to.match(/^video\\//);",
              "  pm.expect(pm.response.responseSize, 'empty body').to.be.above(1000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/videos/{{byteplusVideoId}}/content",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos",
            "{{byteplusVideoId}}",
            "content"
          ]
        }
      }
    },
    {
      "name": "[PREVIEW] DELETE /v1/videos/{id} - deletes the finished Seedance task - byteplus/dreamina-seedance-2-5-260628",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var id = pm.collectionVariables.get('byteplusVideoId');",
              "if (!id) { pm.test.skip('no BytePlus video id produced by the create row', function () {}); return; }",
              "pm.test('delete reports the task deleted', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.id).to.eql(id);",
              "  pm.expect(j.deleted, 'deleted: ' + pm.response.text()).to.eql(true);",
              "});",
              "pm.collectionVariables.unset('byteplusVideoId');"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/videos/{{byteplusVideoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos",
            "{{byteplusVideoId}}"
          ]
        }
      }
    }
  ]
}
