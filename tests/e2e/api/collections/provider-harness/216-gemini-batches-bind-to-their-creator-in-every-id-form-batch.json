{
  "name": "216. Gemini batches bind to their creator in every id form (batch-id-forms) [SERIAL]",
  "description": "Two virtual keys share the operator's Gemini key. A batch created under the first is answered with 'batches/<id>', and Gemini accepts the bare '<id>' for the same batch; the native route only ever sends the bare form, since the collection is part of its path. The second key gets a 404 on retrieve and cancel by the bare id, on the native route and on the OpenAI-compatible one, while the first key still retrieves and cancels its batch by the bare id. An inline one-request batch is the probe because it needs no file upload; the same binding covers Gemini files and cached contents, and Vertex batches by their job number.",
  "item": [
    {
      "name": "gemini batch-id-forms setup: create virtual key A (owner)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The run id keeps parallel runs against one server from colliding on the key name.",
              "function startFresh() {",
              "  pm.collectionVariables.unset('idFormOwnVkId');",
              "  pm.collectionVariables.unset('idFormOwnVkValue');",
              "  pm.collectionVariables.set('idFormOwnVkName', 'harness-batch-id-forms-A (owner)-run-' + Date.now() + '-' + pm.variables.replaceIn('{{$guid}}'));",
              "}",
              "// A key a previous run failed to delete is retained; delete it before this run replaces it.",
              "function handleStaleKey() {",
              "var staleVkId = pm.collectionVariables.get('idFormOwnVkId');",
              "if (!staleVkId) {",
              "  startFresh();",
              "} else {",
              "  var headers = {};",
              "  var managementToken = pm.environment.get('managementApiKey') || pm.collectionVariables.get('managementApiKey');",
              "  if (managementToken) { headers.Authorization = 'Bearer ' + managementToken; }",
              "  pm.sendRequest({url: pm.variables.replaceIn('{{baseUrl}}') + '/api/governance/virtual-keys/' + staleVkId, method: 'DELETE', header: headers}, function (err, response) {",
              "    var deleted = !err && (response.code === 200 || response.code === 404);",
              "    pm.test('batch-id-forms: the retained virtual key A (owner) from an earlier run is deleted', function () {",
              "      pm.expect(err, 'stale key ' + staleVkId + ' delete errored: ' + err).to.equal(null);",
              "      pm.expect([200, 404], 'stale key ' + staleVkId + ' not deleted: ' + response.text()).to.include(response.code);",
              "    });",
              "    if (deleted) { startFresh(); return; }",
              "    pm.collectionVariables.unset('idFormOwnVkValue');",
              "    pm.execution.skipRequest();",
              "  });",
              "}",
              "}",
              "// A batch an earlier run could not cancel is retained with its owning key; cancel it with that key before the key is replaced,",
              "// since no other key may cancel it. If that fails again the key is kept and this run is skipped, loudly.",
              "var staleBatchId = pm.collectionVariables.get('idFormBatchId');",
              "var staleOwnVk = pm.collectionVariables.get('idFormOwnVkValue');",
              "if (!staleBatchId || !staleOwnVk) {",
              "  pm.collectionVariables.unset('idFormBatchId');",
              "  handleStaleKey();",
              "} else {",
              "  pm.sendRequest({url: pm.variables.replaceIn('{{baseUrl}}') + '/genai/v1beta/batches/' + staleBatchId + ':cancel', method: 'POST', header: {'x-bf-vk': staleOwnVk, 'Content-Type': 'application/json'}, body: {mode: 'raw', raw: '{}'}}, function (err, response) {",
              "    var cancelled = !err && (response.code < 300 || response.code === 404);",
              "    pm.test('batch-id-forms: the retained batch from an earlier run is cancelled with its owning key', function () {",
              "      pm.expect(err, 'stale batch ' + staleBatchId + ' cancel errored: ' + err).to.equal(null);",
              "      pm.expect(cancelled, 'stale batch ' + staleBatchId + ' not cancelled: ' + response.text()).to.equal(true);",
              "    });",
              "    if (!cancelled) { pm.execution.skipRequest(); return; }",
              "    pm.collectionVariables.unset('idFormBatchId');",
              "    handleStaleKey();",
              "  });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('batch-id-forms: virtual key A (owner) created', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "});",
              "var vk = {};",
              "try { vk = pm.response.json().virtual_key || {}; } catch (e) { vk = {}; }",
              "pm.test('batch-id-forms: virtual key A (owner) has an id and a value', function () {",
              "  pm.expect(vk.id, 'no id: ' + pm.response.text()).to.be.a('string').and.not.equal('');",
              "  pm.expect(vk.value, 'no value: ' + pm.response.text()).to.be.a('string').and.not.equal('');",
              "});",
              "if (vk.id) { pm.collectionVariables.set('idFormOwnVkId', vk.id); }",
              "if (vk.value) { pm.collectionVariables.set('idFormOwnVkValue', vk.value); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"{{idFormOwnVkName}}\",\"provider_configs\":[{\"provider\":\"gemini\",\"allowed_models\":[\"*\"],\"key_ids\":[\"*\"],\"weight\":1}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/governance/virtual-keys"
      },
      "response": []
    },
