              "pm.test('batch-id-forms: virtual key A (owner) deleted', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "});",
              "if (pm.response.code === 200 || pm.response.code === 404) {",
              "  pm.collectionVariables.unset('idFormOwnVkId');",
              "  pm.collectionVariables.unset('idFormOwnVkValue');",
              "  pm.collectionVariables.unset('idFormOwnVkName');",
              "}"
            ]
          }
        }
      ],
      "request": {
