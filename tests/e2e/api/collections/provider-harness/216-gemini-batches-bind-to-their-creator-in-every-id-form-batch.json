    {
      "name": "gemini batch-id-forms: the owning key creates a batch",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A batch an earlier run could not cancel keeps its id until it is cancelled; creating another now would drop",
              "// that cleanup handle and leave a running batch nobody can cancel. Setup reports the failed cancel loudly.",
              "if (pm.collectionVariables.get('idFormBatchId')) { pm.execution.skipRequest(); return; }",
              "if (!pm.collectionVariables.get('idFormOwnVkValue') || !pm.collectionVariables.get('idFormOtherVkValue')) { pm.execution.skipRequest(); return; }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var txt = pm.response.text() || '';",
              "pm.test('batch-id-forms: batch create under the owning key is 2xx', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + txt.slice(0, 400)).to.be.below(300);",
              "});",
              "var j = {};",
              "try { j = pm.response.json() || {}; } catch (e) { j = {}; }",
              "pm.test('batch-id-forms: the create returns the batch resource name', function () {",
              "  pm.expect(j.name, 'no name: ' + txt.slice(0, 400)).to.be.a('string').and.match(/^batches\\/.+/);",
              "});",
              "// The native route addresses the batch by its id alone; the 'batches/' collection is part of the route path.",
              "if (typeof j.name === 'string' && /^batches\\/.+/.test(j.name)) { pm.collectionVariables.set('idFormBatchId', j.name.replace(/^batches\\//, '')); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-vk",
            "value": "{{idFormOwnVkValue}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"batch\":{\"displayName\":\"bifrost-harness-batch-id-forms\",\"inputConfig\":{\"requests\":{\"requests\":[{\"request\":{\"contents\":[{\"role\":\"user\",\"parts\":[{\"text\":\"Say hello\"}]}],\"generationConfig\":{\"maxOutputTokens\":16}},\"metadata\":{\"key\":\"req-1\"}}]}}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/genai/v1beta/models/{{genaiModel}}:batchGenerateContent"
      },
      "response": []
    },
