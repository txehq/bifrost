    {
      "name": "670.3 github-copilot/claude-sonnet-4.6 /v1/chat/completions stream via /v1/messages (copilot routes)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "function sseFrames() {",
              "  var out = [];",
              "  pm.response.text().split('\\n').forEach(function (line) {",
              "    if (line.indexOf('data: ') !== 0) { return; }",
              "    var data = line.slice(6).trim();",
              "    if (!data || data === '[DONE]') { return; }",
              "    try { out.push(JSON.parse(data)); } catch (e) {}",
              "  });",
              "  return out;",
              "}",
              "pm.test('670.3 github-copilot/claude-sonnet-4.6 /v1/chat/completions stream via /v1/messages (copilot routes) answers 200', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 500)).to.equal(200);",
              "});",
              "if (pm.response.code !== 200) { return; }",
              "pm.test('response is SSE', function () {",
              "  var ct = pm.response.headers.get('content-type') || '';",
              "  pm.expect(ct, 'expected SSE, got ' + ct).to.include('event-stream');",
              "});",
              "pm.test('stream carries assistant text', function () {",
              "  var text = sseFrames().map(function (f) { var d = f.choices && f.choices[0] && f.choices[0].delta; return (d && d.content) || ''; }).join('');",
              "  pm.expect(text, 'no delta content in: ' + pm.response.text().slice(0, 400)).to.not.be.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
