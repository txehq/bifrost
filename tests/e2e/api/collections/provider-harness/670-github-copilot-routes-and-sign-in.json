          "raw": "{\n  \"model\": \"github-copilot/claude-sonnet-4.6\",\n  \"max_tokens\": 64,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Reply with one word.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Say hi.\"\n    }\n  ],\n  \"stream\": true\n}",
