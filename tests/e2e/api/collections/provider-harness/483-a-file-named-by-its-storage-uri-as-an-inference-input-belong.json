    {
      "name": "483.3 the owning key uploads a file, and the provider records it under a gs:// storage URI",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "  return;",
              "}",
              "if (!pm.collectionVariables.get('storageVkOwner') || !pm.collectionVariables.get('storageVkOther')) { pm.execution.skipRequest(); return; }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var txt = pm.response.text() || '';",
              "pm.test('the upload under the owning key is 200', function () { pm.expect(pm.response.code, 'failed: ' + txt.slice(0, 400)).to.eql(200); });",
              "var j = {}; try { j = pm.response.json() || {}; } catch (e) { j = {}; }",
              "// The route hands a storage-URI id back in an opaque, path-safe form (base64url); the URI itself is what an",
              "// inference request names.",
              "var uri = '';",
              "try { uri = Buffer.from(String(j.id || '').replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString('utf8'); } catch (e) { uri = ''; }",
              "if (uri.indexOf('gs://') !== 0 && String(j.id || '').indexOf('gs://') === 0) { uri = j.id; }",
              "pm.test('the file id is a gs:// URI in the fixture bucket', function () { pm.expect(uri, 'id: ' + txt.slice(0, 400)).to.match(/^gs:\\/\\/bifrost-fixture-bucket\\/uploads\\/[0-9]+-[0-9]+\\.jsonl$/); });",
              "if (uri.indexOf('gs://') === 0) { pm.collectionVariables.set('storageFileUri', uri); pm.collectionVariables.set('storageFileUriUpper', 'GS://' + uri.slice(5)); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-bf-vk",
            "value": "{{storageVkOwner}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "src": "tests/e2e/api/fixtures/sample.jsonl",
              "type": "file"
            },
            {
              "key": "purpose",
              "value": "user_data",
              "type": "text"
            },
            {
              "key": "provider",
              "value": "storage_uri_files",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/v1/files",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "files"
          ]
        }
      }
    },
