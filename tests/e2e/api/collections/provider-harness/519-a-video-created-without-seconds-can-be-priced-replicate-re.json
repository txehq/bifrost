    {
      "name": "519.4 only the create with seconds reached Replicate, with input.duration 8 (video without seconds)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__wire",
          "host": [
            "{{providerErrorFixtureUrl}}"
          ],
          "path": [
            "__wire"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('one prediction create, the one of row 3', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var calls = pm.response.json().data[0].calls.filter(function (c) { return c.path.indexOf('/pp/replicate/') === 0 && /\\/predictions$/.test(c.path); });",
              "  pm.expect(calls.length, JSON.stringify(calls)).to.eql(1);",
              "  var sent = JSON.parse(calls[0].body);",
              "  pm.expect(sent.input.duration, calls[0].body).to.eql(8);",
              "});"
            ]
          }
        }
