            "type": "text/javascript",
            "exec": [
              "pm.test('one text_to_video create with duration 2', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var calls = pm.response.json().data[0].calls.filter(function (c) { return c.path === '/pp/runway/v1/text_to_video'; });",
              "  pm.expect(calls.length, JSON.stringify(calls)).to.eql(1);",
              "  pm.expect(JSON.parse(calls[0].body).duration, calls[0].body).to.eql(2);",
