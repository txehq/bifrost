{
  "name": "519. A video created without seconds can be priced: replicate refuses it, runway records the duration it sent, kling's fractional duration settles at its whole seconds (video without seconds) [SERIAL]",
  "item": [
    {
      "name": "519.1 reset the fixture's record (video without seconds)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__reset",
          "host": [
            "{{providerErrorFixtureUrl}}"
          ],
          "path": [
            "__reset"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.expect(pm.response.code, pm.response.text()).to.eql(200);"
            ]
          }
        }
      ]
    },
    {
      "name": "519.2 [EXPECT-400] replicate/google/veo-3 POST /v1/videos with no seconds is refused: the hosted model picks its own length and Replicate reports neither it nor a cost (video without seconds)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/videos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"replicate/google/veo-3\",\n  \"prompt\": \"a paper boat drifting down a rain gutter\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('a create with no seconds is caller_unsupported_parameter naming seconds', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(400);",
              "  var j = pm.response.json();",
              "  pm.expect(j.extra_fields && j.extra_fields.error_type, 'error_type: ' + pm.response.text()).to.eql('caller_unsupported_parameter');",
              "  pm.expect(j.error && j.error.param, 'error.param: ' + pm.response.text()).to.eql('seconds');",
              "  pm.expect(j.error.message, pm.response.text()).to.include('could not be priced');",
              "});"
            ]
          }
        }
      ]
    },
    {
