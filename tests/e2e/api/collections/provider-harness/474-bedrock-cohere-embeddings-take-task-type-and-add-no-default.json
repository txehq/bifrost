{
  "name": "474. Bedrock Cohere embeddings take task_type and add no default input_type (bedrock cohere embeddings task_type)",
  "description": "Fork contract C4 on Bedrock's Cohere embed models, as on the cohere provider (folder 315). Before this, Bedrock's Cohere converter sent input_type search_document (image for images[]) whenever the caller named none, and ignored the unified task_type. Now task_type is sent as input_type through the same mapping the cohere provider uses (Cohere's own values as given, Gemini's RETRIEVAL_QUERY/RETRIEVAL_DOCUMENT onto search_query/search_document), a native invoke body's own input_type is sent as given, and a request with neither is refused with 400 caller_unsupported_parameter on task_type before any upstream call. Every case pins the key with x-bf-api-key.",
  "item": [
    {
      "name": "474.1 bedrock/global.cohere.embed-v4:0 - /v1/embeddings task_type reaches Bedrock as input_type",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-api-key",
            "value": "Bedrock API Key"
          },
          {
            "key": "x-bf-send-back-raw-request",
            "value": "true"
          },
          {
            "key": "x-bf-send-back-raw-response",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"bedrock/global.cohere.embed-v4:0\",\n  \"input\": \"alpha kestrel harbor\",\n  \"task_type\": \"search_query\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/embeddings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "embeddings"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function asObj(v) { if (typeof v === 'string') { try { return JSON.parse(v); } catch (e) { return null; } } return v || null; }",
              "pm.test('200 with one vector', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "  pm.expect((pm.response.json().data || []).length).to.eql(1);",
              "});",
              "pm.test('task_type was sent as input_type, nothing defaulted', function () {",
              "  var sent = asObj((pm.response.json().extra_fields || {}).raw_request);",
              "  pm.expect(sent, 'no raw_request').to.be.an('object');",
              "  pm.expect(sent.input_type).to.eql('search_query');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "474.2 [EXPECT-400] bedrock/global.cohere.embed-v4:0 - /v1/embeddings without task_type is caller_unsupported_parameter with no upstream call",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-api-key",
            "value": "Bedrock API Key"
          },
          {
            "key": "x-bf-send-back-raw-request",
            "value": "true"
          },
          {
            "key": "x-bf-send-back-raw-response",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"bedrock/global.cohere.embed-v4:0\",\n  \"input\": \"alpha kestrel harbor\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/embeddings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "embeddings"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 caller_unsupported_parameter on task_type', function () {",
              "  pm.expect(pm.response.code, 'body: ' + pm.response.text().slice(0, 400)).to.eql(400);",
              "  var j = pm.response.json(); var ef = j.extra_fields || {};",
              "  pm.expect(ef.error_type).to.eql('caller_unsupported_parameter');",
              "  pm.expect((j.error || {}).param).to.eql('task_type');",
              "  pm.expect(!!j.is_bifrost_error, 'the caller is at fault, not Bifrost').to.be.false;",
              "});",
              "pm.test('Bedrock was never called', function () {",
              "  pm.expect((pm.response.json().extra_fields || {}).raw_response, 'an upstream response came back').to.be.undefined;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "474.3 [EXPECT-400] /bedrock/model/global.cohere.embed-v4:0/invoke - a native body without input_type is caller_unsupported_parameter with no upstream call",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-api-key",
            "value": "Bedrock API Key"
          },
          {
            "key": "x-bf-send-back-raw-request",
            "value": "true"
          },
          {
            "key": "x-bf-send-back-raw-response",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"texts\": [\n    \"alpha kestrel harbor\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bedrock/model/global.cohere.embed-v4:0/invoke",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "bedrock",
            "model",
            "global.cohere.embed-v4:0",
            "invoke"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400, classified caller_unsupported_parameter', function () {",
              "  pm.expect(pm.response.code, 'body: ' + pm.response.text().slice(0, 400)).to.eql(400);",
              "  pm.expect(pm.response.headers.get('x-bifrost-error-type')).to.eql('caller_unsupported_parameter');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "474.4 /bedrock/model/global.cohere.embed-v4:0/invoke - the caller input_type reaches Bedrock unchanged",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-api-key",
            "value": "Bedrock API Key"
          },
          {
            "key": "x-bf-send-back-raw-request",
            "value": "true"
          },
          {
            "key": "x-bf-send-back-raw-response",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"texts\": [\n    \"alpha kestrel harbor\"\n  ],\n  \"input_type\": \"search_query\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bedrock/model/global.cohere.embed-v4:0/invoke",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "bedrock",
            "model",
            "global.cohere.embed-v4:0",
            "invoke"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 with one vector', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "  var j = pm.response.json(); var e = j.embeddings;",
              "  var n = Array.isArray(e) ? e.length : ((e && e.float) || []).length;",
              "  pm.expect(n, 'body: ' + pm.response.text().slice(0, 300)).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
