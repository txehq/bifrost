    {
      "name": "402.6 [EXPECT-4XX] elevenlabs/scribe_v2 - a keyterms value ElevenLabs refuses for its length proves the unmapped form field reached it; the error keeps the vendor status and carries error_type (elevenlabs contract)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-bf-api-key",
            "value": "ElevenLabs API Key"
          },
          {
            "key": "x-bf-passthrough-extra-params",
            "value": "true"
          },
          {
            "key": "x-bf-send-back-raw-response",
            "value": "true"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "model",
              "value": "elevenlabs/scribe_v2",
              "type": "text"
            },
            {
              "key": "keyterms",
              "value": "Bifrost",
              "type": "text"
            },
            {
              "key": "keyterms",
              "value": "a keyterm that is far longer than the fifty characters ElevenLabs accepts for one keyterm",
              "type": "text"
            },
            {
              "key": "file",
              "src": "tests/e2e/api/fixtures/sample.mp3",
              "type": "file"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/v1/audio/transcriptions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "audio",
            "transcriptions"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function asObj(v) { if (typeof v === 'string') { try { return JSON.parse(v); } catch (e) { return null; } } return v || null; }",
              "pm.test('the keyterms field reached ElevenLabs, which rejects the over-long value', function () {",
              "  var t = pm.response.text();",
              "  pm.expect(pm.response.code, 'expected ElevenLabs to reject the request; got: ' + t.slice(0, 400)).to.be.within(400, 499);",
              "  pm.expect(t.toLowerCase(), 'the error does not name keyterm, so the field may not have reached ElevenLabs: ' + t.slice(0, 400)).to.include('keyterm');",
              "});",
              "pm.test('the vendor error keeps the vendor status and carries error_type', function () {",
              "  var j = pm.response.json(); var ef = j.extra_fields || {};",
              "  pm.expect(j.status_code, 'status_code in the envelope').to.eql(pm.response.code);",
              "  pm.expect(!!j.is_bifrost_error, 'a vendor error, not a Bifrost failure').to.be.false;",
              "  pm.expect(ef.error_type, 'error_type: ' + pm.response.text().slice(0, 400)).to.be.a('string').and.to.match(/^(caller|provider)_/);",
              "  pm.expect(pm.response.headers.get('x-bifrost-error-type')).to.eql(ef.error_type);",
              "  var raw = asObj(ef.raw_response);",
              "  pm.expect(raw, 'no raw vendor error body').to.be.an('object');",
              "  pm.expect(raw, 'ElevenLabs errors carry detail').to.have.property('detail');",
              "});"
            ]
          }
        }
      ]
    },
