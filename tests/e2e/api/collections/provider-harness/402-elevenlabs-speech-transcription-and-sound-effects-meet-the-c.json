    {
      "name": "402.4 elevenlabs/eleven_turbo_v2_5 - SSE speech: speech.audio.done carries usage.vendor_cost, and only the caller's speed is in voice_settings (elevenlabs contract)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-api-key",
            "value": "ElevenLabs API Key"
          },
          {
            "key": "x-bf-passthrough-extra-params",
            "value": "true"
          },
          {
            "key": "x-bf-send-back-raw-request",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"elevenlabs/eleven_turbo_v2_5\",\n  \"input\": \"Hello from the contract harness.\",\n  \"voice\": \"21m00Tcm4TlvDq8ikWAM\",\n  \"speed\": 1.1,\n  \"stream_format\": \"sse\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/audio/speech",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "audio",
            "speech"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function asObj(v) { if (typeof v === 'string') { try { return JSON.parse(v); } catch (e) { return null; } } return v || null; }",
              "var deltas = 0, dones = [], errors = [];",
              "pm.test('SSE speech stream delivers audio, then one speech.audio.done', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "  pm.expect(pm.response.headers.get('content-type') || '').to.include('text/event-stream');",
              "  (pm.response.text() || '').split('\\n').forEach(function (l) {",
              "    if (l.indexOf('data: ') !== 0) { return; }",
              "    var p = l.slice(6).trim();",
              "    if (p === '[DONE]') { return; }",
              "    var j = JSON.parse(p);",
              "    if (j.error) { errors.push(p); return; }",
              "    if (j.type === 'speech.audio.delta') { deltas++; } else if (j.type === 'speech.audio.done') { dones.push(j); }",
              "  });",
              "  pm.expect(errors, 'error events: ' + errors.join(' | ')).to.be.empty;",
              "  pm.expect(deltas, 'speech.audio.delta events').to.be.above(0);",
              "  pm.expect(dones.length, 'speech.audio.done events').to.eql(1);",
              "});",
              "pm.test('speech.audio.done usage.vendor_cost is the character-cost header, in credits', function () {",
              "  var cost = pm.response.headers.get('character-cost');",
              "  pm.expect(cost, 'ElevenLabs sent no character-cost header').to.be.a('string').and.to.match(/^[0-9]+(\\.[0-9]+)?$/);",
              "  var u = (dones[0] || {}).usage;",
              "  pm.expect(u, 'speech.audio.done has no usage').to.be.an('object');",
              "  pm.expect(u.vendor_cost, JSON.stringify(u)).to.eql({ amount: Number(cost), unit: 'credit' });",
              "  pm.expect(u, 'a request value or Bifrost count reported as the vendor\\'s').to.not.have.any.keys('audio_seconds', 'billed_characters');",
              "});",
              "pm.test('voice_settings sent to ElevenLabs is exactly {speed: 1.1}', function () {",
              "  var sent = asObj(((dones[0] || {}).extra_fields || {}).raw_request);",
              "  pm.expect(sent, 'no raw_request on speech.audio.done').to.be.an('object');",
              "  pm.expect(sent.voice_settings, JSON.stringify(sent)).to.eql({ speed: 1.1 });",
              "});",
              "pm.test('served by the pinned key, no fallback: one upstream call', function () {",
              "  pm.expect(pm.response.headers.get('x-bifrost-routing-info-key'), 'routing key').to.eql('ElevenLabs API Key');",
              "  pm.expect(pm.response.headers.get('x-bifrost-routing-info-is-fallback') || 'false').to.eql('false');",
              "});"
            ]
          }
        }
      ]
    },
