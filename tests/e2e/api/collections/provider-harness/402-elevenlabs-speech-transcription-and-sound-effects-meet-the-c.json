              "});",
              "pm.test('served by the pinned key, no fallback: one upstream call', function () {",
              "  var ri = (pm.response.json().extra_fields || {}).routing_info || {};",
              "  pm.expect(ri.key, JSON.stringify(ri)).to.eql('ElevenLabs API Key');",
              "  pm.expect(!!ri.is_fallback).to.be.false;",
              "});"
