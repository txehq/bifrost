{
  "name": "191. xai realtime native credentials",
  "description": "Synthetic invalid browser credentials must return HTTP 400 before WebSocket upgrade, including on open deployments. No real provider credentials or inference calls. Valid native xAI credentials and OpenAI compatibility are covered by Go admission tests; these cases do not validate voice streaming.",
  "item": [
    {
      "name": "xai grok-voice-latest realtime native credentials empty [EXPECT-400]",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Connection",
            "value": "Upgrade"
          },
          {
            "key": "Upgrade",
            "value": "websocket"
          },
          {
            "key": "Sec-WebSocket-Version",
            "value": "13"
          },
          {
            "key": "Sec-WebSocket-Key",
            "value": "dGhlIHNhbXBsZSBub25jZQ=="
          },
          {
            "key": "Sec-WebSocket-Protocol",
            "value": "xai-client-secret."
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/realtime?model=xai/grok-voice-latest",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "realtime"
          ],
          "query": [
            {
              "key": "model",
              "value": "xai/grok-voice-latest"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('invalid native credential is refused before upgrade', function () {",
              "  pm.expect(pm.response.code, 'expected HTTP refusal').to.equal(400);",
              "  pm.expect(pm.response.text()).to.include('realtime subprotocol credential');",
              "  pm.expect(pm.response.text().indexOf('ek_synthetic')).to.equal(-1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "xai grok-voice-latest realtime native credentials conflicting [EXPECT-400]",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Connection",
            "value": "Upgrade"
          },
          {
            "key": "Upgrade",
            "value": "websocket"
          },
          {
            "key": "Sec-WebSocket-Version",
            "value": "13"
          },
          {
            "key": "Sec-WebSocket-Key",
            "value": "dGhlIHNhbXBsZSBub25jZQ=="
          },
          {
            "key": "Sec-WebSocket-Protocol",
            "value": "xai-client-secret.ek_synthetic_one, openai-insecure-api-key.ek_synthetic_two"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/realtime?model=xai/grok-voice-latest",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "realtime"
          ],
          "query": [
            {
              "key": "model",
              "value": "xai/grok-voice-latest"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('invalid native credential is refused before upgrade', function () {",
              "  pm.expect(pm.response.code, 'expected HTTP refusal').to.equal(400);",
              "  pm.expect(pm.response.text()).to.include('realtime subprotocol credential');",
              "  pm.expect(pm.response.text().indexOf('ek_synthetic')).to.equal(-1);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
