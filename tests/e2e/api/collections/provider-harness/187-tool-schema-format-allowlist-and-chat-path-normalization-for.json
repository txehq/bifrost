              "// dropped. Numeric formats (int64) and allowlisted ones (date-time) must survive.",
              "function collect(node, key, out) {",
              "  if (!node || typeof node !== 'object') { return out; }",
              "  if (Array.isArray(node)) { node.forEach(function (n) { collect(n, key, out); }); return out; }",
              "  Object.keys(node).forEach(function (k) {",
              "    if (k === key && typeof node[k] === 'string') { out.push(node[k]); } else { collect(node[k], key, out); }",
              "  });",
              "  return out;",
              "}",
              "var pats = collect(rr, 'pattern', []);",
              "var fmts = collect(rr, 'format', []).sort();",
              "var SENT = '^(?!\\\\.\\\\.?$)[^\\\\0]{1,200}$';",
              "var RELAXED = '^[^\\\\x00]{1,200}$';",
              "",
              "pm.test('request is accepted', function () {",
              "  pm.expect(pm.response.code, 'want 200: ' + txt.slice(0, 400)).to.eql(200);",
              "  pm.expect(rr, 'raw_request missing or unparseable: ' + txt.slice(0, 300)).to.be.an('object');",
              "});",
              "pm.test('pattern on the wire is exactly the relaxed form', function () {",
              "  pm.expect(pats, 'want exactly [' + RELAXED + '], got: ' + JSON.stringify(pats) + ' wire: ' + wire.slice(0, 300)).to.eql([RELAXED]);",
              "});",
              "pm.test('nested format:byte dropped, date-time and int64 kept', function () {",
              "  pm.expect(fmts, 'want exactly [date-time, int64], got: ' + JSON.stringify(fmts) + ' wire: ' + wire.slice(0, 300)).to.eql(['date-time', 'int64']);",
              "});",
              "pm.test('the model answers', function () {",
              "  var u = body.usage || {};",
              "  pm.expect(u.output_tokens, 'model produced no output: ' + txt.slice(0, 300)).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-send-back-raw-request",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"bedrock/global.moonshotai.kimi-k3\",\n  \"max_output_tokens\": 256,\n  \"input\": [\n    {\n      \"type\": \"message\",\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"input_text\",\n          \"text\": \"Say hi\"\n        }\n      ]\n    }\n  ],\n  \"tools\": [\n    {\n      \"type\": \"namespace\",\n      \"name\": \"gmail\",\n      \"description\": \"Gmail tools\",\n      \"tools\": [\n        {\n          \"type\": \"function\",\n          \"name\": \"send_message\",\n          \"description\": \"Send an email\",\n          \"parameters\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"attachments\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"$ref\": \"#/$defs/Attachment\"\n                }\n              },\n              \"send_at\": {\n                \"type\": \"string\",\n                \"format\": \"date-time\"\n              },\n              \"size\": {\n                \"type\": \"integer\",\n                \"format\": \"int64\"\n              },\n              \"path\": {\n                \"type\": \"string\",\n                \"pattern\": \"^(?!\\\\.\\\\.?$)[^\\\\0]{1,200}$\"\n              }\n            },\n            \"$defs\": {\n              \"Attachment\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"content\": {\n                    \"type\": \"string\",\n                    \"format\": \"byte\"\n                  }\n                },\n                \"required\": [\n                  \"content\"\n                ]\n              }\n            }\n          }\n        }\n      ]\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/responses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "responses"
          ]
        }
      }
    }
