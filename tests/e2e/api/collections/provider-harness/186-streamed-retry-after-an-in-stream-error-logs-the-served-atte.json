{
  "name": "186. Streamed retry after an in-stream error logs the served attempt (stream-retry-logging)",
  "description": "Local fixture regression. Run tests/e2e/api/runners/azure-stream-preamble-fixture.mjs, point an isolated gateway's OpenAI base_url at it with max_retries>=1 and logging on, and set streamRetryFixture=1 to enable these cases. Model preamble-retry fails the first call of each request (keyed by the forwarded x-bf-eh-fixture-run header) with startup events and then an in-stream rate limit inside an HTTP 200 stream, and serves the retry. The failed attempt used to run every post-hook before the retry loop saw it, so logging closed the request and stored the failed attempt's 429 as an error row with no tokens while the client received the retry's answer. The row must be the served retry: status success, number_of_retries 1, completion tokens recorded.",
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.variables.get('streamRetryFixture') !== '1') {",
          "  pm.execution.skipRequest();",
          "}",
          "pm.variables.set('streamRetryRequestId', 'stream-retry-' + Date.now() + '-' + Math.floor(Math.random() * 1e6));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var requestId = pm.variables.get('streamRetryRequestId');",
          "var body = pm.response.text();",
          "pm.test('Retried stream served the client', function () {",
          "  pm.expect(pm.response.code, body).to.equal(200);",
          "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
          "  pm.expect(body).not.to.include('azure-preamble-failed');",
          "  var text = '';",
          "  var terminal = false;",
          "  body.split('\\n').forEach(function (line) {",
          "    if (line.indexOf('data:') !== 0) return;",
          "    var data = line.slice(5).trim();",
          "    if (!data || data === '[DONE]') return;",
          "    var event = JSON.parse(data);",
          "    pm.expect(event.error, data).not.to.be.ok;",
          "    pm.expect(event.type, data).not.to.equal('response.failed');",
          "    if (event.type === 'response.output_text.delta') text += event.delta || '';",
          "    if (event.type === 'response.completed') terminal = true;",
          "    (event.choices || []).forEach(function (choice) {",
          "      if (choice.delta) text += choice.delta.content || '';",
          "      if (choice.finish_reason === 'stop') terminal = true;",
          "    });",
          "  });",
          "  pm.expect(text, body).to.equal('hello');",
          "  pm.expect(terminal, body).to.equal(true);",
          "});",
          "// The log row is written by the batching writer, so poll for it. Bounded: ten reads a second apart.",
          "function checkLog(attempt) {",
          "  pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/logs/' + requestId, method: 'GET' }, function (err, res) {",
          "    if (!err && res.code === 200) {",
          "      var j = res.json();",
          "      pm.test('Log row is the served retry, not the failed attempt', function () {",
          "        pm.expect(j.status, JSON.stringify(j)).to.equal('success');",
          "        pm.expect(j.number_of_retries, JSON.stringify(j)).to.equal(1);",
          "        pm.expect(j.token_usage && j.token_usage.completion_tokens, JSON.stringify(j.token_usage)).to.be.above(0);",
          "      });",
          "      return;",
          "    }",
          "    if (attempt < 10) { setTimeout(function () { checkLog(attempt + 1); }, 1000); return; }",
          "    pm.test('Log row appeared', function () { pm.expect.fail('log ' + requestId + ' never appeared: ' + (err ? String(err) : (res.code + ' ' + res.text()))); });",
          "  });",
          "}",
          "checkLog(0);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "OpenAI streamed retry after in-stream rate limit logs the served attempt - Chat Completions",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-request-id",
            "value": "{{streamRetryRequestId}}"
          },
          {
            "key": "x-bf-eh-fixture-run",
            "value": "{{streamRetryRequestId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\":\"openai/preamble-retry\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":true}"
        },
        "url": "{{baseUrl}}/v1/chat/completions"
      }
    },
    {
      "name": "OpenAI streamed retry after in-stream rate limit logs the served attempt - Responses",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-request-id",
            "value": "{{streamRetryRequestId}}"
          },
          {
            "key": "x-bf-eh-fixture-run",
            "value": "{{streamRetryRequestId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\":\"openai/preamble-retry\",\"input\":\"hi\",\"stream\":true}"
        },
        "url": "{{baseUrl}}/v1/responses"
      }
    }
  ]
}
