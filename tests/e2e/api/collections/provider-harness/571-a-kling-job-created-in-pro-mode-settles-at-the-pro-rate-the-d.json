{
  "name": "571. A Kling job created in pro mode settles at the pro rate the datasheet publishes, not the unbanded rate (video mode rate) [SERIAL]",
  "item": [
    {
      "name": "571.1 the fixture gateway runs with provider job accounting off; its client config is kept to restore at the end (video mode rate)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Bifrost-Setup-Token",
            "value": "bifrost-e2e-setup-token"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('videoModeClientConfig');",
              "pm.collectionVariables.unset('videoModeKlingId');",
              "pm.collectionVariables.unset('videoModeRetry');",
              "pm.test('accounting reads back off', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.client_config && j.client_config.disable_provider_job_accounting, pm.response.text().slice(0, 400)).to.equal(true);",
              "});",
              "var cc = pm.response.code === 200 ? pm.response.json().client_config : null;",
              "if (cc) { pm.collectionVariables.set('videoModeClientConfig', JSON.stringify(cc)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "571.2 [EXPECT-200] turn provider job accounting on, which starts the video sweeper (video mode rate)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Bifrost-Setup-Token",
            "value": "bifrost-e2e-setup-token"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{videoModeOnBody}}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var saved = pm.collectionVariables.get('videoModeClientConfig');",
              "if (!saved) {",
              "  // 571.1 kept no config: leave the switch alone rather than write a partial one.",
              "  pm.execution.skipRequest();",
              "} else {",
              "  var cc = JSON.parse(saved);",
              "  cc.disable_provider_job_accounting = false;",
              "  pm.variables.set('videoModeOnBody', JSON.stringify({ client_config: cc }));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('accounting turned on', function () {",
              "  pm.expect(pm.response.code, pm.response.text().slice(0, 400)).to.eql(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "571.3 kling/kling-3.0 POST /v1/videos with the mode extra param pro is queued as its own task (video mode rate)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-passthrough-extra-params",
            "value": "true"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/videos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"kling/kling-3.0\",\n  \"prompt\": \"[pro-mode] a paper boat drifts across a still pond at dawn\",\n  \"seconds\": \"5\",\n  \"mode\": \"pro\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('create returns the queued pro-mode Kling task', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.id, pm.response.text()).to.eql('893605946402811987:kling');",
              "  pm.expect(j.status, pm.response.text()).to.eql('queued');",
              "});",
              "if (pm.response.code === 200) { pm.collectionVariables.set('videoModeKlingId', pm.response.json().id); }",
              "pm.sendRequest({ url: pm.variables.get('providerErrorFixtureUrl') + '/__kling-calls', method: 'GET' }, function (err, res) {",
              "  pm.test('the create reached Kling with mode pro in its settings', function () {",
              "    pm.expect(err, String(err)).to.equal(null);",
              "    var calls = (res.json().data[0].calls || []).filter(function (c) { return c.method === 'POST' && /^\\/text-to-video\\//.test(c.path) && String((c.body && c.body.prompt) || '').indexOf('[pro-mode]') === 0; });",
              "    pm.expect(calls, JSON.stringify(res.json()).slice(0, 1500)).to.have.length(1);",
              "    pm.expect(calls[0].body.settings && calls[0].body.settings.mode, JSON.stringify(calls[0].body)).to.equal('pro');",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "571.4 kling GET /v1/videos/{id} reports the pro-mode task succeeded, so the job is due for settlement (video mode rate)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/videos/{{videoModeKlingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos",
            "{{videoModeKlingId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the retrieve reports the rendered duration with its fraction', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.status, pm.response.text()).to.eql('completed');",
              "  pm.expect(j.seconds, pm.response.text()).to.eql('5.1');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "571.5 the settled pro-mode Kling job is priced at the pro rate, $0.224 a second, not the unbanded $0.10 (video mode rate)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/logs?providers=kling&models=kling-3.0&limit=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "logs"
          ],
          "query": [
            {
              "key": "providers",
              "value": "kling"
            },
            {
              "key": "models",
              "value": "kling-3.0"
            },
            {
              "key": "limit",
              "value": "50"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var retry = Number(pm.collectionVariables.get('videoModeRetry') || 0);",
              "if (retry > 0) {",
              "  // The video sweeper ticks every 30 s; newman drains pending timers before it sends.",
              "  var until = Date.now() + 2000;",
              "  (function waitBeforeRetry() { if (Date.now() < until) { setTimeout(waitBeforeRetry, 100); } })();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('logs query responds', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text().slice(0, 400)).to.eql(200);",
              "});",
              "if (pm.response.code !== 200) { pm.collectionVariables.unset('videoModeRetry'); return; }",
              "// The settlement row is the one whose video_debug carries accounting; the submission and",
              "// the retrieve rows carry video_debug without it.",
              "var row = null;",
              "(pm.response.json().logs || []).forEach(function (l) {",
              "  var vd = l.video_debug;",
              "  if (!row && vd && vd.accounting && String(vd.video_id || '').indexOf('893605946402811987') === 0) { row = l; }",
              "});",
              "var retry = Number(pm.collectionVariables.get('videoModeRetry') || 0);",
              "if (!row && retry < 45) {",
              "  pm.collectionVariables.set('videoModeRetry', retry + 1);",
              "  postman.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "pm.collectionVariables.unset('videoModeRetry');",
              "pm.test('the job settled within 90 s of the retrieve', function () {",
              "  pm.expect(row, 'no settlement row: ' + pm.response.text().slice(0, 1500)).to.not.equal(null);",
              "});",
              "if (!row) { return; }",
              "pm.test('the settlement records the mode it priced', function () {",
              "  pm.expect(row.video_debug.accounting.mode, JSON.stringify(row.video_debug)).to.equal('pro');",
              "});",
              "// The fixture prices kling-3.0 at $0.10 a second unbanded and $0.224 in pro mode. Kling reports a 5.1 second",
              "// clip, settled at 5 whole seconds. Before TXE-7357 every mode billed the unbanded rate: 5 x 0.10 = 0.50.",
              "pm.test('priced at 5 s x $0.224, the fixture datasheet pro rate for kling-3.0', function () {",
              "  pm.expect(row.cost, JSON.stringify(row).slice(0, 1500)).to.be.closeTo(1.12, 1e-9);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "571.6 [EXPECT-200] teardown: provider job accounting is turned back off with the client config 571.1 kept, whatever the rows above did (video mode rate)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Bifrost-Setup-Token",
            "value": "bifrost-e2e-setup-token"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{videoModeOffBody}}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var saved = pm.collectionVariables.get('videoModeClientConfig');",
              "if (!saved) {",
              "  // 571.2 did not run either, so accounting was never turned on.",
              "  pm.execution.skipRequest();",
              "} else {",
              "  var cc = JSON.parse(saved);",
              "  cc.disable_provider_job_accounting = true;",
              "  pm.variables.set('videoModeOffBody', JSON.stringify({ client_config: cc }));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('videoModeRetry');",
              "pm.test('accounting turned back off', function () {",
              "  pm.expect(pm.response.code, pm.response.text().slice(0, 400)).to.eql(200);",
              "});",
              "pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/config', method: 'GET', header: { 'X-Bifrost-Setup-Token': 'bifrost-e2e-setup-token' } }, function (err, res) {",
              "  pm.test('accounting reads back off', function () {",
              "    pm.expect(err, 'gateway unreachable: ' + err).to.equal(null);",
              "    var j = res.json();",
              "    pm.expect(j.client_config && j.client_config.disable_provider_job_accounting, res.text().slice(0, 400)).to.equal(true);",
              "  });",
              "});",
              "pm.collectionVariables.unset('videoModeClientConfig');",
              "pm.collectionVariables.unset('videoModeKlingId');"
            ]
          }
        }
      ]
    }
  ]
}
