              "  pm.expect(pm.collectionVariables.get('mistralArrayTextResponsesAttempted'), 'run the full scoped chain').to.equal('1');",
              "  pm.expect(pm.collectionVariables.get('mistralArrayTextAnthropicAttempted'), 'run the full scoped chain').to.equal('1');",
              "  pm.expect(pm.collectionVariables.get('mistralArrayThinkingChatAttempted'), 'run the full scoped chain').to.equal('1');",
              "  pm.expect(pm.collectionVariables.get('mistralArrayMixedResponsesAttempted'), 'run the full scoped chain').to.equal('1');",
              "  pm.expect(pm.collectionVariables.get('mistralArrayReferenceAnthropicAttempted'), 'run the full scoped chain').to.equal('1');",
              "  pm.expect(pm.collectionVariables.get('mistralArrayThinkingResponsesAttempted'), 'run the full scoped chain').to.equal('1');",
              "  pm.expect(pm.collectionVariables.get('mistralArrayThinkingAnthropicAttempted'), 'run the full scoped chain').to.equal('1');",
              "  var rows = pm.response.json().requests;",
              "  pm.expect(rows.map(function (r) { return r.scenario; }), pm.response.text()).to.deep.equal(['text-chat','text-responses','text-anthropic','thinking-chat','mixed-responses','reference-anthropic','thinking-responses','thinking-anthropic']);",
