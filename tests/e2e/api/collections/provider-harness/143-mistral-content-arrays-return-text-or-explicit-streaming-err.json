    {
      "name": "Mistral SSE wire assertions (mistral-content-array)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var raw = pm.response.text();",
              "var route = pm.info.requestName.indexOf('[chat]') >= 0 ? 'chat' : (pm.info.requestName.indexOf('[responses]') >= 0 ? 'responses' : 'anthropic');",
              "var unsupported = pm.info.requestName.indexOf('unsupported') >= 0;",
              "var events = [];",
              "var doneMarkers = 0;",
              "pm.test('real streaming HTTP response and parseable SSE data', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + raw).to.equal(200);",
              "  pm.expect(pm.response.headers.get('Content-Type') || '', raw).to.include('text/event-stream');",
              "  raw.split(/\\r?\\n/).forEach(function (line) {",
              "    if (line.indexOf('data:') !== 0) return;",
              "    var value = line.slice(5).trim();",
              "    if (value === '[DONE]') { doneMarkers++; return; }",
              "    if (value) events.push(JSON.parse(value));",
              "  });",
              "  pm.expect(events.length, raw).to.be.above(0);",
              "});",
              "var errors = events.filter(function (e) { return e.error && typeof e.error.message === 'string'; });",
              "var completed = events.filter(function (e) { return e.type === 'response.completed' || e.type === 'message_stop'; });",
              "var text = '';",
              "var reasoning = '';",
              "events.forEach(function (e) {",
              "  if (route === 'chat') (e.choices || []).forEach(function (c) { if (!c.delta) return; if (typeof c.delta.content === 'string') text += c.delta.content; if (typeof c.delta.reasoning === 'string') reasoning += c.delta.reasoning; });",
              "  else if (route === 'responses' && e.type === 'response.output_text.delta') text += e.delta || '';",
              "  else if (route === 'responses' && e.type === 'response.reasoning_summary_text.delta') reasoning += e.delta || '';",
              "  else if (route === 'anthropic' && e.type === 'content_block_delta' && e.delta && e.delta.type === 'text_delta') text += e.delta.text || '';",
              "  else if (route === 'anthropic' && e.type === 'content_block_delta' && e.delta && e.delta.type === 'thinking_delta') reasoning += e.delta.thinking || '';",
              "});",
              "var thinking = pm.info.requestName.indexOf(' thinking-') >= 0;",
              "var nonce = pm.collectionVariables.get('mistralArrayNonce');",
              "pm.test('array content produces the promised successful or explicit error stream', function () {",
              "  if (unsupported) {",
              "    pm.expect(errors.length, raw).to.equal(1);",
              "    pm.expect(errors[0].error.message, raw).to.equal('failed to unmarshal response from provider API');",
              "    pm.expect(completed.length, 'unsupported content must not be reported completed: ' + raw).to.equal(0);",
              "    pm.expect(doneMarkers, 'failed stream must not claim a clean terminal marker: ' + raw).to.equal(0);",
              "    pm.expect(text, 'a mixed array must not leak a partial answer before rejecting its thinking block: ' + raw).to.equal('');",
              "    pm.expect(reasoning, 'a rejected array must not leak reasoning: ' + raw).to.equal('');",
              "  } else {",
              "    pm.expect(errors.length, raw).to.equal(0);",
              "    pm.expect(text, 'answer text after a thinking block must not be dropped: ' + raw).to.equal('mistral array fixture ' + nonce);",
              "    pm.expect(reasoning, 'thinking blocks must surface as reasoning: ' + raw).to.equal(thinking ? 'private reasoning ' + nonce : '');",
              "    if (route === 'chat') {",
              "      pm.expect(doneMarkers, raw).to.equal(1);",
              "      pm.expect(events.some(function (e) { return (e.choices || []).some(function (c) { return c.finish_reason === 'stop'; }); }), raw).to.equal(true);",
              "      pm.expect(events.some(function (e) { return e.usage && e.usage.total_tokens === 7; }), raw).to.equal(true);",
              "    } else if (route === 'responses') {",
              "      pm.expect(completed.length, raw).to.equal(1);",
              "      pm.expect(completed[0].response.status, raw).to.equal('completed');",
              "      pm.expect(completed[0].response.usage.total_tokens, raw).to.equal(7);",
              "      pm.expect(events.filter(function (e) { return e.type === 'response.output_text.done'; }).map(function (e) { return e.text; }), raw).to.deep.equal([text]);",
              "    } else {",
              "      pm.expect(completed.length, raw).to.equal(1);",
              "      var starts = events.filter(function (e) { return e.type === 'content_block_start'; });",
              "      var stops = events.filter(function (e) { return e.type === 'content_block_stop'; });",
              "      pm.expect(starts.map(function (e) { return e.content_block.type; }), raw).to.deep.equal(thinking ? ['thinking', 'text'] : ['text']);",
              "      pm.expect(stops.map(function (e) { return e.index; }), raw).to.deep.equal(starts.map(function (e) { return e.index; }));",
              "      var openIndex = null, openType = null;",
              "      var deltaTypes = { thinking: ['thinking_delta', 'signature_delta'], text: ['text_delta'] };",
              "      events.forEach(function (e) {",
              "        if (e.type === 'content_block_start') { openIndex = e.index; openType = e.content_block.type; }",
              "        if (e.type === 'content_block_delta') {",
              "          pm.expect(e.index, 'every delta targets the open block: ' + raw).to.equal(openIndex);",
              "          pm.expect(deltaTypes[openType] || [], e.delta.type + ' inside an open ' + openType + ' block: ' + raw).to.include(e.delta.type);",
              "        }",
              "        if (e.type === 'content_block_stop') { openIndex = null; openType = null; }",
              "      });",
              "      pm.expect(events.some(function (e) { return e.type === 'message_delta' && e.delta.stop_reason === 'end_turn' && e.usage.output_tokens === 2; }), raw).to.equal(true);",
              "    }",
              "  }",
              "});",
              "function collectFrames(value, out) {",
              "  if (typeof value === 'string') { try { collectFrames(JSON.parse(value), out); } catch (e) {} }",
              "  else if (Array.isArray(value)) value.forEach(function (v) { collectFrames(v, out); });",
              "  else if (value && typeof value === 'object' && value.choices) out.push(value);",
              "}",
              "if (route !== 'anthropic') pm.test('raw provider capture retains the original content array', function () {",
              "  var originals = [];",
              "  events.forEach(function (e) { collectFrames((e.extra_fields || {}).raw_response, originals); });",
              "  var arrays = originals.filter(function (e) { return (e.choices || []).some(function (c) { return c.delta && Array.isArray(c.delta.content); }); });",
              "  pm.expect(arrays.length, 'raw capture lost the actual upstream array: ' + raw).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
