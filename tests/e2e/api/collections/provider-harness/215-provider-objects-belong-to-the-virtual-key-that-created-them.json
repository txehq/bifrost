{
  "name": "215. Provider objects belong to the virtual key that created them (object-ownership) [SERIAL]",
  "description": "Two virtual keys share the operator's OpenAI key. A file uploaded under the first is a 404 to the second on retrieve, content and delete, and is missing from the second key's list, while the first key still retrieves, downloads, lists and deletes it. Files are the probe because they are free; the same binding covers videos, containers and cached contents.",
  "item": [
    {
      "name": "openai object-ownership setup: create virtual key A (owner)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The run id keeps parallel runs against one server from colliding on the key name.",
              "function startFresh() {",
              "  pm.collectionVariables.unset('objStaleFilePending');",
              "  pm.collectionVariables.unset('objOwnVkId');",
              "  pm.collectionVariables.unset('objOwnVkValue');",
              "  pm.collectionVariables.set('objOwnVkName', 'harness-object-ownership-A (owner)-run-' + Date.now() + '-' + pm.variables.replaceIn('{{$guid}}'));",
              "}",
              "// A key a previous run failed to delete is retained; delete it before this run replaces it.",
              "var staleVkId = pm.collectionVariables.get('objOwnVkId');",
              "if (!staleVkId) {",
              "  startFresh();",
              "} else {",
              "  var headers = {};",
              "  var managementToken = pm.environment.get('managementApiKey') || pm.collectionVariables.get('managementApiKey');",
              "  if (managementToken) { headers.Authorization = 'Bearer ' + managementToken; }",
              "  var deleteStaleKey = function () { pm.sendRequest({url: pm.variables.replaceIn('{{baseUrl}}') + '/api/governance/virtual-keys/' + staleVkId, method: 'DELETE', header: headers}, function (err, response) {",
              "    var deleted = !err && (response.code === 200 || response.code === 404);",
              "    pm.test('object-ownership: the retained virtual key A (owner) from an earlier run is deleted', function () {",
              "      pm.expect(err, 'stale key ' + staleVkId + ' delete errored: ' + err).to.equal(null);",
              "      pm.expect([200, 404], 'stale key ' + staleVkId + ' not deleted: ' + response.text()).to.include(response.code);",
              "    });",
              "    if (deleted) { startFresh(); return; }",
              "    pm.collectionVariables.unset('objOwnVkValue');",
              "    pm.execution.skipRequest();",
              "  }); };",
              "  var staleFileId = pm.collectionVariables.get('objFileId');",
              "  var staleVkValue = pm.collectionVariables.get('objOwnVkValue');",
              "  if (staleFileId && staleVkValue) {",
              "    // The retained owner key deletes the file it failed to delete last run. Until that succeeds the",
              "    // key, its value and the file id are the only cleanup handles, so setup stops and keeps them.",
              "    pm.sendRequest({url: pm.variables.replaceIn('{{baseUrl}}') + '/v1/files/' + staleFileId + '?provider=openai', method: 'DELETE', header: {Authorization: 'Bearer ' + staleVkValue}}, function (err, response) {",
              "      var gone = !err && (response.code === 200 || response.code === 404);",
              "      pm.test('object-ownership: the retained file from an earlier run is deleted', function () {",
              "        pm.expect(err, 'stale file ' + staleFileId + ' delete errored: ' + err).to.equal(null);",
              "        pm.expect([200, 404], 'stale file ' + staleFileId + ' not deleted: ' + response.text()).to.include(response.code);",
              "      });",
              "      if (!gone) { pm.collectionVariables.set('objStaleFilePending', '1'); pm.execution.skipRequest(); return; }",
              "      pm.collectionVariables.unset('objFileId');",
              "      pm.collectionVariables.unset('objStaleFilePending');",
              "      deleteStaleKey();",
              "    });",
              "  } else {",
              "    deleteStaleKey();",
              "  }",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('object-ownership: virtual key A (owner) created', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "});",
              "var vk = {};",
              "try { vk = pm.response.json().virtual_key || {}; } catch (e) { vk = {}; }",
              "pm.test('object-ownership: virtual key A (owner) has an id and a value', function () {",
              "  pm.expect(vk.id, 'no id: ' + pm.response.text()).to.be.a('string').and.not.equal('');",
              "  pm.expect(vk.value, 'no value: ' + pm.response.text()).to.be.a('string').and.not.equal('');",
              "});",
              "if (vk.id) { pm.collectionVariables.set('objOwnVkId', vk.id); }",
              "if (vk.value) { pm.collectionVariables.set('objOwnVkValue', vk.value); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"{{objOwnVkName}}\",\"provider_configs\":[{\"provider\":\"openai\",\"allowed_models\":[\"*\"],\"key_ids\":[\"*\"],\"weight\":1}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/governance/virtual-keys"
      },
      "response": []
    },
