    {
      "name": "openai object-ownership: the owning key uploads a file",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A retained file the setup could not delete keeps its id for the next run's cleanup.",
              "if (pm.collectionVariables.get('objStaleFilePending') === '1') { pm.execution.skipRequest(); return; }",
              "pm.collectionVariables.unset('objFileId');",
              "if (!pm.collectionVariables.get('objOwnVkValue') || !pm.collectionVariables.get('objOtherVkValue')) { pm.execution.skipRequest(); return; }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var txt = pm.response.text() || '';",
              "pm.test('object-ownership: upload under the owning key is 200', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + txt.slice(0, 400)).to.eql(200);",
              "});",
              "var j = {};",
              "try { j = pm.response.json() || {}; } catch (e) { j = {}; }",
              "pm.test('object-ownership: the upload has a file id', function () {",
              "  pm.expect(j.id, 'no id: ' + txt.slice(0, 400)).to.be.a('string').and.not.equal('');",
              "});",
              "if (j.id) { pm.collectionVariables.set('objFileId', j.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-bf-vk",
            "value": "{{objOwnVkValue}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "src": "tests/e2e/api/fixtures/sample.jsonl",
              "type": "file"
            },
            {
              "key": "purpose",
              "value": "batch",
              "type": "text"
            },
            {
              "key": "provider",
              "value": "openai",
              "type": "text"
            }
          ]
        },
        "url": "{{baseUrl}}/v1/files"
      },
      "response": []
    },
    {
      "name": "[EXPECT-404] openai object-ownership: another key cannot retrieve the file",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Without both keys and the uploaded file there is nothing to compare; the failed setup request already reports why.",
              "if (!pm.collectionVariables.get('objOwnVkValue') || !pm.collectionVariables.get('objOtherVkValue') || !pm.collectionVariables.get('objFileId')) { pm.execution.skipRequest(); return; }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var txt = pm.response.text() || '';",
              "// The file exists on the shared provider key; the other virtual key must get a 404, never the object",
              "// and never a 401/403/500 that would mean the request was refused for a different reason.",
              "pm.test('object-ownership: retrieve under another key is 404', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + txt.slice(0, 400)).to.eql(404);",
              "});",
              "pm.test('object-ownership: the 404 names the file as not found', function () {",
              "  var body = {};",
              "  try { body = pm.response.json() || {}; } catch (e) { body = {}; }",
              "  pm.expect(body.error && body.error.message, 'unexpected 404 body: ' + txt.slice(0, 400)).to.be.a('string');",
              "  pm.expect(body.error.message, 'unexpected message: ' + txt.slice(0, 400)).to.include('not found');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-bf-vk",
            "value": "{{objOtherVkValue}}"
          }
        ],
        "url": "{{baseUrl}}/v1/files/{{objFileId}}?provider=openai"
      },
      "response": []
    },
