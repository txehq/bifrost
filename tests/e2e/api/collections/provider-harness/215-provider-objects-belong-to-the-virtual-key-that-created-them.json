              "});",
              "if (vk.id) { pm.collectionVariables.set('objOtherVkId', vk.id); }",
              "if (vk.value) { pm.collectionVariables.set('objOtherVkValue', vk.value); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"{{objOtherVkName}}\",\"provider_configs\":[{\"provider\":\"openai\",\"allowed_models\":[\"*\"],\"key_ids\":[\"*\"],\"weight\":1}]}",
          "options": {
