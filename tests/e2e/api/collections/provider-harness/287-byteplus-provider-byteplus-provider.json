{
  "name": "287. BytePlus provider (byteplus provider)",
  "description": "BytePlus ModelArk is reached through Ark's OpenAI-compatible /api/v3/chat/completions, its native /api/v3/responses, /api/v3/embeddings/multimodal for embeddings and /api/v3/images/generations for Seedream generation and editing. Bifrost maps reasoning_effort none to thinking disabled and clamps xhigh/max to high, since Ark rejects both. The multimodal embedding endpoint fuses a request into one vector, so Bifrost sends one call per input entry. Seedance video generation is billed per clip, so it is covered by Go tests and not by a live case here. Every model used here must be activated on the account, or Ark answers 404 ModelNotOpen.",
  "item": [
    {
      "name": "/v1/chat/completions - Seed answers through the Ark chat API - byteplus/deepseek-v4-flash-260425",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('answer served by byteplus with usage', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.choices[0].message.content, 'empty content: ' + pm.response.text()).to.include('391');",
              "  pm.expect(j.extra_fields.provider).to.eql('byteplus');",
              "  pm.expect(j.usage.total_tokens, 'usage missing').to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"byteplus/deepseek-v4-flash-260425\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"What is 17 * 23? Answer with just the number.\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "chat",
            "completions"
          ]
        }
      }
    },
