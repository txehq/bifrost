    {
      "name": "/v1/images/generations stream - the Seedream image arrives as its own event - byteplus/seedream-4-5-251128",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('stream relays the image and ends with completed', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var text = pm.response.text();",
              "  var partials = text.match(/\"type\":\"image_generation\\.partial_image\"/g) || [];",
              "  pm.expect(partials.length, 'one image asked for, one partial_image event: ' + text.slice(0, 500)).to.equal(1);",
              "  var completed = text.split('\\n').filter(function (l) { return l.indexOf('data:') === 0 && l.indexOf('\"type\":\"image_generation.completed\"') !== -1; }).map(function (l) { return JSON.parse(l.slice(5)); })[0];",
              "  pm.expect(completed && completed.usage, 'the completed event carries usage: ' + text.slice(-500)).to.be.an('object');",
              "  pm.expect(completed.usage.output_images, 'every delivered image was relayed: completed usage.output_images equals the partial_image events: ' + text.slice(-500)).to.equal(partials.length);",
              "  var completedAt = text.lastIndexOf('\"type\":\"image_generation.completed\"');",
              "  pm.expect(completedAt, 'no completed event: ' + text.slice(-500)).to.be.above(-1);",
              "  pm.expect(completedAt, 'completed must follow every partial_image: ' + text.slice(-500)).to.be.above(text.lastIndexOf('\"type\":\"image_generation.partial_image\"'));",
              "  pm.expect(text, 'no image payload in stream').to.match(/\"(url|b64_json)\":\"[^\"]+\"/);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
