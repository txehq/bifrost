              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  var rr = j.extra_fields && j.extra_fields.raw_request;",
              "  if (typeof rr === 'string') { try { rr = JSON.parse(rr); } catch (e) { rr = null; } }",
              "  pm.expect(rr, 'raw_request missing or unparseable - x-bf-send-back-raw-request not honored: ' + pm.response.text().slice(0, 300)).to.be.an('object');",
              "  pm.expect(rr.size, 'size sent to Ark: ' + JSON.stringify(rr)).to.eql('2K');",
              "  pm.expect(rr, 'resolution must not reach Ark as an unknown field').to.not.have.property('resolution');",
              "  pm.expect((j.data || []).length, 'no images: ' + pm.response.text().slice(0, 500)).to.be.above(0);",
              "  pm.expect(j.usage && j.usage.output_images, 'usage.output_images: ' + JSON.stringify(j.usage)).to.eql(j.data.length);",
              "});"
            ]
          }
        }
