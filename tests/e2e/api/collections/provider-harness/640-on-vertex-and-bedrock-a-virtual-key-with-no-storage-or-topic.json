      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "  return;",
              "}",
              "if (!pm.collectionVariables.get('denyVkOpen') || !pm.collectionVariables.get('denyVkListed')) { pm.execution.skipRequest(); return; }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var txt = pm.response.text() || '';",
              "pm.test('an s3:// input from a key with no storage list is a 400 caller_unsupported_parameter naming storage_location', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + txt.slice(0, 400)).to.eql(400);",
              "  var j = {}; try { j = pm.response.json() || {}; } catch (e) { j = {}; }",
              "  pm.expect((j.extra_fields || {}).error_type, txt.slice(0, 400)).to.eql('caller_unsupported_parameter');",
              "  pm.expect(pm.response.headers.get('x-bifrost-error-type'), 'the header carries the same value').to.eql('caller_unsupported_parameter');",
              "  pm.expect((j.error || {}).param, txt.slice(0, 400)).to.eql('storage_location');",
              "  pm.expect(txt, 'the refusal names the list that would allow it').to.include('allowed_storage_prefixes');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-bf-vk",
            "value": "{{denyVkOpen}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"model\":\"bedrock/amazon.nova-lite-v1:0\",\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Describe this.\"},{\"type\":\"image_url\",\"image_url\":{\"url\":\"s3://bifrost-fixture-bucket/tenant-a/in.png\"}}]}]}",
