      "name": "212.5 vertex claude streamRawPredict via /genai_passthrough/v1beta1 stays on v1 - genai-interactions-passthrough",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"anthropic_version\": \"vertex-2023-10-16\",\n  \"max_tokens\": 16,\n  \"stream\": true,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Reply with exactly: OK\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/genai_passthrough/v1beta1/projects/{{vertexProject}}/locations/{{vertexLocation}}/publishers/anthropic/models/claude-sonnet-4-6:streamRawPredict",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "genai_passthrough",
            "v1beta1",
            "projects",
            "{{vertexProject}}",
            "locations",
            "{{vertexLocation}}",
            "publishers",
            "anthropic",
            "models",
            "claude-sonnet-4-6:streamRawPredict"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Interactions needs the client's v1beta1, but model calls must keep the v1 they have always used:",
              "// Google answers 500 \"Failed to process request\" to Claude streamRawPredict on v1beta1 (v1 and unary",
              "// rawPredict are fine), so honoring v1beta1 for model paths broke AnthropicVertex clients whose base URL ends in /v1beta1.",
              "var body = pm.response.text() || '';",
              "pm.test('vertex claude v1beta1 stream: 200 - genai-interactions-passthrough', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + body.slice(0, 400)).to.eql(200);",
              "});",
              "if (pm.response.code !== 200) { return; }",
              "pm.test('vertex claude v1beta1 stream: served by vertex - genai-interactions-passthrough', function () {",
              "  pm.expect(pm.response.headers.get('x-bifrost-provider'), body.slice(0, 400)).to.eql('vertex');",
              "});",
              "pm.test('vertex claude v1beta1 stream: SSE runs to message_stop - genai-interactions-passthrough', function () {",
              "  pm.expect(body, body.slice(0, 400)).to.include('message_start');",
              "  pm.expect(body, body.slice(-400)).to.include('message_stop');",
              "});"
            ]
          }
        }
      ]
    },
