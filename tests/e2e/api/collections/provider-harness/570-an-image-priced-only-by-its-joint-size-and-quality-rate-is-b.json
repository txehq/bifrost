        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the client gets 200 with one image', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  pm.expect(pm.response.json().data, pm.response.text()).to.be.an('array').with.length(1);",
              "});",
              "pm.test('the response carries the resolution the image was priced by', function () {",
              "  pm.expect(pm.response.json().resolution, pm.response.text()).to.eql(\"4K\");",
              "});",
              "pm.sendRequest({ url: pm.variables.get('providerErrorFixtureUrl') + '/__wire', method: 'GET' }, function (err, res) {",
              "  pm.test('Replicate received resolution 4K', function () {",
              "    pm.expect(err, String(err)).to.equal(null);",
              "    var calls = res.json().data[0].calls.filter(function (c) { return /\\/fixture\\/poll-origin\\/predictions$/.test(c.path); });",
              "    pm.expect(calls.length, JSON.stringify(res.json()).slice(0, 1500)).to.be.above(0);",
              "    var sent = JSON.parse(calls[calls.length - 1].body);",
              "    pm.expect(sent.input && sent.input.resolution, calls[calls.length - 1].body).to.eql(\"4K\");",
              "  });",
              "});",
