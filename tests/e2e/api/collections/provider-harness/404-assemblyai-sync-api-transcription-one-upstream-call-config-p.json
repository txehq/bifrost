    {
      "name": "404.3 the assemblyai transcription reached the Sync API exactly once, with X-AAI-Model, an audio part and a config part",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var calls = pm.response.json().data[0].calls;",
              "pm.test('exactly one upstream call (contract C3)', function () {",
              "  pm.expect(calls, pm.response.text()).to.be.an('array').with.lengthOf(1);",
              "});",
              "var call = calls[0] || { parts: [] };",
              "pm.test('the model is the X-AAI-Model header and the key is the bare Authorization value', function () {",
              "  pm.expect(call.model, JSON.stringify(call)).to.eql('universal-3-5-pro');",
              "  pm.expect(call.authorization, JSON.stringify(call)).to.eql('aai-fixture-key');",
              "});",
              "pm.test('an audio part with the audio Content-Type, then a JSON config part', function () {",
              "  pm.expect(call.parts.map(function (p) { return p.name; }), JSON.stringify(call.parts)).to.eql(['audio', 'config']);",
              "  pm.expect(call.parts[0].contentType, JSON.stringify(call.parts[0])).to.eql('audio/mpeg');",
              "  pm.expect(call.parts[0].bytes, 'audio bytes').to.be.above(1000);",
              "  pm.expect(call.parts[1].contentType, JSON.stringify(call.parts[1])).to.eql('application/json');",
              "});",
              "pm.test('unified fields and extra fields reach the config unchanged (contract C4)', function () {",
              "  var config = JSON.parse(call.parts[1].text);",
              "  pm.expect(config, call.parts[1].text).to.eql({",
              "    prompt: 'A fable about a fox.',",
              "    language_codes: ['en'],",
              "    timestamps: true,",
              "    keyterms_prompt: ['Bifrost', 'Tokun'],",
              "    sample_rate: 16000",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{providerErrorFixtureUrl}}/__assemblyai"
      }
