{
  "name": "233. Agent and skills endpoints require an explicit public url [SERIAL]",
  "description": "Uses the unchanged tests/integrations/python/config.json profile: a2a_external_client_url and skills_external_client_url must be unset, enforce_auth_on_inference must be false, Git must be installed, and management requests require the configured setup token. These checks make no configuration mutations and no provider calls. They pin fail-closed serving for cards, JSON-RPC, REST, push ingress, and Claude/Codex catalogs and Git endpoints, while agent management remains available. Set URLs in a separate configured run to test enabled serving; Go regressions cover that behavior and spoofed headers.",
  "item": [
    {
      "name": "233.1 explicit public url GET /agents/a2a/url-gate-fixture/.well-known/agent-card.json [EXPECT-503]",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Missing public URL disables this endpoint', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(503);",
              "  pm.expect(pm.response.text()).to.include('a2a_external_client_url');",
              "  pm.expect(pm.response.text()).not.to.include('attacker.example');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Forwarded-Host",
            "value": "attacker.example"
          },
          {
            "key": "X-Forwarded-Proto",
            "value": "https"
          }
        ],
        "url": "{{baseUrl}}/agents/a2a/url-gate-fixture/.well-known/agent-card.json"
      }
    },
