              "  pm.expect(result.protocolVersion, 'protocolVersion missing: ' + pm.response.text()).to.be.a('string');",
              "  pm.expect(result.serverInfo, 'serverInfo missing: ' + pm.response.text()).to.be.an('object');",
              "  pm.expect(result.capabilities, 'capabilities missing: ' + pm.response.text()).to.be.an('object');",
              "});"
            ]
