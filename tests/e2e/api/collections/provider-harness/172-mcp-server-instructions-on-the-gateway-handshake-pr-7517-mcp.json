{
  "name": "172. MCP server instructions on the gateway handshake (PR #7517) (mcp-server-instructions)",
  "description": "Gateway regression for PR #7517 (with #7516 capture). An upstream MCP server may return an `instructions` string from its initialize handshake; Bifrost captures it, aggregates the instructions of every upstream the caller may see, labels each block with its source client, and returns the result on the hosted /mcp handshake via an AfterInitialize hook. Nothing in this collection covered that before: `mcp_server name=` and `initialize` both appeared zero times. These cases pin that the field survives the real SSE transport end to end and that forwarding does not disturb tool discovery. Requires the harness MCP fixture (examples/mcps/remote-test-server, the sse_mcp client at :3012) to be running; it advertises a default instruction string, overridable with MCP_INSTRUCTIONS. No provider calls are made and no tokens are spent - openai is only a harness filter label. Run with FEATURE=mcp-server-instructions.",
  "item": [
    {
      "name": "[EXPECT-200] openai mcp-server-instructions initialize forwards upstream instructions - PR #7517",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json, text/event-stream"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"harness\",\"version\":\"1\"}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/mcp"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The gateway may answer JSON-RPC as plain JSON or as an SSE 'data:' frame.",
              "function rpcResult(res) {",
              "  var text = res.text();",
              "  var line = text;",
              "  if (text.indexOf('data:') !== -1) {",
              "    var lines = text.split('\\n');",
              "    for (var i = 0; i < lines.length; i++) {",
              "      var t = lines[i].replace(/^data:\\s*/, '').trim();",
              "      if (t.charAt(0) === '{') { line = t; break; }",
              "    }",
              "  }",
              "  return JSON.parse(line).result;",
              "}",
              "",
              "pm.test('initialize carries the upstream instructions, labeled by source client', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "  var result = rpcResult(pm.response);",
              "  pm.expect(result, 'no JSON-RPC result: ' + pm.response.text()).to.be.an('object');",
              "  pm.expect(result.instructions, 'instructions missing - the upstream advertised none, or forwarding regressed: ' + pm.response.text()).to.be.a('string');",
              "  pm.expect(result.instructions.length, 'instructions present but empty: ' + pm.response.text()).to.be.above(0);",
              "  // Each upstream's text is wrapped and attributed, so one server's guidance cannot be",
              "  // mistaken for another's. sse_mcp is the harness fixture's client name.",
              "  pm.expect(result.instructions, 'instructions not attributed to a source client: ' + result.instructions).to.include('<mcp_server name=\"sse_mcp\">');",
              "});"
            ]
          }
        }
      ]
    },
    {
