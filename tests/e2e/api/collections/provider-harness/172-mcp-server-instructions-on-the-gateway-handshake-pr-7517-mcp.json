              "}",
              "",
              "pm.test('tools still list while instructions are forwarded', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "  var result = rpcResult(pm.response);",
              "  pm.expect(result.tools, 'tools missing: ' + pm.response.text()).to.be.an('array');",
              "  pm.expect(result.tools.length, 'instructions forwarding must not empty the tool set: ' + pm.response.text()).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    }
  ]
