{
  "name": "Code mode execution budget",
  "description": "Requires the default Starlark code-mode implementation. Exercises local computations only, with no upstream provider requests.",
  "item": [
    {
      "name": "[EXPECT-200] openai code-mode-budget step-limit",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('code-mode-budget step-limit', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  pm.expect(pm.response.text()).to.include(\"step\");",
              "  pm.expect(pm.response.json().is_error === true).to.equal(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/mcp/tool/execute",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "mcp",
            "tool",
            "execute"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"code-mode-budget-step-limit\",\n  \"type\": \"function\",\n  \"function\": {\n    \"name\": \"executeToolCode\",\n    \"arguments\": \"{\\\"code\\\": \\\"result = 0\\\\nfor i in range(2000000):\\\\n    result += i\\\"}\"\n  }\n}"
        }
      }
    },
    {
      "name": "[EXPECT-200] openai code-mode-budget allocation-limit",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('code-mode-budget allocation-limit', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  pm.expect(pm.response.text()).to.include(\"resource limit\");",
              "  pm.expect(pm.response.json().is_error === true).to.equal(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/mcp/tool/execute",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "mcp",
            "tool",
            "execute"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"code-mode-budget-allocation-limit\",\n  \"type\": \"function\",\n  \"function\": {\n    \"name\": \"executeToolCode\",\n    \"arguments\": \"{\\\"code\\\": \\\"result = len([0] * 200000000)\\\"}\"\n  }\n}"
        }
      }
    },
    {
      "name": "[EXPECT-200] openai code-mode-budget recovery",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('code-mode-budget recovery', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  pm.expect(pm.response.text()).to.include(\"42\");",
              "  pm.expect(pm.response.json().is_error === true).to.equal(false);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/mcp/tool/execute",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "mcp",
            "tool",
            "execute"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"code-mode-budget-recovery\",\n  \"type\": \"function\",\n  \"function\": {\n    \"name\": \"executeToolCode\",\n    \"arguments\": \"{\\\"code\\\": \\\"result = 6 * 7\\\"}\"\n  }\n}"
        }
      }
    },
    {
      "name": "[EXPECT-200] openai code-mode-budget try-except-hint",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Canonical's parser reports try as an illegal token; the hint must still explain that Starlark has no exception handling.",
              "// It must also show the check that catches a failed call, which reaches the script as an error value, never a dict.",
              "pm.test('code-mode-budget try-except-hint', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  pm.expect(pm.response.json().is_error, pm.response.text()).to.equal(true);",
              "  pm.expect(pm.response.text()).to.include('does NOT support try/except');",
              "  var content = String(pm.response.json().content || '');",
              "  pm.expect(content, 'the hint does not show the failed-call check: ' + content).to.include('if hasattr(r, \"error\"):');",
              "  pm.expect(content, 'the hint still checks for a dict: ' + content).to.not.include('\"error\" in result');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/mcp/tool/execute",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "mcp",
            "tool",
            "execute"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"code-mode-budget-try-except-hint\",\n  \"type\": \"function\",\n  \"function\": {\n    \"name\": \"executeToolCode\",\n    \"arguments\": \"{\\\"code\\\": \\\"try:\\\\n    x = 1\\\\nexcept:\\\\n    x = 0\\\"}\"\n  }\n}"
        }
      }
    }
  ]
}
