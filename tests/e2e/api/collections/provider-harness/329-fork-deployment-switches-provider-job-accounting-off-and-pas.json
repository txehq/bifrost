    {
      "name": "329.11 the openai passthrough stream reached the caller byte for byte: the body equals what the fixture sent (passthrough heartbeat switch)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
