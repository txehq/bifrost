          "mode": "raw",
          "raw": "{\n  \"model\": \"openai/sora-fixture\",\n  \"prompt\": \"A paper boat drifts across a still pond at dawn\",\n  \"seconds\": \"4\",\n  \"size\": \"720x1280\"\n}"
