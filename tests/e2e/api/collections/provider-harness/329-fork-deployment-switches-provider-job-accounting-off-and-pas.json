    {
      "name": "329.10 openai passthrough SSE stream idle for 2.5 seconds reaches the caller without a heartbeat (passthrough heartbeat switch)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
