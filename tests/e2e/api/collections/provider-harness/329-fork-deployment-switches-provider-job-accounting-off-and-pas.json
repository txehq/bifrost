          "mode": "raw",
          "raw": "{\n  \"model\": \"openai/upstream-ok~batch\",\n  \"endpoint\": \"/v1/chat/completions\",\n  \"completion_window\": \"24h\",\n  \"requests\": [\n    {\n      \"custom_id\": \"fixture-1\",\n      \"method\": \"POST\",\n      \"url\": \"/v1/chat/completions\",\n      \"body\": {\n        \"model\": \"upstream-ok~batch\",\n        \"messages\": [\n          {\n            \"role\": \"user\",\n            \"content\": \"hi\"\n          }\n        ],\n        \"max_tokens\": 8\n      }\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "329.5 openai video and batch creates reached the fixture once each, and 70 seconds later nothing else has: no vendor call between requests (job accounting switch)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var h = pm.response.json().data[0].hits;",
              "pm.test('only the creates reached the fixture so far', function () {",
              "  pm.expect(h['video.create'], JSON.stringify(h)).to.equal(1);",
              "  pm.expect(h['batch.create'], JSON.stringify(h)).to.equal(1);",
              "  pm.expect(h['file.upload'], 'an inline batch uploads its JSONL once: ' + JSON.stringify(h)).to.equal(1);",
              "  pm.expect(h['video.retrieve'], JSON.stringify(h)).to.equal(undefined);",
              "  pm.expect(h['batch.retrieve'], JSON.stringify(h)).to.equal(undefined);",
              "});",
              "// Longer than both sweeper ticks (one minute for batches, 30 seconds for videos) and than the",
              "// first poll each kind schedules at create. With accounting on, the video sweeper would have",
              "// asked the fixture for the task by now; with it off, nothing but the caller ever does.",
              "setTimeout(function () {",
              "  pm.sendRequest({ url: pm.variables.get('providerErrorFixtureUrl') + '/__hits', method: 'GET' }, function (err, res) {",
              "    pm.test('after 70 s no poll, download or results fetch reached the fixture', function () {",
              "      pm.expect(err, 'fixture unreachable: ' + err).to.equal(null);",
              "      var later = res.json().data[0].hits;",
              "      pm.expect(later['video.create'], JSON.stringify(later)).to.equal(1);",
              "      pm.expect(later['batch.create'], JSON.stringify(later)).to.equal(1);",
              "      pm.expect(later['file.upload'], JSON.stringify(later)).to.equal(1);",
              "      pm.expect(later['video.retrieve'], 'the video sweeper polled: ' + JSON.stringify(later)).to.equal(undefined);",
              "      pm.expect(later['video.content'], 'the video sweeper downloaded: ' + JSON.stringify(later)).to.equal(undefined);",
              "      pm.expect(later['batch.retrieve'], 'the batch sweeper polled: ' + JSON.stringify(later)).to.equal(undefined);",
              "      pm.expect(later['file.content'], 'the batch sweeper fetched results: ' + JSON.stringify(later)).to.equal(undefined);",
              "    });",
              "  });",
              "}, 70000);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{providerErrorFixtureUrl}}/__hits"
      }
    },
