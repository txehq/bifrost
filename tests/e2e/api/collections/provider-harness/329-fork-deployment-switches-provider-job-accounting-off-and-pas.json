        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var body = pm.response.text();",
              "pm.test('the stream is SSE and carries no gateway heartbeat', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + body.slice(0, 300)).to.eql(200);",
              "  pm.expect(pm.response.headers.get('Content-Type') || '', 'content type').to.include('text/event-stream');",
              "  pm.expect(body, 'a gateway heartbeat comment was added').to.not.include(': heartbeat');",
              "  pm.expect(body, 'the vendor stream ended').to.include('data: [DONE]');",
