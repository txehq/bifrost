          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var sent = pm.response.json().data[0];",
              "var relayed = pm.collectionVariables.get('fixtureSwitchPassthroughBody');",
              "pm.test('the caller read exactly the vendor bytes', function () {",
              "  pm.expect(sent.body, 'the fixture recorded no stream for upstream-idle-stream').to.be.a('string').that.is.not.empty;",
