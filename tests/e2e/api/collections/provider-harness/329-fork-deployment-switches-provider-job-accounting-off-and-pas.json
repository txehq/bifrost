              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "pm.test('counters cleared', function () { pm.expect(j.data[0].reset, pm.response.text()).to.equal(true); });",
              "pm.collectionVariables.unset('fixtureSwitchVideoId');",
              "pm.collectionVariables.unset('fixtureSwitchBatchId');",
              "pm.collectionVariables.unset('fixtureSwitchPassthroughBody');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{providerErrorFixtureUrl}}/__reset"
      }
    },
    {
