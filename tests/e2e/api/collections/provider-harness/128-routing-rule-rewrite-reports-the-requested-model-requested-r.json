              "  pm.expect(pm.response.code, 'failed: ' + text).to.equal(200);",
              "  pm.expect(pm.response.json().choices, 'no choices: ' + text).to.be.an('array').that.is.not.empty;",
              "});",
              "pm.test('headers report the routed model and the model the caller sent', function () {",
              "  pm.expect(pm.response.headers.get('x-bifrost-routing-info-model'), 'routed model header: ' + text).to.equal('gpt-4o-mini');",
              "  pm.expect(pm.response.headers.get('x-bifrost-routing-info-requested-model'), 'requested model header: ' + text).to.equal('harness-requested-route-alias');",
              "  pm.expect(pm.response.headers.get('x-bifrost-routing-info-requested-provider'), 'requested provider header: ' + text).to.equal('openai');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-harness-requested-route",
            "value": "rewrite"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"openai/harness-requested-route-alias\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Reply OK.\"\n    }\n  ],\n  \"max_tokens\": 8,\n  \"stream\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/openai/v1/chat/completions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "openai",
            "v1",
            "chat",
            "completions"
          ]
        }
      }
    }
  ]
