              "var h = pm.response.json().data[0].hits;",
              "var video = {};",
              "Object.keys(h).forEach(function (k) { if (k.indexOf('videos ') === 0) { video[k] = h[k]; } });",
              "pm.test('two queries used video-key-b, one used video-key-a, and nothing else reached /v1/videos', function () {",
              "  pm.expect(video, JSON.stringify(h)).to.eql({ 'videos GET video-secret-b': 2, 'videos GET video-secret-a': 1 });",
              "});"
            ]
          }
        }
