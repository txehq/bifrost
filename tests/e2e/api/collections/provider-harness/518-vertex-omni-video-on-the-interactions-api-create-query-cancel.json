              "  pm.expect(j.provider_status, 'provider_status: ' + pm.response.text()).to.eql('cancelled');",
              "});",
              "var VX = pm.variables.get('vertexEndpointFixtureUrl') || 'http://127.0.0.1:8792';",
              "pm.sendRequest({ url: VX + '/__connects', method: 'GET' }, function (err, res) {",
