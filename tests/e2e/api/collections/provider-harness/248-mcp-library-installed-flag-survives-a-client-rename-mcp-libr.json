          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('client is deleted', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.eql(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/mcp/client/{{libInstalledClientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "mcp",
            "client",
            "{{libInstalledClientId}}"
          ]
        }
      }
    },
    {
      "name": "openai mcp-library-installed entry reports not installed once the client is gone - #8548",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('library list is a 200', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.eql(200);",
              "});",
              "var entryId = Number(pm.collectionVariables.get('libInstalledEntryId'));",
              "var servers = (pm.response.json() || {}).servers || [];",
              "var entry = servers.filter(function (s) { return s.id === entryId; })[0];",
              "pm.test('with no client left the entry is not installed', function () {",
              "  pm.expect(entry, 'entry missing from ' + pm.response.text().slice(0, 500)).to.be.an('object');",
              "  pm.expect(entry.installed, JSON.stringify(entry)).to.equal(false);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/mcp/library?search={{libInstalledEntryName}}&limit=100",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "mcp",
            "library"
          ],
          "query": [
            {
              "key": "search",
              "value": "{{libInstalledEntryName}}"
            },
            {
              "key": "limit",
              "value": "100"
            }
          ]
        }
      }
    },
    {
      "name": "openai mcp-library-installed cleanup removes the library entry - #8548",
      "event": [
