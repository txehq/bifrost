              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/mcp/library/{{libInstalledEntryId}}",
          "host": [
            "{{baseUrl}}"
          ],
