      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('client is created', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.eql(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_id\": \"{{libInstalledClientId}}\",\n  \"name\": \"{{libInstalledClientName}}\",\n  \"connection_type\": \"openapi\",\n  \"auth_type\": \"none\",\n  \"tools_to_execute\": [\n    \"listPets\"\n  ],\n  \"openapi_config\": {\n    \"spec\": \"{\\\"openapi\\\":\\\"3.0.3\\\",\\\"info\\\":{\\\"title\\\":\\\"Harness Library Installed\\\",\\\"version\\\":\\\"1.0.0\\\"},\\\"servers\\\":[{\\\"url\\\":\\\"https://petstore3.swagger.io/api/v3\\\"}],\\\"paths\\\":{\\\"/pet/findByStatus\\\":{\\\"get\\\":{\\\"operationId\\\":\\\"listPets\\\",\\\"responses\\\":{\\\"200\\\":{\\\"description\\\":\\\"ok\\\"}}}}}}\",\n    \"base_url\": \"https://petstore3.swagger.io/api/v3\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/mcp/client",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "mcp",
            "client"
          ]
        }
      }
    },
    {
      "name": "openai mcp-library-installed rename the client - #8548",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('client is renamed', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.eql(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{libInstalledRenamed}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/mcp/client/{{libInstalledClientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "mcp",
            "client",
            "{{libInstalledClientId}}"
          ]
        }
      }
    },
    {
      "name": "openai mcp-library-installed entry still reports installed after the rename - #8548",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('library list is a 200', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.eql(200);",
              "});",
              "var entryId = Number(pm.collectionVariables.get('libInstalledEntryId'));",
              "var servers = (pm.response.json() || {}).servers || [];",
              "var entry = servers.filter(function (s) { return s.id === entryId; })[0];",
              "pm.test('the renamed client still marks the entry installed', function () {",
              "  pm.expect(entry, 'entry missing from ' + pm.response.text().slice(0, 500)).to.be.an('object');",
              "  pm.expect(entry.installed, JSON.stringify(entry)).to.equal(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/mcp/library?search={{libInstalledEntryName}}&limit=100",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "mcp",
            "library"
          ],
          "query": [
            {
              "key": "search",
              "value": "{{libInstalledEntryName}}"
            },
            {
              "key": "limit",
              "value": "100"
            }
          ]
        }
      }
    },
    {
      "name": "openai mcp-library-installed delete the client - #8548",
      "event": [
