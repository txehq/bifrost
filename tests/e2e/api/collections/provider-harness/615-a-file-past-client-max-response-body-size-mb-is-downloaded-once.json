{
  "name": "615. A file past client.max_response_body_size_mb is downloaded once across a provider's keys, and the refusal is returned (key-walk-limit) [SERIAL]",
  "description": "Local fixture regression for TXE-7301, no live provider calls. Run with the provider error fixture and the gateway on tests/e2e/api/provider_config/provider-error-fixture.config.json and providerErrorFixture=1; every case is skipped otherwise. [SERIAL]: it lowers client.max_response_body_size_mb to 1 MB, which every other row's answers are read under, so the harness runs it alone and it restores the stored value at the end. openai_keywalk is an openai-based provider with two keys at /pp/keywalk, and each answers file keywalk-oversize with 2 MiB. A multi-key operation walks the keys; before, the walk recorded the refusal and downloaded the same file again with the next key. The content request must come back as is_bifrost_error with error_type bifrost_internal, naming the limit, after one download in all.",
  "item": [
    {
      "name": "615.1 [EXPECT-200] read the stored client config (key-walk-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "pm.test('key-walk-limit: read the stored client config', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  var cc = pm.response.json().client_config;",
              "  pm.expect(cc, pm.response.text()).to.be.an('object');",
              "  // A fresh install reads back log_retention_days 0, which PUT /api/config refuses (must be >= 1).",
              "  if (!cc.log_retention_days || cc.log_retention_days < 1) { cc.log_retention_days = 30; }",
              "  pm.collectionVariables.set('kwlClientConfig', JSON.stringify(cc));",
              "  pm.collectionVariables.set('kwlOriginal', String(cc.max_response_body_size_mb || 0));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/config?from_db=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ],
          "query": [
            {
              "key": "from_db",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "615.2 [EXPECT-200] lower client.max_response_body_size_mb to 1 MB (key-walk-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var cc = JSON.parse(pm.collectionVariables.get('kwlClientConfig') || '{}');",
              "cc.max_response_body_size_mb = 1;",
              "pm.variables.set('kwlBody', JSON.stringify({ client_config: cc }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "pm.test('key-walk-limit: limit lowered to 1 MB', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{kwlBody}}"
        }
      }
    },
    {
      "name": "615.3 fixture hit counters reset (key-walk-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "pm.test('counters cleared', function () { pm.expect(pm.response.json().data[0].reset, pm.response.text()).to.equal(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__reset",
          "host": [
            "{{providerErrorFixtureUrl}}"
          ],
          "path": [
            "__reset"
          ]
        }
      }
    },
    {
      "name": "615.4 [EXPECT-500] openai_keywalk file content past the limit is the gateway's refusal (key-walk-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var text = pm.response.text();",
              "pm.test('a 2 MiB file fails as the gateway\\'s own refusal, not a later key\\'s error', function () {",
              "  pm.expect(pm.response.code, text.slice(0, 400)).to.be.at.least(500);",
              "  var j = pm.response.json();",
              "  pm.expect(j.is_bifrost_error, text).to.equal(true);",
              "  pm.expect(j.extra_fields && j.extra_fields.error_type, text).to.equal('bifrost_internal');",
              "  pm.expect(j.error.message, text).to.include('limit 1 MiB');",
              "});",
              "pm.test('the file is not passed on', function () { pm.expect(text.length, 'response is ' + text.length + ' bytes').to.be.below(65536); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/files/keywalk-oversize/content?provider=openai_keywalk",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "files",
            "keywalk-oversize",
            "content"
          ],
          "query": [
            {
              "key": "provider",
              "value": "openai_keywalk"
            }
          ]
        }
      }
    },
    {
      "name": "615.5 [EXPECT-200] the file was downloaded once, with one key (key-walk-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var hits = pm.response.json().data[0].hits;",
              "var a = hits['keywalk.keywalk-key-a'] || 0, b = hits['keywalk.keywalk-key-b'] || 0;",
              "pm.test('one download in all: the walk stopped at the first key\\'s refusal', function () {",
              "  pm.expect(a + b, JSON.stringify(hits)).to.equal(1);",
              "  pm.expect(hits['keywalk.unknown'] || 0, JSON.stringify(hits)).to.equal(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{providerErrorFixtureUrl}}/__hits",
          "host": [
            "{{providerErrorFixtureUrl}}"
          ],
          "path": [
            "__hits"
          ]
        }
      }
    },
    {
      "name": "615.6 [EXPECT-200] restore client.max_response_body_size_mb (key-walk-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "var cc = JSON.parse(pm.collectionVariables.get('kwlClientConfig') || '{}');",
              "cc.max_response_body_size_mb = Number(pm.collectionVariables.get('kwlOriginal') || 0);",
              "pm.variables.set('kwlBody', JSON.stringify({ client_config: cc }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "pm.test('key-walk-limit: original limit restored', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{kwlBody}}"
        }
      }
    },
    {
      "name": "615.7 [EXPECT-200] the original limit is stored again (key-walk-limit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "pm.test('key-walk-limit: max_response_body_size_mb is back to what it was', function () {",
              "  pm.expect(pm.response.code, pm.response.text()).to.equal(200);",
              "  var cc = pm.response.json().client_config || {};",
              "  pm.expect(String(cc.max_response_body_size_mb || 0), pm.response.text()).to.equal(pm.collectionVariables.get('kwlOriginal') || '0');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/config?from_db=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ],
          "query": [
            {
              "key": "from_db",
              "value": "true"
            }
          ]
        }
      }
    }
  ]
}
