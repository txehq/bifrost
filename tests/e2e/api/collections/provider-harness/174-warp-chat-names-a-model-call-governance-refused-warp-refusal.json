      }
    },
    {
      "name": "openai warp-refusal setup: read current warp config",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Set again only by a read that really returned a config (see the test script).",
              "pm.collectionVariables.unset('warpRefusalConfigWas');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('warp-refusal: warp config readable', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "});",
              "var config;",
              "try { config = pm.response.json(); } catch (e) { config = undefined; }",
              "var isConfig = pm.response.code === 200 && config !== null && typeof config === 'object' && !Array.isArray(config);",
              "pm.test('warp-refusal: warp config is a config object', function () {",
              "  pm.expect(isConfig, 'not a config: ' + pm.response.text()).to.equal(true);",
              "});",
              "// Saved unchanged, and only when it is a config: an error body must never be written",
              "// back by the restore. Without it the configure and restore requests skip.",
              "if (isConfig) { pm.collectionVariables.set('warpRefusalConfigWas', pm.response.text()); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/warp/config"
      }
    },
    {
      "name": "openai gpt-4o-mini warp-refusal: configure Warp on gpt-4o-mini",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// No snapshot of the previous config to restore afterwards - leave it as it is.",
              "if (!pm.collectionVariables.get('warpRefusalConfigWas')) { pm.execution.skipRequest(); return; }",
              "// Keep any embedding space already saved: changing it without a new namespace",
              "// is rejected, and the harness must not disturb an existing index.",
              "var was = JSON.parse(pm.collectionVariables.get('warpRefusalConfigWas') || '{}');",
              "var body = {",
              "  enabled: true,",
              "  provider: 'openai',",
              "  model: 'gpt-4o-mini',",
              "  api_key_id: '',",
              "  embedding_provider: was.embedding_provider || 'openai',",
              "  embedding_model: was.embedding_model || 'text-embedding-3-small',",
              "  embedding_dimension: was.embedding_dimension || 1536,",
              "  log_vector_store_namespace: was.log_vector_store_namespace || ''",
              "};",
              "pm.collectionVariables.set('warpRefusalConfigBody', JSON.stringify(body));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('warp-refusal: config saved', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{warpRefusalConfigBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/warp/config"
      }
    },
    {
      "name": "openai gpt-4o-mini warp-refusal: a model call governance refused is access_denied, not upstream_error",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('warp-refusal: chat responds', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "});",
              "var body = pm.response.json();",
              "pm.test('warp-refusal: the turn failed without an answer', function () {",
              "  pm.expect(body.error, 'expected a refused turn: ' + pm.response.text()).to.be.an('object');",
              "  pm.expect(body.answer, 'a refused turn has no answer: ' + pm.response.text()).to.equal('');",
              "});",
              "pm.test('warp-refusal: the refusal is not reported as a provider failure', function () {",
              "  pm.expect(body.error.code, 'wrong code: ' + pm.response.text()).to.equal('access_denied');",
              "});",
              "pm.test('warp-refusal: the message says what is missing and keeps the governance reason', function () {",
              "  pm.expect(body.error.message, pm.response.text()).to.include('no model access');",
              "  pm.expect(body.error.message, pm.response.text()).to.include('access not found');",
              "});",
              "pm.test('warp-refusal: the refused turn is filed under a conversation', function () {",
              "  pm.expect(body.conversation_id, 'no conversation id: ' + pm.response.text()).to.be.a('string').and.not.equal('');",
              "});",
              "if (body.conversation_id) { pm.collectionVariables.set('warpRefusalConversation', body.conversation_id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-bf-vk",
            "value": "sk-bf-warp-refusal-key-that-does-not-exist"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":false}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/warp/chat"
      }
    },
    {
      "name": "openai warp-refusal: a reopened refused turn keeps its error code",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The chat above reports why the thread is missing; nothing to read back.",
              "if (!pm.collectionVariables.get('warpRefusalConversation')) { pm.execution.skipRequest(); return; }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('warp-refusal history: conversation readable', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.equal(200);",
              "});",
              "var messages = (pm.response.json().messages || []);",
              "var failed = messages.filter(function (m) { return m.role === 'assistant' && m.error; })[0];",
              "pm.test('warp-refusal history: the refused turn was filed with its error', function () {",
              "  pm.expect(failed, 'no failed assistant turn: ' + pm.response.text()).to.be.an('object');",
              "});",
              "pm.test('warp-refusal history: the code comes back beside the message, not inside it', function () {",
              "  pm.expect(failed.error_code, 'wrong code: ' + pm.response.text()).to.equal('access_denied');",
              "  pm.expect(failed.error, pm.response.text()).to.include('no model access');",
              "  pm.expect(failed.error.indexOf('access_denied:'), 'the code leaked into the message: ' + pm.response.text()).to.equal(-1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/warp/conversations/{{warpRefusalConversation}}"
      }
    },
