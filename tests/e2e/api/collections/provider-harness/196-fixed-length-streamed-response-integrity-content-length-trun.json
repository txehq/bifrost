      "name": "196.3 openai openai/upstream-fixed-length-ok accepts exact Content-Length (content-length truncation)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var raw = pm.response.text() || '';",
              "pm.test('stream begins successfully with the fixture content', function () {",
              "  pm.expect(pm.response.code, 'unexpected status: ' + raw).to.equal(200);",
              "  pm.expect(pm.response.headers.get('content-type'), raw).to.include('text/event-stream');",
              "  pm.expect(raw, 'fixture content missing: ' + raw).to.include('hello');",
              "});",
              "pm.test('an exact Content-Length body completes successfully', function () {",
              "  pm.expect(raw, 'unexpected read failure: ' + raw).to.not.match(/unexpected EOF/i);",
              "  pm.expect(raw, 'unexpected stream error: ' + raw).to.not.match(/\"error\"\\s*:/);",
              "  pm.expect(raw, 'completion missing: ' + raw).to.include('[DONE]');",
              "});"
            ]
          }
        }
      ],
