      "name": "/v1/audio/speech - hex audio decoded to mp3 bytes - minimax/speech-2.8-turbo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('speech returns decoded audio, not hex', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var ct = pm.response.headers.get('Content-Type') || '';",
              "  pm.expect(ct, 'content type').to.match(/audio|octet-stream/);",
              "  var bytes = pm.response.stream;",
              "  pm.expect(bytes.length, 'audio too small').to.be.above(2000);",
              "  var head = String.fromCharCode(bytes[0], bytes[1], bytes[2]);",
              "  var isMp3 = head === 'ID3' || (bytes[0] === 0xff && (bytes[1] & 0xe0) === 0xe0);",
              "  pm.expect(isMp3, 'body is not mp3 (hex not decoded?): ' + head).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"minimax/speech-2.8-turbo\",\n  \"input\": \"Hello from MiniMax through Bifrost.\",\n  \"voice\": \"English_Graceful_Lady\",\n  \"response_format\": \"mp3\"\n}"
