            "exec": [
              "pm.test('word-level timestamps map to words', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(200);",
              "  var j = pm.response.json();",
              "  pm.expect(j.words, 'no words: ' + pm.response.text().slice(0, 500)).to.be.an('array').that.is.not.empty;",
