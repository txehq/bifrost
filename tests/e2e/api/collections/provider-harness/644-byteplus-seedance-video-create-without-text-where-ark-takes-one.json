    {
      "name": "644.5 fixture wire capture shows the three creates reached Ark with no text item (byteplus seedance create without text)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{providerErrorFixtureUrl}}/__wire"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var calls = pm.response.json().data[0].calls.filter(function (c) { return c.path === '/pp/byteplus/api/v3/contents/generations/tasks'; });",
              "pm.test('each create reached Ark with its media and no text item', function () {",
              "  pm.expect(calls.length, JSON.stringify(calls)).to.eql(3);",
              "  var bodies = calls.map(function (c) { return JSON.parse(c.body); });",
              "  var types = bodies.map(function (b) { return b.content.map(function (i) { return i.type + ':' + (i.role || ''); }).join(','); });",
              "  pm.expect(types, JSON.stringify(bodies)).to.eql(['image_url:first_frame', 'audio_url:reference_audio', 'image_url:reference_image']);",
              "  pm.expect(bodies.map(function (b) { return b.model; }), JSON.stringify(bodies)).to.eql(['dreamina-seedance-2-5-260628', 'dreamina-seedance-2-5-260628', 'dreamina-seedance-2-0-260128']);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "644.6 [EXPECT-400] byteplus POST /v1/videos refuses a reference audio alone on dreamina-seedance-2-0, which needs an image or video beside it (byteplus seedance create without text)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"byteplus/dreamina-seedance-2-0-260128\",\n  \"prompt\": \"a paper boat on a pond\",\n  \"reference_audios\": [\"https://example.test/voice.mp3\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/videos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "videos"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the audio-only create is refused as caller_invalid_request', function () {",
              "  pm.expect(pm.response.code, 'failed: ' + pm.response.text()).to.eql(400);",
              "  var j = pm.response.json();",
              "  pm.expect(j.extra_fields && j.extra_fields.error_type, 'error_type: ' + pm.response.text()).to.eql('caller_invalid_request');",
              "  pm.expect(j.error && j.error.message, 'message: ' + pm.response.text()).to.include('Seedance 2.0 series');",
              "});"
            ]
          }
        }
      ]
    },
