{
  "name": "271. Saves keep what they did not change, and field names mean what the decoder says (handler-preservation) [SERIAL]",
  "description": "TXE-5528 regression. Local fixture regression: run with providerErrorFixture=1 against the gateway of tests/e2e/api/provider_config/provider-error-fixture.config.json, with tests/e2e/api/runners/provider-error-fixture.mjs as the only upstream. That config provisions loopback catalog URLs, which the API may not introduce, and a disabled MCP library sync: a settings save that resends them unchanged must succeed, while a new file:// or metadata URL is refused and nothing moves. The MCP list must carry a client's instruction cap, because the edit form is filled from it and sends the whole config back. A provider-key update honours the field names the decoder takes, and a case-variant oauth_key_config block gets the same unknown-field check as the exact name. Case-variant secret references on a whitelisted route are in folder 264. Run the whole folder in order.",
  "item": [
    {
      "name": "an unchanged provisioned catalog URL lets an unrelated settings save through - handler-preservation",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "config"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{hpConfigBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "// What the dashboard does: read the whole config and send it back with one edit.",
              "var edit = function (cfg) { pm.collectionVariables.set('hpSyncInterval', cfg.framework_config.pricing_sync_interval); cfg.framework_config.pricing_sync_interval += 60; };",
              "pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/config', method: 'GET' }, function (err, res) {",
              "  pm.test('handler-preservation: the config was read', function () { pm.expect(res && res.code, err ? String(err) : res.text()).to.equal(200); });",
              "  var cfg = res.json();",
              "  pm.collectionVariables.set('hpPricingUrl', cfg.framework_config.pricing_url);",
              "  // log_retention_days reads 0 when config.json leaves it out, and a save refuses 0: the form fills in its default.",
              "  cfg.client_config.log_retention_days = cfg.client_config.log_retention_days || 30;",
              "  edit(cfg);",
              "  pm.collectionVariables.set('hpConfigBody', JSON.stringify({ client_config: cfg.client_config, framework_config: cfg.framework_config }));",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('handler-preservation: answered 200', function () { pm.expect(pm.response.code, pm.response.text()).to.equal(200); });",
              "function readConfig(check) {",
              "  pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/config', method: 'GET' }, function (err, res) { check(res.json().framework_config, res); });",
              "}",
              "var interval = pm.collectionVariables.get('hpSyncInterval') + 60;",
              "var want = pm.collectionVariables.get('hpPricingUrl');",
              "readConfig(function (fw, res) {",
              "  pm.test('handler-preservation: the provisioned URL stays and the edit is saved', function () {",
              "    pm.expect(fw.pricing_url, res.text()).to.equal(want);",
              "    pm.expect(fw.pricing_sync_interval, res.text()).to.equal(interval);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
