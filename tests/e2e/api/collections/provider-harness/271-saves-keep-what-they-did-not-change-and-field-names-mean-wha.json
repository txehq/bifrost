    {
      "name": "the form's whole config comes back and keeps the cap - handler-preservation",
      "protocolProfileBehavior": {
        "followRedirects": false,
        "disableCookies": true
      },
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/mcp/client/{{hpMcpId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "mcp",
            "client",
            "{{hpMcpId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{{hpMcpBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('providerErrorFixture') !== '1') {",
              "  pm.execution.skipRequest();",
              "}",
              "pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/mcp/clients', method: 'GET' }, function (err, res) {",
              "  var client = res.json().clients.find(function (c) { return c.config.client_id === pm.collectionVariables.get('hpMcpId'); });",
              "  // The form sends what it was filled with; a field the list lost reads as 0.",
              "  pm.collectionVariables.set('hpMcpBody', JSON.stringify({ name: client.config.name, connection_type: client.config.connection_type, connection_string: client.config.connection_string, auth_type: client.config.auth_type, tools_to_execute: client.config.tools_to_execute, max_instructions_length: client.config.max_instructions_length || 0 }));",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('handler-preservation: answered 200', function () { pm.expect(pm.response.code, pm.response.text()).to.equal(200); });",
              "var BASE = pm.variables.get('baseUrl');",
              "var id = pm.collectionVariables.get('hpMcpId');",
              "pm.sendRequest({ url: BASE + '/api/mcp/clients', method: 'GET' }, function (err, res) {",
              "  var client = res.json().clients.find(function (c) { return c.config.client_id === id; });",
              "  pm.test('handler-preservation: the round trip kept the cap', function () { pm.expect(client.config.max_instructions_length, res.text()).to.equal(1234); });",
              "  // Back to the global cap, for the rest of the run.",
              "  pm.sendRequest({ url: BASE + '/api/mcp/client/' + id, method: 'PUT', header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify({ name: client.config.name, connection_type: client.config.connection_type, connection_string: client.config.connection_string, auth_type: client.config.auth_type, tools_to_execute: client.config.tools_to_execute, max_instructions_length: 0 }) } }, function (e, r) {",
              "    pm.test('handler-preservation: the cap was cleared', function () { pm.expect(r && r.code, e ? String(e) : r.text()).to.equal(200); });",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
